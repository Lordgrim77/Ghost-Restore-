}
.gm-credential-value {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 8px;
}
.gm-credential-value code {
    font-size: 14px;
    font-weight: 700;
    color: #38bdf8;
    word-break: break-all;
}
html.light-mode .gm-credential-value code { color: #0284c7; }
.gm-copy-btn {
    background: rgba(255, 255, 255, 0.1);
    border: none;
    border-radius: 6px;
    padding: 4px 10px;
    font-size: 12px;
    font-weight: 700;
    color: #ffffff;
