<!-- ============================================================= -->
<!-- Support Portal Controller Script -->
<!-- ============================================================= -->
<script>
(function() {
    'use strict';

    // Auto-detect API base (direct 8080 during local testing or reverse proxy /api/support in production)
    const API_BASE = (window.location.port === '2368' || window.location.port === '3000') 
        ? 'http://127.0.0.1:8080/api/support' 
        : '/api/support';

    let selectedFiles = [];
    let currentCaseCode = null;
    let currentAccessKey = null;
    let pollTimer = null;

    // Theme Toggle Controller
    window.toggleSupportTheme = function() {
        const html = document.documentElement;
        const currentTheme = html.getAttribute('data-theme') || (html.classList.contains('light-mode') ? 'light' : 'dark');
        const nextTheme = currentTheme === 'dark' ? 'light' : 'dark';

        if (nextTheme === 'dark') {
            html.classList.add('dark-mode');
            html.classList.remove('light-mode');
            html.setAttribute('data-theme', 'dark');
        } else {
            html.classList.remove('dark-mode');
            html.classList.add('light-mode');
            html.setAttribute('data-theme', 'light');
        }
        localStorage.setItem('user-theme', nextTheme);
        updateThemeUI(nextTheme);
    };

    function updateThemeUI(theme) {
        const isDark = theme === 'dark';
        const icon = document.getElementById('gmSupportThemeIcon');
        const text = document.getElementById('gmSupportThemeText');
        if (icon) icon.textContent = isDark ? '🌙' : '☀️';
        if (text) text.textContent = isDark ? 'Dark Mode' : 'Light Mode';

        // Synchronize navigation theme toggles if present
        document.querySelectorAll('#gmThemeIcon, .gm-theme-icon').forEach(el => el.textContent = isDark ? '🌙' : '☀️');
        document.querySelectorAll('#gmThemeText, .gm-theme-text, .gm-menu-theme-badge').forEach(el => el.textContent = isDark ? 'Dark' : 'Light');
    }

    // Initialize Theme State
    const savedTheme = localStorage.getItem('user-theme') || (document.documentElement.classList.contains('light-mode') ? 'light' : 'dark');
    updateThemeUI(savedTheme);

    // Tab Switching
    window.switchSupportTab = function(tab) {
        const btnSubmit = document.getElementById('tabBtnSubmit');
        const btnTrack = document.getElementById('tabBtnTrack');
        const pSubmit = document.getElementById('panelSubmit');
        const pTrack = document.getElementById('panelTrack');

        if (tab === 'submit') {
            btnSubmit.classList.add('active');
            btnTrack.classList.remove('active');
            pSubmit.classList.add('active');
            pTrack.classList.remove('active');
        } else {
            btnTrack.classList.add('active');
            btnSubmit.classList.remove('active');
            pTrack.classList.add('active');
            pSubmit.classList.remove('active');
            checkSavedCase();
        }
    };

    window.toggleAnonFields = function(isAnon) {
        const fields = document.getElementById('anonFields');
        if (fields) fields.style.display = isAnon ? 'none' : 'block';
    };

    // Priority Pills active sync
    document.querySelectorAll('.gm-priority-pill input[type="radio"]').forEach(radio => {
        radio.addEventListener('change', function() {
            document.querySelectorAll('.gm-priority-pill').forEach(p => p.classList.remove('active'));
            this.closest('.gm-priority-pill').classList.add('active');
        });
    });

    // File Selection & Drag-and-drop
    window.handleFileSelect = function(e) {
        const files = Array.from(e.target.files || []);
        addFiles(files);
    };

    const dropzone = document.getElementById('gmDropzone');
    if (dropzone) {
        ['dragenter', 'dragover'].forEach(name => {
            dropzone.addEventListener(name, (e) => { e.preventDefault(); dropzone.style.borderColor = '#10b981'; });
        });
        ['dragleave', 'drop'].forEach(name => {
            dropzone.addEventListener(name, (e) => { e.preventDefault(); dropzone.style.borderColor = ''; });
        });
        dropzone.addEventListener('drop', (e) => {
            e.preventDefault();
            const files = Array.from(e.dataTransfer.files || []);
            addFiles(files);
        });
    }

    function addFiles(files) {
        selectedFiles = selectedFiles.concat(files);
        renderFileList();
    }

    function renderFileList() {
        const list = document.getElementById('gmFileList');
        if (!list) return;
        if (selectedFiles.length === 0) {
            list.style.display = 'none';
            list.innerHTML = '';
            return;
        }
        list.style.display = 'flex';
        list.innerHTML = selectedFiles.map((f, i) => `
            <div class="gm-file-item">
                <span>📁 <strong>${escapeHtml(f.name)}</strong> (${(f.size / 1024).toFixed(1)} KB)</span>
                <button type="button" class="gm-file-remove" onclick="removeFile(${i})">✕</button>
            </div>
        `).join('');
    }

    window.removeFile = function(index) {
        selectedFiles.splice(index, 1);
        renderFileList();
    };

    function showSubmitAlert(msg, isError = true) {
        const alertBox = document.getElementById('caseSubmitAlert');
        if (alertBox) {
            alertBox.className = 'gm-submit-alert ' + (isError ? 'error' : 'info');
            alertBox.innerHTML = `⚠️ <strong>Submission Error:</strong> ${escapeHtml(msg)}`;
            alertBox.style.display = 'block';
            alertBox.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
        }
    }

    function hideSubmitAlert() {
        const alertBox = document.getElementById('caseSubmitAlert');
        if (alertBox) {
            alertBox.style.display = 'none';
            alertBox.innerHTML = '';
        }
    }

    // Case Submission
    window.handleCaseSubmit = async function(e) {
        e.preventDefault();
        hideSubmitAlert();

        const btn = document.getElementById('btnSubmitCase');
        const category = document.getElementById('caseCategory').value;
        const prio = document.querySelector('input[name="priority"]:checked');
        const priority = prio ? prio.value : 'STANDARD';
        const subject = document.getElementById('caseSubject').value.trim();
        const description = document.getElementById('caseDescription').value.trim();
        const isAnon = document.getElementById('anonToggle').checked;
        const reporterAlias = isAnon ? 'Anonymous' : (document.getElementById('reporterAlias').value.trim() || 'Anonymous');
        const reporterContact = isAnon ? '' : document.getElementById('reporterContact').value.trim();

        if (!subject || !description) {
            showSubmitAlert('Subject and Detailed Report are required fields. Please fill them out before submitting.');
            return;
        }

        btn.disabled = true;
        btn.querySelector('.gm-btn-text').textContent = 'Encrypting & Dispatching...';

        try {
            let res;
            if (selectedFiles.length === 0) {
                // Direct JSON submission (fast, zero multipart overhead)
                res = await fetch(`${API_BASE}/cases`, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({
                        category: category,
                        priority: priority,
                        subject: subject,
                        description: description,
                        reporter_alias: reporterAlias,
                        reporter_contact: reporterContact
                    })
                });
            } else {
                // Multipart submission with evidence files
                const formData = new FormData();
                formData.append('category', category);
                formData.append('priority', priority);
                formData.append('subject', subject);
                formData.append('description', description);
                formData.append('reporter_alias', reporterAlias);
                formData.append('reporter_contact', reporterContact);

                selectedFiles.forEach((file, index) => {
                    formData.append(`evidence_${index}`, file);
                });

                res = await fetch(`${API_BASE}/cases`, {
                    method: 'POST',
                    body: formData
                });
            }

            if (!res.ok) {
                let errorMsg = `Server responded with HTTP ${res.status}`;
                try {
                    const errData = await res.json();
                    if (errData && errData.error) errorMsg = errData.error;
                } catch (_) {
                    if (res.status === 404) {
                        errorMsg = 'API route not found (HTTP 404). If testing in production, verify that your Nginx reverse proxy configuration for /api/support/ is active and reloaded (sudo nginx -s reload).';
                    } else if (res.status === 502 || res.status === 503) {
                        errorMsg = 'Support Bot daemon is offline (HTTP ' + res.status + '). Ensure your ghost-telegram-bot service is active (sudo systemctl status ghost-telegram-bot).';
                    }
                }
                throw new Error(errorMsg);
            }

            const data = await res.json();
            currentCaseCode = data.case_code;
            currentAccessKey = data.access_key;

            localStorage.setItem('gm_active_case_code', currentCaseCode);
            localStorage.setItem('gm_active_access_key', currentAccessKey);

            document.getElementById('resCaseCode').textContent = currentCaseCode;
            document.getElementById('resAccessKey').textContent = currentAccessKey;
            document.getElementById('gmSupportForm').style.display = 'none';
            document.getElementById('caseSuccessCard').style.display = 'block';

            const badge = document.getElementById('activeCaseBadge');
            if (badge) badge.style.display = 'inline-block';

        } catch (err) {
            let userMsg = err.message;
            if (err.name === 'TypeError' && err.message.toLowerCase().includes('fetch')) {
                userMsg = 'Cannot reach Support API server (Connection refused). If testing locally, start the support server on port 8080 (python support_hub.py). If on a remote server, check your Nginx proxy and bot service.';
            }
            showSubmitAlert(userMsg);
            btn.disabled = false;
            btn.querySelector('.gm-btn-text').textContent = 'Submit Confidential Report';
        }
    };

    window.copyText = function(elemId) {
        const text = document.getElementById(elemId).textContent;
        navigator.clipboard.writeText(text).then(() => {
            alert('Copied to clipboard: ' + text);
        });
    };

    window.openActiveCaseDashboard = function() {
        switchSupportTab('track');
        if (currentCaseCode && currentAccessKey) {
            loadCase(currentCaseCode, currentAccessKey);
        }
    };

    window.loadCaseFromInputs = function() {
        const code = document.getElementById('lookupCaseCode').value.trim();
        const key = document.getElementById('lookupAccessKey').value.trim();
        if (!code || !key) {
            alert('Please enter both Case Reference Code and Private Access Key.');
            return;
        }
        loadCase(code, key);
    };

    async function loadCase(code, key) {
        try {
            const res = await fetch(`${API_BASE}/cases/${encodeURIComponent(code)}?key=${encodeURIComponent(key)}`);
            if (!res.ok) {
                let errText = `HTTP ${res.status}`;
                try {
                    const err = await res.json();
                    if (err && err.error) errText = err.error;
                } catch(_) {
                    if (res.status === 404) errText = 'Case reference not found. Check the code and try again.';
                    else if (res.status === 403) errText = 'Invalid Case Access Key. Please check your secret key.';
                    else if (res.status === 502) errText = 'Support Bot daemon is offline.';
                }
                throw new Error(errText);
            }
            const data = await res.json();
            currentCaseCode = code;
            currentAccessKey = key;

            localStorage.setItem('gm_active_case_code', code);
            localStorage.setItem('gm_active_access_key', key);

            renderCaseDashboard(data);

            if (pollTimer) clearInterval(pollTimer);
            pollTimer = setInterval(pollCaseUpdates, 3800);

        } catch (err) {
            let msg = err.message;
            if (err.name === 'TypeError' && err.message.toLowerCase().includes('fetch')) {
                msg = 'Cannot reach Support API server (Connection refused).';
            }
            alert('Lookup Failed: ' + msg);
        }
    }

    function renderCaseDashboard(data) {
        document.getElementById('gmLookupCard').style.display = 'none';
        document.getElementById('gmCaseDashboard').style.display = 'block';

        document.getElementById('dashCaseCode').textContent = `#${data.case_code}`;
        const pBadge = document.getElementById('dashPriority');
        pBadge.textContent = data.priority;
        pBadge.className = `gm-priority-badge ${data.priority}`;

        document.getElementById('dashCreatedAt').textContent = 'Submitted: ' + (data.created_at || '').substring(0, 10);
        document.getElementById('dashSubject').textContent = data.subject;
        document.getElementById('dashDescription').textContent = data.description;

        // Stepper
        const sSubmitted = document.getElementById('stepSubmitted');
        const sReview = document.getElementById('stepReview');
        const sRes = document.getElementById('stepResolution');
        const sResLabel = document.getElementById('stepResolutionLabel');
        const line1 = document.getElementById('line1');
        const line2 = document.getElementById('line2');

        sSubmitted.classList.add('active');
        sReview.classList.remove('active');
        sRes.classList.remove('active');
        line1.classList.remove('active');
        line2.classList.remove('active');

        if (data.status === 'IN_REVIEW') {
            sReview.classList.add('active');
            line1.classList.add('active');
        } else if (data.status === 'CLOSED') {
            sReview.classList.add('active');
            sRes.classList.add('active');
            line1.classList.add('active');
            line2.classList.add('active');
            sResLabel.textContent = 'Resolved';
        } else if (data.status === 'REJECTED') {
            sRes.classList.add('active');
            line1.classList.add('active');
            line2.classList.add('active');
            sResLabel.textContent = 'Dismissed';
        }

        // Evidence files list
        const evList = document.getElementById('dashEvidenceList');
        if (data.files && data.files.length > 0) {
            document.getElementById('dashEvidenceSection').style.display = 'block';
            evList.innerHTML = data.files.map(f => `
                <div class="gm-evidence-card">
                    <div class="gm-evidence-name">📁 ${escapeHtml(f.original_name || f.name)}</div>
                    <div class="gm-evidence-meta">Size: ${(f.file_size / 1024).toFixed(1)} KB | SHA-256: ${(f.sha256_hash || '').substring(0, 16)}...</div>
                </div>
            `).join('');
        } else {
            document.getElementById('dashEvidenceSection').style.display = 'none';
        }

        // Messages
        renderMessages(data.messages || []);
    }

    function renderMessages(messages) {
        const container = document.getElementById('gmChatMessages');
        if (!messages || messages.length === 0) {
            container.innerHTML = '<div class="gm-chat-empty">💬 No messages yet. You can submit updates or additional context below.</div>';
            return;
        }

        container.innerHTML = messages.map(m => {
            const isReporter = m.sender_type === 'reporter';
            const badge = isReporter ? '' : '<span class="bubble-badge">Investigator</span>';
            const time = (m.created_at || '').substring(11, 16);
            return `
                <div class="gm-chat-bubble ${isReporter ? 'bubble-reporter' : 'bubble-admin'}">
                    <div class="bubble-meta">
                        <strong>${escapeHtml(m.sender_name || (isReporter ? 'You' : 'Duty Admin'))}</strong>
                        ${badge}
                        <span>${time} UTC</span>
                    </div>
                    <div>${escapeHtml(m.message_text)}</div>
                </div>
            `;
        }).join('');

        container.scrollTop = container.scrollHeight;
    }

    async function pollCaseUpdates() {
        if (!currentCaseCode || !currentAccessKey) return;
        try {
            const res = await fetch(`${API_BASE}/cases/${encodeURIComponent(currentCaseCode)}?key=${encodeURIComponent(currentAccessKey)}`);
            if (res.ok) {
                const data = await res.json();
                renderCaseDashboard(data);
            }
        } catch(e) {}
    }

    window.handleSendMessage = async function(e) {
        e.preventDefault();
        const input = document.getElementById('chatMessageInput');
        const text = input.value.trim();
        if (!text || !currentCaseCode || !currentAccessKey) return;

        const btn = document.getElementById('btnSendChat');
        btn.disabled = true;
        try {
            const res = await fetch(`${API_BASE}/cases/${encodeURIComponent(currentCaseCode)}/messages`, {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: jsonStringifySafe({
                    key: currentAccessKey,
                    message: text
                })
            });

            if (!res.ok) {
                let errText = `HTTP ${res.status}`;
                try {
                    const err = await res.json();
                    if (err && err.error) errText = err.error;
                } catch(_) {
                    if (res.status === 403) errText = 'Access denied. Invalid Private Access Key.';
                    else if (res.status === 404) errText = 'Case not found.';
                }
                throw new Error(errText);
            }

            input.value = '';
            pollCaseUpdates();
        } catch(err) {
            let msg = err.message;
            if (err.name === 'TypeError' && err.message.toLowerCase().includes('fetch')) {
                msg = 'Cannot reach Support API server (Connection refused).';
            }
            alert('Message delivery error: ' + msg);
        } finally {
            btn.disabled = false;
        }
    };

    function checkSavedCase() {
        const urlParams = new URLSearchParams(window.location.search);
        const qCase = urlParams.get('case');
        const qKey = urlParams.get('key');
        if (qCase && qKey) {
            document.getElementById('lookupCaseCode').value = qCase;
            document.getElementById('lookupAccessKey').value = qKey;
            loadCase(qCase, qKey);
            return;
        }

        const savedCode = localStorage.getItem('gm_active_case_code');
        const savedKey = localStorage.getItem('gm_active_access_key');
        if (savedCode && savedKey) {
            document.getElementById('lookupCaseCode').value = savedCode;
            document.getElementById('lookupAccessKey').value = savedKey;
            const badge = document.getElementById('activeCaseBadge');
            if (badge) badge.style.display = 'inline-block';
        }
    }

    function escapeHtml(text) {
        if (!text) return '';
        const div = document.createElement('div');
        div.textContent = text;
        return div.innerHTML;
    }

    function jsonStringifySafe(obj) {
        return JSON.stringify(obj);
    }

    // Auto-check URL or saved case on init
    const params = new URLSearchParams(window.location.search);
    if (params.get('case') || window.location.hash === '#track') {
        switchSupportTab('track');
    } else {
        const savedCode = localStorage.getItem('gm_active_case_code');
        if (savedCode) {
            const badge = document.getElementById('activeCaseBadge');
            if (badge) badge.style.display = 'inline-block';
        }
    }
})();
</script>
