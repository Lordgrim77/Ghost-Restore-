{{!< default}}

{{#if @member}}
<meta id="gm-support-member-meta" data-email="{{@member.email}}" data-name="{{@member.name}}" data-uuid="{{@member.uuid}}">
<script>
(function() {
    var m = document.getElementById('gm-support-member-meta');
    window.GHOST_MEMBER = {
        loggedIn: true,
        email: m ? (m.getAttribute('data-email') || '') : '',
        name: m ? (m.getAttribute('data-name') || '') : '',
        uuid: m ? (m.getAttribute('data-uuid') || '') : ''
    };
})();
</script>
{{else}}
<script>
window.GHOST_MEMBER = {
    loggedIn: false,
    email: null,
    name: null,
    uuid: null
};
</script>
{{/if}}

<div class="content-area">
    <main class="site-main">

        <section class="gm-support-section">
            <div class="gm-support-container">

                <!-- Clean Hero Header -->
                <div class="gm-support-header">
                    <h1 class="gm-support-title">Support &amp; Reports Portal</h1>
                    <p class="gm-support-desc">
                        Submit a confidential report, provide evidence files, and communicate directly with administrators in real-time.
                    </p>
                </div>

                <!-- Navigation Tabs (Submit Report | My Cases | Track by Code) -->
                <div class="gm-support-tabs">
                    <button type="button" class="gm-support-tab active" id="tabBtnSubmit" data-support-tab="submit">
                        <span class="gm-tab-icon">📝</span>
                        <span>Submit Report</span>
                    </button>
                    {{#if @member}}
                    <button type="button" class="gm-support-tab" id="tabBtnMyCases" data-support-tab="mycases">
                        <span class="gm-tab-icon">📁</span>
                        <span>My Cases</span>
                        <span class="gm-tab-badge" id="myCasesBadge" style="display:none;">0</span>
                    </button>
                    {{/if}}
                    <button type="button" class="gm-support-tab" id="tabBtnTrack" data-support-tab="track">
                        <span class="gm-tab-icon">🔍</span>
                        <span>Track by Code</span>
                        <span class="gm-tab-badge" id="activeCaseBadge" style="display:none;">Active</span>
                    </button>
                </div>

                <!-- ============================================================= -->
                <!-- TAB 1: NEW CASE SUBMISSION FORM -->
                <!-- ============================================================= -->
                <div class="gm-support-panel active" id="panelSubmit">
                    <form id="gmSupportForm" class="gm-support-form">
                        
                        <!-- Member Logged-In Notice -->
                        {{#if @member}}
                        <div class="gm-member-badge-card" id="memberStatusBanner">
                            <div class="gm-member-badge-icon">👤</div>
                            <div class="gm-member-badge-content">
                                <div class="gm-member-badge-title">Logged in as <strong>{{@member.email}}</strong></div>
                                <div class="gm-member-badge-sub">This report will be automatically linked to your account for easy tracking under "My Cases".</div>
                            </div>
                        </div>
                        {{/if}}

                        <!-- Row 1: Category & Priority -->
                        <div class="gm-form-row gm-form-grid-2">
                            <div class="gm-form-group">
                                <label for="caseCategory" class="gm-form-label">Category <span class="gm-required">*</span></label>
                                <select id="caseCategory" name="category" class="gm-form-select" required>
                                    <option value="Incident &amp; Abuse Report">Incident &amp; Abuse Report</option>
                                    <option value="Predator Grooming &amp; Exploitation">Predator Grooming &amp; Exploitation</option>
                                    <option value="Evidence &amp; Forensic Artifacts">Evidence &amp; Forensic Artifacts</option>
                                    <option value="Threat Intelligence &amp; Tip">Threat Intelligence &amp; Tip</option>
                                    <option value="General Support Inquiry">General Support Inquiry</option>
                                </select>
                            </div>

                            <div class="gm-form-group">
                                <label for="casePriority" class="gm-form-label">Priority <span class="gm-required">*</span></label>
                                <select id="casePriority" name="priority" class="gm-form-select" required>
                                    <option value="STANDARD" selected>Standard Priority</option>
                                    <option value="URGENT">Urgent Concern</option>
                                    <option value="CRITICAL">Critical Emergency</option>
                                    <option value="LOW">Low / Routine Inquiry</option>
                                </select>
                            </div>
                        </div>

                        <!-- Subject -->
                        <div class="gm-form-group">
                            <label for="caseSubject" class="gm-form-label">Subject / Summary <span class="gm-required">*</span></label>
                            <input type="text" id="caseSubject" name="subject" class="gm-form-input" placeholder="Brief summary of what happened..." required maxlength="180">
                        </div>

                        <!-- Description Narrative -->
                        <div class="gm-form-group">
                            <label for="caseDescription" class="gm-form-label">Details &amp; Narrative <span class="gm-required">*</span></label>
                            <textarea id="caseDescription" name="description" class="gm-form-textarea" rows="5" placeholder="Provide relevant context, handles, URLs, timestamps, or descriptions..." required></textarea>
                        </div>

                        <!-- Evidence File Dropzone -->
                        <div class="gm-form-group">
                            <label class="gm-form-label">Evidence &amp; Attachments (Optional)</label>
                            <div class="gm-dropzone" id="gmDropzone">
                                <input type="file" id="evidenceFileInput" multiple style="display:none;" accept=".jpg,.jpeg,.png,.webp,.pdf,.txt,.log,.mp4,.zip">
                                <div class="gm-dropzone-content">
                                    <div class="gm-dropzone-icon">
                                        <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                            <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
                                            <polyline points="17 8 12 3 7 8"></polyline>
                                            <line x1="12" y1="3" x2="12" y2="15"></line>
                                        </svg>
                                    </div>
                                    <p class="gm-dropzone-title">Click to upload files or drag &amp; drop</p>
                                    <p class="gm-dropzone-sub">Images, screenshots, PDFs, logs, or archives (up to 50MB)</p>
                                </div>
                            </div>
                            <div class="gm-file-list" id="gmFileList" style="display:none;"></div>
                        </div>

                        <!-- Identity & Anonymity Preferences -->
                        <div class="gm-form-card">
                            {{#if @member}}
                            <!-- Member Anonymity Option -->
                            <label class="gm-checkbox-label">
                                <input type="checkbox" id="anonToggle" data-anon-mode="member">
                                <span class="gm-custom-checkbox"></span>
                                <span class="gm-checkbox-text">
                                    <strong>Submit Anonymously</strong>
                                    <small>Do not link this report to my member account (you will need to save the access key to track it).</small>
                                </span>
                            </label>
                            {{else}}
                            <!-- Non-Member Optional Contact -->
                            <label class="gm-checkbox-label">
                                <input type="checkbox" id="anonToggle" checked data-anon-mode="guest">
                                <span class="gm-custom-checkbox"></span>
                                <span class="gm-checkbox-text">
                                    <strong>Remain Strictly Anonymous</strong>
                                    <small>Zero personal identifying information will be attached to this submission.</small>
                                </span>
                            </label>
                            <div class="gm-anon-fields" id="anonFields" style="display:none;">
                                <div class="gm-form-row gm-form-grid-2">
                                    <div class="gm-form-group">
                                        <label for="reporterAlias" class="gm-form-label">Pseudonym / Alias (Optional)</label>
                                        <input type="text" id="reporterAlias" name="reporter_alias" class="gm-form-input" placeholder="e.g. Sentinel_99">
                                    </div>
                                    <div class="gm-form-group">
                                        <label for="reporterContact" class="gm-form-label">Contact Handle / Email (Optional)</label>
                                        <input type="text" id="reporterContact" name="reporter_contact" class="gm-form-input" placeholder="ProtonMail, SimpleLogin, or Telegram">
                                    </div>
                                </div>
                            </div>
                            {{/if}}
                        </div>

                                                <!-- Verification Challenge Card -->
                        <div class="gm-captcha-card" id="gmCaptchaCard">
                            <div class="gm-captcha-row">
                                <div class="gm-captcha-visual" id="gmCaptchaVisual">
                                    <span class="gm-captcha-loading">Loading challenge...</span>
                                </div>
                                <button type="button" class="gm-captcha-refresh-btn" id="btnRefreshCaptcha" title="Refresh Challenge">
                                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                        <polyline points="23 4 23 10 17 10"></polyline>
                                        <polyline points="1 20 1 14 7 14"></polyline>
                                        <path d="M3.51 9a9 9 0 0 1 14.85-3.36L23 10M1 14l4.64 4.36A9 9 0 0 0 20.49 15"></path>
                                    </svg>
                                </button>
                                <div class="gm-captcha-input-wrap">
                                    <input type="text" id="gmCaptchaInput" class="gm-form-input gm-captcha-input" placeholder="Answer" autocomplete="off" required>
                                </div>
                            </div>
                            <input type="hidden" id="gmCaptchaId" name="captcha_id">
                            <input type="hidden" id="gmCaptchaTimestamp" name="captcha_timestamp">
                            <input type="hidden" id="gmCaptchaSignature" name="captcha_signature">
                            <input type="hidden" id="gmCaptchaNonce" name="captcha_nonce">
                            <input type="hidden" id="gmCaptchaSolution" name="captcha_solution">
                        </div>

                        <!-- Submit Button -->
                        <div class="gm-form-actions">
                            <button type="submit" class="gm-submit-case-btn" id="btnSubmitCase">
                                <span class="gm-btn-text">Submit Confidential Report</span>
                                <span class="gm-btn-icon">→</span>
                            </button>
                            <div id="caseSubmitAlert" class="gm-submit-alert" style="display:none;"></div>
                        </div>

                    </form>

                    <!-- Success Confirmation Banner -->
                    <div class="gm-case-success-card" id="caseSuccessCard" style="display:none;">
                        <div class="gm-success-badge">
                            <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="#10b981" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                                <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path>
                                <polyline points="22 4 12 14.01 9 11.01"></polyline>
                            </svg>
                        </div>
                        <h2 class="gm-success-title">Report Successfully Dispatched</h2>
                        <p class="gm-success-desc">
                            Your submission has been securely ingested and transmitted to duty administrators for review.
                        </p>

                        <div class="gm-credentials-box">
                            <div class="gm-credential-item">
                                <span class="gm-credential-label">CASE REFERENCE CODE</span>
                                <div class="gm-credential-value">
                                    <code id="resCaseCode">---</code>
                                    <button type="button" class="gm-copy-btn" data-copy-target="resCaseCode">Copy</button>
                                </div>
                            </div>
                            <div class="gm-credential-item">
                                <span class="gm-credential-label">PRIVATE ACCESS KEY</span>
                                <div class="gm-credential-value">
                                    <code id="resAccessKey">---</code>
                                    <button type="button" class="gm-copy-btn" data-copy-target="resAccessKey">Copy</button>
                                </div>
                            </div>
                        </div>

                        <div class="gm-success-actions">
                            <button type="button" class="gm-copy-link-btn" id="btnSuccessCopyLink">
                                <span>🔗 Copy Direct Case Link</span>
                            </button>
                            <button type="button" class="gm-view-case-btn" id="btnOpenActiveCase">
                                <span>Open Case Dashboard &amp; Live Chat</span> →
                            </button>
                        </div>
                    </div>

                </div>

                <!-- ============================================================= -->
                <!-- TAB 2: MY CASES (MEMBER & DEVICE TRACKING) -->
                <!-- ============================================================= -->
                <div class="gm-support-panel" id="panelMyCases">
                    <div class="gm-mycases-wrapper">
                        
                        <div class="gm-mycases-header">
                            <div>
                                <h3 class="gm-mycases-heading">My Submitted Cases</h3>
                                <p class="gm-mycases-sub" id="myCasesSubText">
                                    Track reports and access live chat with administrators.
                                </p>
                            </div>
                            <button type="button" class="gm-refresh-btn" id="btnRefreshCases">
                                <span>🔄 Refresh</span>
                            </button>
                        </div>

                        <!-- Loading Indicator -->
                        <div class="gm-cases-loading" id="myCasesLoading" style="display:none;">
                            <div class="gm-spinner"></div>
                            <span>Fetching your cases...</span>
                        </div>

                        <!-- Empty State -->
                        <div class="gm-cases-empty" id="myCasesEmpty" style="display:none;">
                            <div class="gm-empty-icon">📁</div>
                            <h4 class="gm-empty-title">No Cases Found</h4>
                            <p class="gm-empty-desc" id="myCasesEmptyDesc">
                                You haven't submitted any cases with this account yet.
                            </p>
                            <button type="button" class="gm-empty-cta" data-support-tab="submit">
                                <span>Submit a Report Now</span> →
                            </button>
                        </div>

                        <!-- Cases List Container -->
                        <div class="gm-cases-list" id="myCasesList"></div>

                    </div>
                </div>

                <!-- ============================================================= -->
                <!-- TAB 3: CASE TRACKING & BI-DIRECTIONAL LIVE CHAT -->
                <!-- ============================================================= -->
                <div class="gm-support-panel" id="panelTrack">
                    
                    <!-- Case Lookup Card -->
                    <div class="gm-lookup-card" id="gmLookupCard">
                        <h3 class="gm-lookup-title">Access Existing Case</h3>
                        <p class="gm-lookup-sub">Enter your Case Reference Code and Private Access Key to view status updates and chat with administrators.</p>
                        
                        <div class="gm-form-row gm-form-grid-2">
                            <div class="gm-form-group">
                                <label for="lookupCaseCode" class="gm-form-label">Case Reference Code</label>
                                <input type="text" id="lookupCaseCode" class="gm-form-input" placeholder="e.g. CASE-4892-F91A">
                            </div>
                            <div class="gm-form-group">
                                <label for="lookupAccessKey" class="gm-form-label">Private Access Key</label>
                                <input type="text" id="lookupAccessKey" class="gm-form-input" placeholder="32-character secret key">
                            </div>
                        </div>

                        <div class="gm-lookup-actions">
                            <button type="button" class="gm-lookup-btn" id="btnLookupCase">
                                <span>Access Case &amp; Live Chat</span> →
                            </button>
                        </div>
                    </div>

                    <!-- Active Case Dashboard Container (Hidden until case loaded) -->
                    <div class="gm-case-dashboard" id="gmCaseDashboard" style="display:none;">

                        <!-- Case Summary Ribbon -->
                        <div class="gm-case-summary-card">
                            <div class="gm-summary-header">
                                <div class="gm-summary-tags">
                                    <span class="gm-case-code-badge" id="dashCaseCode">#CASE-0000</span>
                                    <span class="gm-priority-badge" id="dashPriority">STANDARD</span>
                                    <span class="gm-category-badge" id="dashCategory" style="display:none;"></span>
                                    <span class="gm-alias-badge" id="dashReporter" style="display:none;"></span>
                                </div>
                                <div class="gm-summary-actions">
                                    <button type="button" class="gm-action-btn" id="btnCopyCaseLink" title="Copy direct link to access this case">
                                        <span id="copyCaseLinkIcon">🔗</span> <span id="copyCaseLinkText">Copy Direct Link</span>
                                    </button>
                                    <div class="gm-summary-time" id="dashCreatedAt">Submitted: Recently</div>
                                </div>
                            </div>

                            <h3 class="gm-case-subject" id="dashSubject">Case Subject</h3>
                            <p class="gm-case-description" id="dashDescription">Description...</p>

                            <!-- Official Determination Note (When Closed or Rejected) -->
                            <div class="gm-resolution-card" id="dashResolutionCard" style="display:none;">
                                <div class="gm-resolution-header">
                                    <span class="gm-resolution-icon" id="dashResolutionIcon">✅</span>
                                    <h4 class="gm-resolution-title" id="dashResolutionTitle">Case Determination</h4>
                                </div>
                                <p class="gm-resolution-body" id="dashResolutionNote"></p>
                            </div>

                            <!-- Visual Status Stepper -->
                            <div class="gm-stepper-wrap">
                                <div class="gm-stepper">
                                    <div class="gm-stepper-step active" id="stepSubmitted">
                                        <div class="gm-stepper-circle">1</div>
                                        <div class="gm-stepper-label">Submitted</div>
                                    </div>
                                    <div class="gm-stepper-line" id="line1"></div>
                                    <div class="gm-stepper-step" id="stepReview">
                                        <div class="gm-stepper-circle">2</div>
                                        <div class="gm-stepper-label">In Review</div>
                                    </div>
                                    <div class="gm-stepper-line" id="line2"></div>
                                    <div class="gm-stepper-step" id="stepResolution">
                                        <div class="gm-stepper-circle">3</div>
                                        <div class="gm-stepper-label" id="stepResolutionLabel">Resolution</div>
                                    </div>
                                </div>
                            </div>

                            <!-- Attached Evidence Files -->
                            <div class="gm-dash-evidence" id="dashEvidenceSection" style="display:none;">
                                <div class="gm-evidence-header-row">
                                    <h4 class="gm-dash-subhead">📁 Attached Evidence Files</h4>
                                    <span class="gm-evidence-count-badge" id="dashEvidenceCount">0 files</span>
                                </div>
                                <div class="gm-evidence-list" id="dashEvidenceList"></div>
                            </div>
                        </div>

                        <!-- Two-Way Live Chat Stream -->
                        <div class="gm-chat-card">
                            <div class="gm-chat-header">
                                <div class="gm-chat-title-group">
                                    <span class="gm-live-dot"></span>
                                    <span class="gm-chat-title">Case Communication Stream</span>
                                </div>
                                <div style="display:flex;align-items:center;gap:10px;">
                                    <button type="button" class="gm-chat-export-btn" id="btnExportTranscript" title="Download conversation history transcript">
                                        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                            <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
                                            <polyline points="7 10 12 15 17 10"></polyline>
                                            <line x1="12" y1="15" x2="12" y2="3"></line>
                                        </svg>
                                        <span>Export</span>
                                    </button>
                                    <span class="gm-chat-status" id="dashChatStatus">Live Channel</span>
                                </div>
                            </div>

                            <div class="gm-chat-messages" id="gmChatMessages">
                                <div class="gm-chat-empty" id="chatEmptyPlaceholder">
                                    💬 No messages yet. You can submit updates or additional context below.
                                </div>
                            </div>

                            <!-- Composer with Attachment -->
                            <form id="gmChatComposer" class="gm-chat-composer">
                                <div class="gm-chat-attach-preview" id="chatAttachPreview" style="display:none;">
                                    <span>📎 <span id="chatAttachName">file.png</span></span>
                                    <button type="button" class="gm-attach-preview-remove" id="btnRemoveChatAttach" title="Remove file">✕</button>
                                </div>
                                <div class="gm-composer-input-row">
                                    <label class="gm-chat-file-btn" title="Attach screenshot or document">
                                        <input type="file" id="chatFileInput" style="display:none;">
                                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                            <path d="M21.44 11.05l-9.19 9.19a6 6 0 0 1-8.49-8.49l9.19-9.19a4 4 0 0 1 5.66 5.66l-9.2 9.19a2 2 0 0 1-2.83-2.83l8.49-8.48"></path>
                                        </svg>
                                    </label>
                                    <input type="text" id="chatMessageInput" class="gm-chat-input" placeholder="Type a message or provide additional context..." autocomplete="off">
                                    <button type="submit" class="gm-chat-send-btn" id="btnSendChat">
                                        <span>Send</span>
                                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                                            <line x1="22" y1="2" x2="11" y2="13"></line>
                                            <polygon points="22 2 15 22 11 13 2 9 22 2"></polygon>
                                        </svg>
                                    </button>
                                </div>
                            </form>
                        </div>

                    </div>

                </div>

            </div>
        </section>

    </main>
</div>

<!-- ============================================================= -->
<!-- Responsive Styles for Modern, Clean Support Portal -->
<!-- ============================================================= -->
<style>
/* Animated canvas active on support page */

.gm-support-section {
    padding: 32px 20px 80px;
    max-width: 920px;
    margin: 0 auto;
    width: 100%;
}

/* Header */
.gm-support-header {
    text-align: center;
    margin-bottom: 28px;
}
.gm-support-title {
    font-size: 30px;
    font-weight: 800;
    letter-spacing: -0.02em;
    margin: 0 0 8px;
    line-height: 1.25;
    color: #ffffff;
}
html.light-mode .gm-support-title {
    color: #0f172a;
}
.gm-support-desc {
    font-size: 15px;
    color: #94a3b8;
    max-width: 640px;
    margin: 0 auto;
    line-height: 1.5;
}
html.light-mode .gm-support-desc {
    color: #64748b;
}

/* Tabs Navigation */
.gm-support-tabs {
    display: flex;
    gap: 8px;
    margin-bottom: 24px;
    background: rgba(255, 255, 255, 0.04);
    padding: 6px;
    border-radius: 999px;
    border: 1px solid rgba(255, 255, 255, 0.1);
    box-sizing: border-box;
    width: 100%;
    max-width: 100%;
}
html.light-mode .gm-support-tabs {
    background: #f1f5f9;
    border-color: rgba(0, 0, 0, 0.08);
}
.gm-support-tab {
    flex: 1 1 0;
    min-width: 0;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    padding: 10px 16px;
    font-size: 14px;
    font-weight: 700;
    border-radius: 999px;
    cursor: pointer;
    border: none;
    transition: all 0.2s ease;
    white-space: nowrap;
    background: transparent;
    color: #94a3b8;
    box-sizing: border-box;
}
html.light-mode .gm-support-tab {
    color: #64748b;
}
html.dark-mode .gm-support-tab.active {
    background: #ffffff;
    color: #040609 !important;
    box-shadow: 0 4px 14px rgba(0, 0, 0, 0.3);
}
html.dark-mode .gm-support-tab.active span {
    color: #040609 !important;
}
html.light-mode .gm-support-tab.active {
    background: #0f172a;
    color: #ffffff !important;
    box-shadow: 0 4px 14px rgba(0, 0, 0, 0.1);
}
html.light-mode .gm-support-tab.active span {
    color: #ffffff !important;
}
.gm-tab-badge {
    background: #10b981;
    color: #ffffff;
    font-size: 11px;
    font-weight: 800;
    padding: 2px 7px;
    border-radius: 999px;
    display: inline-block;
}

/* Tablet Layout Fix (501px - 768px): clean segmented bar with balanced padding */
@media (max-width: 768px) and (min-width: 501px) {
    .gm-support-tabs {
        border-radius: 14px;
        padding: 5px;
        gap: 6px;
        box-sizing: border-box;
    }
    .gm-support-tab {
        border-radius: 10px;
        padding: 9px 8px;
        font-size: 13px;
        gap: 6px;
        flex: 1 1 0;
        min-width: 0;
    }
    .gm-tab-icon {
        font-size: 14px;
    }
}

/* Mobile Layout Fix (<= 500px): stacked segmented buttons, 100% full width inside container */
@media (max-width: 500px) {
    .gm-support-tabs {
        flex-direction: column;
        border-radius: 14px;
        padding: 6px;
        gap: 6px;
        box-sizing: border-box;
    }
    .gm-support-tab {
        flex: none;
        width: 100%;
        border-radius: 10px;
        padding: 11px 14px;
        font-size: 13.5px;
        justify-content: center;
        box-sizing: border-box;
    }
}

/* Panels */
.gm-support-panel {
    display: none;
}
.gm-support-panel.active {
    display: block;
}

/* Member Banner */
.gm-member-badge-card {
    display: flex;
    align-items: center;
    gap: 12px;
    background: rgba(16, 185, 129, 0.08);
    border: 1px solid rgba(16, 185, 129, 0.25);
    border-radius: 12px;
    padding: 14px 18px;
    margin-bottom: 20px;
}
html.light-mode .gm-member-badge-card {
    background: #ecfdf5;
    border-color: #a7f3d0;
}
.gm-member-badge-icon {
    font-size: 22px;
}
.gm-member-badge-title {
    font-size: 14px;
    font-weight: 700;
    color: #10b981;
    margin-bottom: 2px;
}
html.light-mode .gm-member-badge-title {
    color: #047857;
}
.gm-member-badge-sub {
    font-size: 12px;
    color: #94a3b8;
}
html.light-mode .gm-member-badge-sub {
    color: #4b5563;
}

/* Form Container */
.gm-support-form {
    background: rgba(13, 17, 23, 0.85);
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-radius: 16px;
    padding: 28px;
    box-shadow: 0 8px 32px rgba(0, 0, 0, 0.35);
}
html.light-mode .gm-support-form {
    background: rgba(255, 255, 255, 0.88);
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
    border-color: #e2e8f0;
    box-shadow: 0 8px 32px rgba(0, 0, 0, 0.06);
}
.gm-form-group {
    margin-bottom: 20px;
}
.gm-form-label {
    display: block;
    font-size: 13px;
    font-weight: 700;
    margin-bottom: 8px;
    color: #f0f6fc;
}
html.light-mode .gm-form-label {
    color: #0f172a;
}
.gm-required {
    color: #ef4444;
}

/* Inputs, Textarea, Select */
.gm-form-input,
.gm-form-select,
.gm-form-textarea {
    width: 100%;
    padding: 12px 16px;
    font-size: 14px;
    border-radius: 10px;
    transition: all 0.2s ease;
    box-sizing: border-box;
    font-family: inherit;
}
html.dark-mode .gm-form-input,
html.dark-mode .gm-form-select,
html.dark-mode .gm-form-textarea {
    background: #161b22;
    border: 1px solid #30363d;
    color: #f0f6fc;
}
html.dark-mode .gm-form-input:focus,
html.dark-mode .gm-form-select:focus,
html.dark-mode .gm-form-textarea:focus {
    border-color: #38bdf8;
    outline: none;
    box-shadow: 0 0 0 3px rgba(56, 189, 248, 0.15);
}
html.light-mode .gm-form-input,
html.light-mode .gm-form-select,
html.light-mode .gm-form-textarea {
    background: #f8fafc;
    border: 1px solid #cbd5e1;
    color: #0f172a;
}
html.light-mode .gm-form-input:focus,
html.light-mode .gm-form-select:focus,
html.light-mode .gm-form-textarea:focus {
    border-color: #0f172a;
    outline: none;
    box-shadow: 0 0 0 3px rgba(0, 0, 0, 0.08);
}
.gm-form-grid-2 {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 16px;
}
@media (max-width: 640px) {
    .gm-form-grid-2 { grid-template-columns: 1fr; }
}

/* Dropzone */
.gm-dropzone {
    border: 2px dashed rgba(255, 255, 255, 0.18);
    border-radius: 12px;
    padding: 24px 16px;
    text-align: center;
    cursor: pointer;
    background: rgba(255, 255, 255, 0.02);
    transition: all 0.2s ease;
}
.gm-dropzone:hover, .gm-dropzone.drag-active {
    border-color: #38bdf8;
    background: rgba(56, 189, 248, 0.05);
}
html.light-mode .gm-dropzone {
    border-color: #cbd5e1;
    background: #f8fafc;
}
html.light-mode .gm-dropzone:hover, html.light-mode .gm-dropzone.drag-active {
    border-color: #0284c7;
    background: #f0f9ff;
}
.gm-dropzone-icon {
    margin-bottom: 6px;
    color: #38bdf8;
}
html.light-mode .gm-dropzone-icon {
    color: #0284c7;
}
.gm-dropzone-title {
    font-size: 14px;
    font-weight: 700;
    margin: 0 0 4px;
    color: #f0f6fc;
}
html.light-mode .gm-dropzone-title {
    color: #0f172a;
}
.gm-dropzone-sub {
    font-size: 12px;
    color: #8b949e;
    margin: 0;
}
html.light-mode .gm-dropzone-sub {
    color: #64748b;
}

/* File list */
.gm-file-list {
    margin-top: 12px;
    display: flex;
    flex-direction: column;
    gap: 8px;
}
.gm-file-item {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 8px 12px;
    background: #161b22;
    border: 1px solid #30363d;
    border-radius: 8px;
    font-size: 13px;
    color: #f0f6fc;
}
html.light-mode .gm-file-item {
    background: #f1f5f9;
    border-color: #cbd5e1;
    color: #0f172a;
}
.gm-file-remove {
    background: transparent;
    border: none;
    color: #ef4444;
    cursor: pointer;
    font-weight: 800;
    padding: 2px 8px;
}

/* Card Checkbox */
.gm-form-card {
    background: #161b22;
    border: 1px solid #30363d;
    border-radius: 10px;
    padding: 16px;
    margin-bottom: 20px;
}
html.light-mode .gm-form-card {
    background: #f8fafc;
    border-color: #e2e8f0;
}
.gm-checkbox-label {
    display: flex;
    align-items: flex-start;
    gap: 12px;
    cursor: pointer;
}
.gm-checkbox-label input { display: none; }
.gm-custom-checkbox {
    width: 18px;
    height: 18px;
    border-radius: 4px;
    border: 2px solid #64748b;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    margin-top: 2px;
}
.gm-checkbox-label input:checked + .gm-custom-checkbox {
    background: #10b981;
    border-color: #10b981;
}
.gm-checkbox-label input:checked + .gm-custom-checkbox::after {
    content: '✓';
    color: #ffffff;
    font-size: 12px;
    font-weight: 900;
}
.gm-checkbox-text {
    display: flex;
    flex-direction: column;
    gap: 2px;
}
.gm-checkbox-text strong { font-size: 14px; color: #f0f6fc; }
html.light-mode .gm-checkbox-text strong { color: #0f172a; }
.gm-checkbox-text small { font-size: 12px; color: #8b949e; }
html.light-mode .gm-checkbox-text small { color: #64748b; }
.gm-anon-fields {
    margin-top: 14px;
    padding-top: 14px;
    border-top: 1px solid #30363d;
}
html.light-mode .gm-anon-fields { border-top-color: #e2e8f0; }

/* Submit Button */
.gm-submit-case-btn {
    width: 100%;
    padding: 14px 24px;
    font-size: 15px;
    font-weight: 800;
    border-radius: 999px;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    border: none;
    transition: all 0.2s ease;
}
html.dark-mode .gm-submit-case-btn {
    background: #ffffff;
    color: #040609 !important;
}
html.dark-mode .gm-submit-case-btn * {
    color: #040609 !important;
}
html.dark-mode .gm-submit-case-btn:hover {
    background: #e2e8f0;
    transform: translateY(-1px);
}
html.light-mode .gm-submit-case-btn {
    background: #0f172a;
    color: #ffffff !important;
}
html.light-mode .gm-submit-case-btn * {
    color: #ffffff !important;
}
html.light-mode .gm-submit-case-btn:hover {
    background: #1e293b;
    transform: translateY(-1px);
}

/* Alert Boxes */
.gm-submit-alert {
    padding: 12px 16px;
    border-radius: 10px;
    font-size: 13px;
    line-height: 1.5;
    margin-top: 14px;
    display: none;
    word-break: break-word;
    text-align: left;
}
.gm-submit-alert.error {
    background: rgba(239, 68, 68, 0.12);
    border: 1px solid #ef4444;
    color: #fca5a5;
}
html.light-mode .gm-submit-alert.error {
    background: #fef2f2;
    border-color: #f87171;
    color: #991b1b;
}

/* Success Card */
.gm-case-success-card {
    background: #0d1117;
    border: 1px solid #10b981;
    border-radius: 16px;
    padding: 32px 24px;
    text-align: center;
}
html.light-mode .gm-case-success-card {
    background: #ffffff;
    border-color: #10b981;
    box-shadow: 0 10px 30px rgba(16, 185, 129, 0.1);
}
.gm-success-badge { margin-bottom: 12px; }
.gm-success-title { font-size: 24px; font-weight: 800; margin: 0 0 8px; color: #10b981; }
.gm-success-desc { font-size: 14px; color: #94a3b8; max-width: 540px; margin: 0 auto 20px; line-height: 1.5; }
html.light-mode .gm-success-desc { color: #64748b; }
.gm-credentials-box {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 14px;
    margin-bottom: 24px;
}
@media (max-width: 640px) {
    .gm-credentials-box { grid-template-columns: 1fr; }
}
.gm-credential-item {
    background: #161b22;
    border: 1px solid #30363d;
    border-radius: 10px;
    padding: 12px 14px;
    text-align: left;
}
html.light-mode .gm-credential-item {
    background: #f8fafc;
    border-color: #e2e8f0;
}
.gm-credential-label {
    display: block;
    font-size: 11px;
    font-weight: 800;
    color: #8b949e;
    margin-bottom: 4px;
    text-transform: uppercase;
    letter-spacing: 0.05em;
}
.gm-credential-value {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 8px;
}
.gm-credential-value code {
    font-size: 14px;
    font-weight: 700;
    color: #38bdf8;
    word-break: break-all;
}
html.light-mode .gm-credential-value code { color: #0284c7; }
.gm-copy-btn {
    background: rgba(255, 255, 255, 0.1);
    border: none;
    border-radius: 6px;
    padding: 4px 10px;
    font-size: 12px;
    font-weight: 700;
    color: #ffffff;
    cursor: pointer;
}
html.light-mode .gm-copy-btn {
    background: #e2e8f0;
    color: #0f172a;
}
.gm-success-actions {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 12px;
    flex-wrap: wrap;
}
.gm-copy-link-btn, .gm-view-case-btn {
    padding: 12px 20px;
    border-radius: 999px;
    font-size: 13px;
    font-weight: 700;
    cursor: pointer;
    border: none;
    transition: all 0.2s ease;
}
.gm-copy-link-btn {
    background: rgba(255, 255, 255, 0.08);
    color: #ffffff;
    border: 1px solid rgba(255, 255, 255, 0.2);
}
html.light-mode .gm-copy-link-btn {
    background: #f1f5f9;
    color: #0f172a;
    border-color: #cbd5e1;
}
.gm-view-case-btn {
    background: #10b981;
    color: #ffffff;
}

/* ============================================================= */
/* TAB 2: MY CASES STYLES */
/* ============================================================= */
.gm-mycases-wrapper {
    background: #0d1117;
