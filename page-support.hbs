{{!< default}}
{{#if @member}}<meta id="gm-support-member-meta" data-logged-in="true" data-email="{{@member.email}}" data-name="{{@member.name}}" data-uuid="{{@member.uuid}}">{{else}}<meta id="gm-support-member-meta" data-logged-in="false">{{/if}}

<link rel="stylesheet" href="{{asset "built/support-portal.css"}}">

<div class="content-area">
    <main class="site-main">

        <section class="gm-support-section">
            <div class="gm-support-container">

                <!-- Clean Hero Header -->
                <div class="gm-support-header">
                    <h1 class="gm-support-title">Reports Portal</h1>
                    <p class="gm-support-desc">
                        Send a report, attach screenshots or files, and get replies from our team.
                    </p>
                </div>

                <!-- Navigation Tabs (Submit Report | My Reports | Track Report) -->
                <div class="gm-support-tabs">
                    <button type="button" class="gm-support-tab active" id="tabBtnSubmit" data-support-tab="submit">
                        <span class="gm-tab-icon">📝</span>
                        <span>Submit Report</span>
                    </button>
                    {{#if @member}}
                    <button type="button" class="gm-support-tab" id="tabBtnMyCases" data-support-tab="mycases">
                        <span class="gm-tab-icon">📁</span>
                        <span>My Reports</span>
                        <span class="gm-tab-badge gm-init-hidden" id="myCasesBadge">0</span>
                    </button>
                    {{/if}}
                    <button type="button" class="gm-support-tab" id="tabBtnTrack" data-support-tab="track">
                        <span class="gm-tab-icon">🔍</span>
                        <span>Track Report</span>
                        <span class="gm-tab-badge gm-init-hidden" id="activeCaseBadge">Active</span>
                    </button>
                </div>

                <!-- ============================================================= -->
                <!-- TAB 1: NEW REPORT SUBMISSION FORM -->
                <!-- ============================================================= -->
                <div class="gm-support-panel active" id="panelSubmit">
                    <form id="gmSupportForm" class="gm-support-form">

                        <!-- Member Logged-In Notice -->
                        {{#if @member}}
                        <div class="gm-member-badge-card" id="memberStatusBanner">
                            <div class="gm-member-badge-icon">👤</div>
                            <div class="gm-member-badge-content">
                                <div class="gm-member-badge-title">Signed in as <strong>{{@member.email}}</strong>
                                </div>
                                <div class="gm-member-badge-sub">This report will show up under "My Reports" so you
                                    can check updates anytime.</div>
                            </div>
                        </div>
                        {{/if}}

                        <!-- Row 1: Category & Priority -->
                        <div class="gm-form-row gm-form-grid-2">
                            <div class="gm-form-group">
                                <label for="caseCategory" class="gm-form-label">Category <span
                                        class="gm-required">*</span></label>
                                <select id="caseCategory" name="category" class="gm-form-select" required>
                                    <option value="Abuse or Incident Report">Abuse or Incident</option>
                                    <option value="Exploitation or Grooming">Exploitation or Grooming</option>
                                    <option value="Evidence or Tip">Evidence or Tip</option>
                                    <option value="General Question">General Question</option>
                                </select>
                            </div>

                            <div class="gm-form-group">
                                <label for="casePriority" class="gm-form-label">Urgency <span
                                        class="gm-required">*</span></label>
                                <select id="casePriority" name="priority" class="gm-form-select" required>
                                    <option value="STANDARD" selected>Normal</option>
                                    <option value="URGENT">Urgent</option>
                                    <option value="CRITICAL">Emergency</option>
                                    <option value="LOW">Low</option>
                                </select>
                            </div>
                        </div>

                        <!-- Subject -->
                        <div class="gm-form-group">
                            <label for="caseSubject" class="gm-form-label">Subject <span
                                    class="gm-required">*</span></label>
                            <input type="text" id="caseSubject" name="subject" class="gm-form-input"
                                placeholder="Short summary of what happened" required maxlength="180">
                        </div>

                        <!-- Description Narrative -->
                        <div class="gm-form-group">
                            <label for="caseDescription" class="gm-form-label">Details <span
                                    class="gm-required">*</span></label>
                            <textarea id="caseDescription" name="description" class="gm-form-textarea" rows="5"
                                placeholder="Explain what happened, including any links, usernames, dates, or helpful context..."
                                required></textarea>
                        </div>

                        <!-- Evidence File Dropzone -->
                        <div class="gm-form-group">
                            <label for="evidenceFileInput" class="gm-form-label">Attachments (Optional)</label>
                            <div class="gm-dropzone" id="gmDropzone">
                                <input type="file" id="evidenceFileInput" class="gm-init-hidden" multiple
                                    accept=".jpg,.jpeg,.png,.webp,.pdf,.txt,.log,.mp4,.zip">
                                <div class="gm-dropzone-content">
                                    <div class="gm-dropzone-icon">
                                        <svg width="28" height="28" viewBox="0 0 24 24" fill="none"
                                            stroke="currentColor" stroke-width="2" stroke-linecap="round"
                                            stroke-linejoin="round" aria-hidden="true">
                                            <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
                                            <polyline points="17 8 12 3 7 8"></polyline>
                                            <line x1="12" y1="3" x2="12" y2="15"></line>
                                        </svg>
                                    </div>
                                    <p class="gm-dropzone-title">Click to upload or drag &amp; drop files</p>
                                    <p class="gm-dropzone-sub">Images, screenshots, PDFs, text files, or videos (up
                                        to 50MB)</p>
                                </div>
                            </div>
                            <div class="gm-file-list gm-init-hidden" id="gmFileList"></div>
                        </div>

                        <!-- Identity & Anonymity Preferences -->
                        <div class="gm-form-card">
                            {{#if @member}}
                            <!-- Member Anonymity Option -->
                            <label class="gm-checkbox-label">
                                <input type="checkbox" id="anonToggle" data-anon-mode="member">
                                <span class="gm-custom-checkbox"></span>
                                <span class="gm-checkbox-text">
                                    <strong>Send Anonymously</strong>
                                    <small>Don't link this report to your account. Save your tracking details on the
                                        next screen.</small>
                                </span>
                            </label>
                            {{else}}
                            <!-- Non-Member Optional Contact -->
                            <label class="gm-checkbox-label">
                                <input type="checkbox" id="anonToggle" checked data-anon-mode="guest">
                                <span class="gm-custom-checkbox"></span>
                                <span class="gm-checkbox-text">
                                    <strong>Stay Anonymous</strong>
                                    <small>No personal details will be sent with this report.</small>
                                </span>
                            </label>
                            <div class="gm-anon-fields gm-init-hidden" id="anonFields">
                                <div class="gm-form-row gm-form-grid-2">
                                    <div class="gm-form-group">
                                        <label for="reporterAlias" class="gm-form-label">Name or Nickname
                                            (Optional)</label>
                                        <input type="text" id="reporterAlias" name="reporter_alias"
                                            class="gm-form-input" placeholder="Optional">
                                    </div>
                                    <div class="gm-form-group">
                                        <label for="reporterContact" class="gm-form-label">Email or Handle
                                            (Optional)</label>
                                        <input type="text" id="reporterContact" name="reporter_contact"
                                            class="gm-form-input" placeholder="How we can reach you">
                                    </div>
                                </div>
                            </div>
                            {{/if}}
                        </div>

                        <!-- Verification Challenge Card -->
                        <div class="gm-captcha-card" id="gmCaptchaCard">
                            <div class="gm-captcha-row">
                                <div class="gm-captcha-visual" id="gmCaptchaVisual">
                                    <span class="gm-captcha-loading">Loading check...</span>
                                </div>
                                <button type="button" class="gm-captcha-refresh-btn" id="btnRefreshCaptcha"
                                    title="Refresh check" aria-label="Refresh security check">
                                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none"
                                        stroke="currentColor" stroke-width="2" stroke-linecap="round"
                                        stroke-linejoin="round" aria-hidden="true">
                                        <polyline points="23 4 23 10 17 10"></polyline>
                                        <polyline points="1 20 1 14 7 14"></polyline>
                                        <path
                                            d="M3.51 9a9 9 0 0 1 14.85-3.36L23 10M1 14l4.64 4.36A9 9 0 0 0 20.49 15">
                                        </path>
                                    </svg>
                                </button>
                                <div class="gm-captcha-input-wrap">
                                    <label class="gm-sr-only" for="gmCaptchaInput">Security check answer</label>
                                    <input type="text" id="gmCaptchaInput" class="gm-form-input gm-captcha-input"
                                        placeholder="Answer" autocomplete="off" required>
                                </div>
                            </div>
                            <input type="hidden" id="gmCaptchaId" name="captcha_id">
                            <input type="hidden" id="gmCaptchaTimestamp" name="captcha_timestamp">
                            <input type="hidden" id="gmCaptchaSignature" name="captcha_signature">
                            <input type="hidden" id="gmCaptchaNonce" name="captcha_nonce">
                            <input type="hidden" id="gmCaptchaSolution" name="captcha_solution">
                        </div>

                        <!-- Submit Button -->
                        <div class="gm-form-actions">
                            <button type="submit" class="gm-submit-case-btn" id="btnSubmitCase">
                                <span class="gm-btn-text">Submit Report</span>
                                <span class="gm-btn-icon">→</span>
                            </button>
                            <div id="caseSubmitAlert" class="gm-submit-alert gm-init-hidden" role="alert">
                            </div>
                        </div>

                    </form>

                    <!-- Success Confirmation Banner -->
                    <div class="gm-case-success-card gm-init-hidden" id="caseSuccessCard">
                        <div class="gm-success-badge">
                            <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="#10b981"
                                stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"
                                aria-hidden="true">
                                <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path>
                                <polyline points="22 4 12 14.01 9 11.01"></polyline>
                            </svg>
                        </div>
                        <h2 class="gm-success-title">Report Submitted</h2>
                        <p class="gm-success-desc">
                            We received your report. Save these details if you want to check for replies later.
                        </p>

                        <div class="gm-credentials-box">
                            <div class="gm-credential-item">
                                <span class="gm-credential-label">REPORT CODE</span>
                                <div class="gm-credential-value">
                                    <code id="resCaseCode">---</code>
                                    <button type="button" class="gm-copy-btn"
                                        data-copy-target="resCaseCode">Copy</button>
                                </div>
                            </div>
                            <div class="gm-credential-item">
                                <span class="gm-credential-label">PASSCODE</span>
                                <div class="gm-credential-value">
                                    <code id="resAccessKey">---</code>
                                    <button type="button" class="gm-copy-btn"
                                        data-copy-target="resAccessKey">Copy</button>
                                </div>
                            </div>
                        </div>

                        <div class="gm-success-actions">
                            <button type="button" class="gm-copy-link-btn" id="btnSuccessCopyLink">
                                <span>🔗 Copy Share Link</span>
                            </button>
                            <button type="button" class="gm-view-case-btn" id="btnOpenActiveCase">
                                <span>View Report &amp; Messages</span> →
                            </button>
                        </div>
                    </div>

                </div>

                <!-- ============================================================= -->
                <!-- TAB 2: MY REPORTS (MEMBER & DEVICE TRACKING) -->
                <!-- ============================================================= -->
                <div class="gm-support-panel" id="panelMyCases">
                    <div class="gm-mycases-wrapper">

                        <div class="gm-mycases-header">
                            <div>
                                <h3 class="gm-mycases-heading">My Reports</h3>
                                <p class="gm-mycases-sub" id="myCasesSubText">
                                    Check status updates and message our team.
                                </p>
                            </div>
                            <button type="button" class="gm-refresh-btn" id="btnRefreshCases">
                                <span>🔄 Refresh</span>
                            </button>
                        </div>

                        <!-- Loading Indicator -->
                        <div class="gm-cases-loading gm-init-hidden" id="myCasesLoading">
                            <div class="gm-spinner"></div>
                            <span>Loading your reports...</span>
                        </div>

                        <!-- Empty State -->
                        <div class="gm-cases-empty gm-init-hidden" id="myCasesEmpty">
                            <div class="gm-empty-icon">📁</div>
                            <h4 class="gm-empty-title">No Reports Yet</h4>
                            <p class="gm-empty-desc" id="myCasesEmptyDesc">
                                You haven't submitted any reports with this account yet.
                            </p>
                            <button type="button" class="gm-empty-cta" data-support-tab="submit">
                                <span>Submit a Report</span> →
                            </button>
                        </div>

                        <!-- Cases List Container -->
                        <div class="gm-cases-list" id="myCasesList"></div>

                    </div>
                </div>

                <!-- ============================================================= -->
                <!-- TAB 3: REPORT TRACKING & MESSAGES -->
                <!-- ============================================================= -->
                <div class="gm-support-panel" id="panelTrack">

                    <!-- Report Lookup Card -->
                    <div class="gm-lookup-card" id="gmLookupCard">
                        <h3 class="gm-lookup-title">Track a Report</h3>
                        <p class="gm-lookup-sub">Enter your Report Code and Passcode to check updates and send
                            messages.</p>

                        <div class="gm-form-row gm-form-grid-2">
                            <div class="gm-form-group">
                                <label for="lookupCaseCode" class="gm-form-label">Report Code</label>
                                <input type="text" id="lookupCaseCode" class="gm-form-input"
                                    placeholder="e.g. CASE-4892-F91A">
                            </div>
                            <div class="gm-form-group">
                                <label for="lookupAccessKey" class="gm-form-label">Passcode</label>
                                <input type="text" id="lookupAccessKey" class="gm-form-input"
                                    placeholder="Enter your passcode">
                            </div>
                        </div>

                        <div class="gm-lookup-actions">
                            <button type="button" class="gm-lookup-btn" id="btnLookupCase">
                                <span>Open Report</span> →
                            </button>
                        </div>
                    </div>

                    <!-- Active Report Dashboard Container (Hidden until loaded) -->
                    <div class="gm-case-dashboard gm-init-hidden" id="gmCaseDashboard">

                        <!-- Summary Ribbon -->
                        <div class="gm-case-summary-card">
                            <div class="gm-summary-header">
                                <div class="gm-summary-tags">
                                    <span class="gm-case-code-badge" id="dashCaseCode">#CASE-0000</span>
                                    <span class="gm-priority-badge" id="dashPriority">STANDARD</span>
                                    <span class="gm-category-badge gm-init-hidden" id="dashCategory"></span>
                                    <span class="gm-alias-badge gm-init-hidden" id="dashReporter"></span>
                                </div>
                                <div class="gm-summary-actions">
                                    <button type="button" class="gm-action-btn" id="btnCopyCaseLink"
                                        title="Copy direct link to this report">
                                        <span id="copyCaseLinkIcon">🔗</span> <span id="copyCaseLinkText">Copy Share
                                            Link</span>
                                    </button>
                                    <div class="gm-summary-time" id="dashCreatedAt">Submitted: Recently</div>
                                </div>
                            </div>

                            <h3 class="gm-case-subject" id="dashSubject">Report Subject</h3>
                            <p class="gm-case-description" id="dashDescription">Description...</p>

                            <!-- Outcome Note (When Closed or Rejected) -->
                            <div class="gm-resolution-card gm-init-hidden" id="dashResolutionCard">
                                <div class="gm-resolution-header">
                                    <span class="gm-resolution-icon" id="dashResolutionIcon">✅</span>
                                    <h4 class="gm-resolution-title" id="dashResolutionTitle">Team Update</h4>
                                </div>
                                <p class="gm-resolution-body" id="dashResolutionNote"></p>
                            </div>

                            <!-- Visual Status Stepper -->
                            <div class="gm-stepper-wrap">
                                <div class="gm-stepper">
                                    <div class="gm-stepper-step active" id="stepSubmitted">
                                        <div class="gm-stepper-circle">1</div>
                                        <div class="gm-stepper-label">Submitted</div>
                                    </div>
                                    <div class="gm-stepper-line" id="line1"></div>
                                    <div class="gm-stepper-step" id="stepReview">
                                        <div class="gm-stepper-circle">2</div>
                                        <div class="gm-stepper-label">In Review</div>
                                    </div>
                                    <div class="gm-stepper-line" id="line2"></div>
                                    <div class="gm-stepper-step" id="stepResolution">
                                        <div class="gm-stepper-circle">3</div>
                                        <div class="gm-stepper-label" id="stepResolutionLabel">Done</div>
                                    </div>
                                </div>
                            </div>

                            <!-- Attached Files -->
                            <div class="gm-dash-evidence gm-init-hidden" id="dashEvidenceSection">
                                <div class="gm-evidence-header-row">
                                    <h4 class="gm-dash-subhead">📁 Attached Files</h4>
                                    <span class="gm-evidence-count-badge" id="dashEvidenceCount">0 files</span>
                                </div>
                                <div class="gm-evidence-list" id="dashEvidenceList"></div>
                            </div>
                        </div>

                        <!-- Messages -->
                        <div class="gm-chat-card">
                            <div class="gm-chat-header">
                                <div class="gm-chat-title-group">
                                    <span class="gm-live-dot"></span>
                                    <span class="gm-chat-title">Messages</span>
                                </div>
                                <div class="gm-chat-header-actions">
                                    <button type="button" class="gm-chat-export-btn" id="btnExportTranscript"
                                        title="Download chat history">
                                        <svg width="13" height="13" viewBox="0 0 24 24" fill="none"
                                            stroke="currentColor" stroke-width="2" stroke-linecap="round"
                                            stroke-linejoin="round" aria-hidden="true">
                                            <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
                                            <polyline points="7 10 12 15 17 10"></polyline>
                                            <line x1="12" y1="15" x2="12" y2="3"></line>
                                        </svg>
                                        <span>Download</span>
                                    </button>
                                    <span class="gm-chat-status" id="dashChatStatus">Open</span>
                                </div>
                            </div>

                            <div class="gm-chat-messages" id="gmChatMessages">
                                <div class="gm-chat-empty" id="chatEmptyPlaceholder">
                                    💬 No messages yet. Send an update or question below.
                                </div>
                            </div>

                            <!-- Composer with Attachment -->
                            <form id="gmChatComposer" class="gm-chat-composer">
                                <div class="gm-chat-attach-preview gm-init-hidden" id="chatAttachPreview">
                                    <span>📎 <span id="chatAttachName">file.png</span></span>
                                    <button type="button" class="gm-attach-preview-remove" id="btnRemoveChatAttach"
                                        title="Remove file">✕</button>
                                </div>
                                <div class="gm-composer-input-row">
                                    <label class="gm-chat-file-btn" title="Attach file or screenshot">
                                        <input type="file" id="chatFileInput" class="gm-init-hidden">
                                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none"
                                            stroke="currentColor" stroke-width="2" stroke-linecap="round"
                                            stroke-linejoin="round" aria-hidden="true">
                                            <path
                                                d="M21.44 11.05l-9.19 9.19a6 6 0 0 1-8.49-8.49l9.19-9.19a4 4 0 0 1 5.66 5.66l-9.2 9.19a2 2 0 0 1-2.83-2.83l8.49-8.48">
                                            </path>
                                        </svg>
                                    </label>
                                    <input type="text" id="chatMessageInput" class="gm-chat-input"
                                        placeholder="Write a message..." autocomplete="off">
                                    <button type="submit" class="gm-chat-send-btn" id="btnSendChat">
                                        <span>Send</span>
                                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none"
                                            stroke="currentColor" stroke-width="2.5" stroke-linecap="round"
                                            stroke-linejoin="round" aria-hidden="true">
                                            <line x1="22" y1="2" x2="11" y2="13"></line>
                                            <polygon points="22 2 15 22 11 13 2 9 22 2"></polygon>
                                        </svg>
                                    </button>
                                </div>
                            </form>
                        </div>

                    </div>

                </div>

                <!-- Report Submission Waiting Popup -->
                <dialog id="gmReportWaitingDialog" class="gm-waiting-dialog" aria-labelledby="gmWaitingDialogTitle"
                    aria-describedby="gmWaitingDialogDesc" closedby="none">
                    <div class="gm-waiting-spinner" aria-hidden="true"></div>
                    <h2 id="gmWaitingDialogTitle" class="gm-waiting-title">Submitting Your Report...</h2>
                    <p id="gmWaitingDialogDesc" class="gm-waiting-desc" role="status" aria-live="polite">Checking
                        your submission...</p>
                    <p class="gm-waiting-sub">Uploading files may take a moment. Please keep this page open.</p>
                </dialog>

            </div>
        </section>

    </main>
</div>

<script defer src="{{asset "built/support-portal.js"}}"></script>
