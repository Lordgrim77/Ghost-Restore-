}
.gm-case-card-desc {
    font-size: 13px;
    color: #8b949e;
    margin: 0 0 14px;
    line-height: 1.45;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
}
html.light-mode .gm-case-card-desc {
    color: #475569;
}
.gm-case-card-actions {
    display: flex;
    align-items: center;
    justify-content: flex-end;
}
.gm-open-case-btn {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    background-color: #ffffff !important;
