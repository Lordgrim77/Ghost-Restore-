<!-- Support Portal Controller Script -->
<script>
(function() {
    'use strict';

    // Auto-detect API base (direct 8080 during local testing or reverse proxy /api/support in production)
    const API_BASE = (window.location.port === '2368' || window.location.port === '3000') 
        ? 'http://127.0.0.1:8080/api/support' 
        : '/api/support';

    let selectedFiles = [];
    let currentCaseCode = null;
    let currentAccessKey = null;
    let pollTimer = null;

    // Tab Switching
    window.switchSupportTab = function(tab) {
        const btnSubmit = document.getElementById('tabBtnSubmit');
        const btnTrack = document.getElementById('tabBtnTrack');
        const pSubmit = document.getElementById('panelSubmit');
        const pTrack = document.getElementById('panelTrack');

        if (tab === 'submit') {
            btnSubmit.classList.add('active');
            btnTrack.classList.remove('active');
            pSubmit.classList.add('active');
            pTrack.classList.remove('active');
        } else {
            btnTrack.classList.add('active');
            btnSubmit.classList.remove('active');
            pTrack.classList.add('active');
            pSubmit.classList.remove('active');
            // Try auto-loading saved case
            checkSavedCase();
        }
    };

    window.toggleAnonFields = function(isAnon) {
        const fields = document.getElementById('anonFields');
        if (fields) fields.style.display = isAnon ? 'none' : 'block';
    };

    // File Selection & Drag-and-drop
    window.handleFileSelect = function(e) {
        const files = Array.from(e.target.files || []);
        addFiles(files);
    };

    const dropzone = document.getElementById('gmDropzone');
    if (dropzone) {
        ['dragenter', 'dragover'].forEach(name => {
            dropzone.addEventListener(name, (e) => { e.preventDefault(); dropzone.style.borderColor = '#10b981'; });
        });
        ['dragleave', 'drop'].forEach(name => {
            dropzone.addEventListener(name, (e) => { e.preventDefault(); dropzone.style.borderColor = ''; });
        });
        dropzone.addEventListener('drop', (e) => {
            const files = Array.from(e.dataTransfer.files || []);
            addFiles(files);
        });
    }

    function addFiles(files) {
        selectedFiles = selectedFiles.concat(files);
        renderFileList();
    }

    function renderFileList() {
        const list = document.getElementById('gmFileList');
        if (!list) return;
        if (selectedFiles.length === 0) {
            list.style.display = 'none';
            list.innerHTML = '';
            return;
        }
        list.style.display = 'flex';
        list.innerHTML = selectedFiles.map((f, i) => `
            <div class="gm-file-item">
                <span>📁 <strong>${escapeHtml(f.name)}</strong> (${(f.size / 1024).toFixed(1)} KB)</span>
                <button type="button" class="gm-file-remove" onclick="removeFile(${i})">✕</button>
            </div>
        `).join('');
    }

    window.removeFile = function(index) {
        selectedFiles.splice(index, 1);
        renderFileList();
    };

    // Case Submission
    window.handleCaseSubmit = async function(e) {
        e.preventDefault();
        const btn = document.getElementById('btnSubmitCase');
        btn.disabled = true;
        btn.querySelector('.gm-btn-text').textContent = 'Encrypting & Dispatching...';

        try {
            const formData = new FormData();
            formData.append('category', document.getElementById('caseCategory').value);
            const prio = document.querySelector('input[name="priority"]:checked');
            formData.append('priority', prio ? prio.value : 'STANDARD');
            formData.append('subject', document.getElementById('caseSubject').value);
            formData.append('description', document.getElementById('caseDescription').value);

            const isAnon = document.getElementById('anonToggle').checked;
            if (!isAnon) {
                formData.append('reporter_alias', document.getElementById('reporterAlias').value);
                formData.append('reporter_contact', document.getElementById('reporterContact').value);
            } else {
                formData.append('reporter_alias', 'Anonymous');
            }

            selectedFiles.forEach(f => {
                formData.append('evidence', f, f.name);
            });

            const res = await fetch(`${API_BASE}/cases`, {
                method: 'POST',
                body: formData
            });

            if (!res.ok) {
                const err = await res.json().catch(() => ({}));
                throw new Error(err.error || `Server responded with ${res.status}`);
            }

            const data = await res.json();
            // Store credentials
            currentCaseCode = data.case_code;
            currentAccessKey = data.access_key;
            localStorage.setItem('gm_active_case_code', currentCaseCode);
            localStorage.setItem('gm_active_access_key', currentAccessKey);

            // Display success
            document.getElementById('gmSupportForm').style.display = 'none';
            document.getElementById('resCaseCode').textContent = currentCaseCode;
            document.getElementById('resAccessKey').textContent = currentAccessKey;
            document.getElementById('caseSuccessCard').style.display = 'block';

            // Mark badge
            const badge = document.getElementById('activeCaseBadge');
            if (badge) badge.style.display = 'inline-block';

        } catch(err) {
            alert('Failed to submit report: ' + err.message);
        } finally {
            btn.disabled = false;
            btn.querySelector('.gm-btn-text').textContent = 'Submit Confidential Report';
        }
    };

    window.openActiveCaseDashboard = function() {
        switchSupportTab('track');
        if (currentCaseCode && currentAccessKey) {
            loadCase(currentCaseCode, currentAccessKey);
        }
    };

    window.loadCaseFromInputs = function() {
        const code = document.getElementById('lookupCaseCode').value.trim();
        const key = document.getElementById('lookupAccessKey').value.trim();
        if (!code || !key) {
            alert('Please enter both your Case Reference Code and Private Access Key.');
            return;
        }
        loadCase(code, key);
    };

    async function loadCase(code, key) {
        try {
            const res = await fetch(`${API_BASE}/cases/${encodeURIComponent(code)}?key=${encodeURIComponent(key)}`);
            if (!res.ok) {
                const err = await res.json().catch(() => ({}));
                throw new Error(err.error || 'Failed to load case');
            }
            const data = await res.json();
            currentCaseCode = code;
            currentAccessKey = key;
            localStorage.setItem('gm_active_case_code', code);
            localStorage.setItem('gm_active_access_key', key);

            renderCaseDashboard(data);

            // Start polling for real-time live chat & status transitions
            if (pollTimer) clearInterval(pollTimer);
            pollTimer = setInterval(() => pollCaseUpdates(), 3800);

        } catch(err) {
            alert('Case Access Error: ' + err.message);
        }
    }

    function renderCaseDashboard(data) {
        document.getElementById('gmLookupCard').style.display = 'none';
        document.getElementById('gmCaseDashboard').style.display = 'block';

        document.getElementById('dashCaseCode').textContent = data.case_code;
        document.getElementById('dashSubject').textContent = data.subject;
        document.getElementById('dashDescription').textContent = data.description;
        document.getElementById('dashCategory').textContent = data.category;

        // Priority
        const prioEl = document.getElementById('dashPriority');
        prioEl.textContent = data.priority;
        prioEl.className = `gm-priority-badge priority-${data.priority}`;

        // Status Pill
        const pill = document.getElementById('dashStatusPill');
        const statusKey = (data.status || 'SUBMITTED').toLowerCase();
        pill.className = `gm-status-pill status-${statusKey}`;
        document.getElementById('dashStatusText').textContent = data.status;

        // Visual Stepper
        const sSubmitted = document.getElementById('stepSubmitted');
        const sReview = document.getElementById('stepReview');
        const sRes = document.getElementById('stepResolution');
        const l1 = document.getElementById('line1');
        const l2 = document.getElementById('line2');

        sSubmitted.classList.add('active');
        if (data.status === 'IN_REVIEW' || data.status === 'CLOSED' || data.status === 'REJECTED') {
            sReview.classList.add('active');
            l1.classList.add('active');
        } else {
            sReview.classList.remove('active');
            l1.classList.remove('active');
        }

        if (data.status === 'CLOSED' || data.status === 'REJECTED') {
            sRes.classList.add('active');
            l2.classList.add('active');
            const resBanner = document.getElementById('dashResolutionBanner');
            resBanner.style.display = 'block';
            document.getElementById('dashResolutionTitle').textContent = (data.status === 'CLOSED') ? 'Case Closed & Resolved:' : 'Case Dismissed / Rejected:';
            document.getElementById('dashResolutionNote').textContent = data.resolution_note || 'Completed by verified investigation staff.';
        } else {
            sRes.classList.remove('active');
            l2.classList.remove('active');
            document.getElementById('dashResolutionBanner').style.display = 'none';
        }

        // Evidence files list
        const evList = document.getElementById('dashEvidenceList');
        if (data.files && data.files.length > 0) {
            document.getElementById('dashEvidenceSection').style.display = 'block';
            evList.innerHTML = data.files.map(f => `
                <div class="gm-evidence-card">
                    <div class="gm-evidence-name">📁 ${escapeHtml(f.name)}</div>
                    <div class="gm-evidence-meta">Size: ${(f.size / 1024).toFixed(1)} KB | SHA-256: ${f.sha256.substring(0, 16)}...</div>
                </div>
            `).join('');
        } else {
            document.getElementById('dashEvidenceSection').style.display = 'none';
        }

        // Messages
        renderMessages(data.messages || []);
    }

    function renderMessages(messages) {
        const container = document.getElementById('gmChatMessages');
        if (!messages || messages.length === 0) {
            container.innerHTML = '<div class="gm-chat-empty"><span>Case registered. Awaiting investigator response.</span></div>';
            return;
        }

        const isScrolledToBottom = container.scrollHeight - container.clientHeight <= container.scrollTop + 40;

        container.innerHTML = messages.map(m => {
            const isAdmin = m.sender_type === 'admin';
            const bubbleClass = isAdmin ? 'bubble-admin' : 'bubble-reporter';
            const senderLabel = isAdmin ? `🛡️ ${escapeHtml(m.sender_name)}` : 'You (Reporter)';
            const timeStr = m.created_at ? m.created_at.substring(11, 16) : '';
            return `
                <div class="gm-chat-bubble ${bubbleClass}">
                    <span class="bubble-sender">${senderLabel}</span>
                    <div class="bubble-content">${escapeHtml(m.message_text)}</div>
                    <span class="bubble-meta">${timeStr}</span>
                </div>
            `;
        }).join('');

        if (isScrolledToBottom) {
            container.scrollTop = container.scrollHeight;
        }
    }

    async function pollCaseUpdates() {
        if (!currentCaseCode || !currentAccessKey) return;
        try {
            const res = await fetch(`${API_BASE}/cases/${encodeURIComponent(currentCaseCode)}?key=${encodeURIComponent(currentAccessKey)}`);
            if (res.ok) {
                const data = await res.json();
                renderCaseDashboard(data);
            }
        } catch(e) {}
    }

    // Send Message from Web
    window.handleSendMessage = async function(e) {
        e.preventDefault();
        const input = document.getElementById('chatInputText');
        const btn = document.getElementById('btnSendChat');
        const text = input.value.trim();
        if (!text || !currentCaseCode || !currentAccessKey) return;

        btn.disabled = true;
        try {
            const res = await fetch(`${API_BASE}/cases/${encodeURIComponent(currentCaseCode)}/messages`, {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: jsonStringifySafe({
                    key: currentAccessKey,
                    message: text
                })
            });

            if (!res.ok) {
                const err = await res.json().catch(() => ({}));
                throw new Error(err.error || 'Failed to deliver message');
            }

            input.value = '';
            pollCaseUpdates();

        } catch(err) {
            alert('Failed to send message: ' + err.message);
        } finally {
            btn.disabled = false;
        }
    };

    window.copyText = function(id) {
        const text = document.getElementById(id).textContent;
        navigator.clipboard.writeText(text).then(() => {
            alert('Copied to clipboard: ' + text);
        }).catch(() => {
            prompt('Copy text manually:', text);
        });
    };

    function checkSavedCase() {
        const urlParams = new URLSearchParams(window.location.search);
        const qCase = urlParams.get('case');
        const qKey = urlParams.get('key');
        if (qCase && qKey) {
            document.getElementById('lookupCaseCode').value = qCase;
            document.getElementById('lookupAccessKey').value = qKey;
            loadCase(qCase, qKey);
            return;
        }

        const savedCode = localStorage.getItem('gm_active_case_code');
        const savedKey = localStorage.getItem('gm_active_access_key');
        if (savedCode && savedKey) {
            document.getElementById('lookupCaseCode').value = savedCode;
            document.getElementById('lookupAccessKey').value = savedKey;
            const badge = document.getElementById('activeCaseBadge');
            if (badge) badge.style.display = 'inline-block';
        }
    }

    function escapeHtml(text) {
        if (!text) return '';
        const div = document.createElement('div');
        div.textContent = text;
        return div.innerHTML;
    }

    function jsonStringifySafe(obj) {
        return JSON.stringify(obj);
    }

    // Auto-check URL or saved case on init
    const params = new URLSearchParams(window.location.search);
    if (params.get('case') || window.location.hash === '#track') {
        switchSupportTab('track');
    } else {
        const savedCode = localStorage.getItem('gm_active_case_code');
        if (savedCode) {
            const badge = document.getElementById('activeCaseBadge');
            if (badge) badge.style.display = 'inline-block';
        }
    }
})();
</script>
