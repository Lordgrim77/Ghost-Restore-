{{!< default}}

<div class="content-area">
    <main class="site-main">

        <section class="gm-support-section">
            <div class="gm-support-container">

                <!-- Support Top Bar & Quick Theme Toggle -->
                <div class="gm-support-top-bar">
                    <span class="gm-section-badge">
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                            <rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect>
                            <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
                        </svg>
                        <span>Encrypted Incident &amp; Support Vault</span>
                    </span>
                    <button type="button" class="gm-support-theme-btn" onclick="toggleSupportTheme()" aria-label="Toggle Color Theme">
                        <span id="gmSupportThemeIcon">🌙</span>
                        <span id="gmSupportThemeText">Dark Mode</span>
                    </button>
                </div>

                <!-- Hero Header -->
                <div class="gm-support-header">
                    <h1 class="gm-support-title">Confidential Support &amp; Incident Intake</h1>
                    <p class="gm-support-desc">
                        Direct, cryptographically secured portal for incident triage, digital evidence submissions, and real-time correspondence with our verified investigative team.
                    </p>
                </div>

                <!-- Dual Navigation Tabs -->
                <div class="gm-support-tabs">
                    <button type="button" class="gm-support-tab active" id="tabBtnSubmit" onclick="switchSupportTab('submit')">
                        <span class="gm-tab-icon">🛡️</span>
                        <span class="gm-tab-text-full">Submit Confidential Report</span>
                        <span class="gm-tab-text-mobile">Submit Report</span>
                    </button>
                    <button type="button" class="gm-support-tab" id="tabBtnTrack" onclick="switchSupportTab('track')">
                        <span class="gm-tab-icon">🔍</span>
                        <span class="gm-tab-text-full">Track Case &amp; Live Chat</span>
                        <span class="gm-tab-text-mobile">Track Case</span>
                        <span class="gm-tab-badge" id="activeCaseBadge" style="display:none;">Saved</span>
                    </button>
                </div>

                <!-- ============================================================= -->
                <!-- TAB 1: NEW CASE SUBMISSION FORM -->
                <!-- ============================================================= -->
                <div class="gm-support-panel active" id="panelSubmit">
                    <form id="gmSupportForm" class="gm-support-form" onsubmit="handleCaseSubmit(event)">
                        
                        <!-- Row 1: Category & Priority -->
                        <div class="gm-form-row gm-form-grid-2">
                            <div class="gm-form-group">
                                <label for="caseCategory" class="gm-form-label">Incident Category <span class="gm-required">*</span></label>
                                <select id="caseCategory" name="category" class="gm-form-select" required>
                                    <option value="Incident &amp; Abuse Report">Incident &amp; Abuse Report</option>
                                    <option value="Predator Grooming &amp; Exploitation">Predator Grooming &amp; Exploitation</option>
                                    <option value="Evidence &amp; Forensic Artifacts">Evidence &amp; Forensic Artifacts</option>
                                    <option value="Threat Intelligence &amp; Infiltration Tip">Threat Intelligence &amp; Infiltration Tip</option>
                                    <option value="Administrative &amp; Support Inquiry">Administrative &amp; Support Inquiry</option>
                                </select>
                            </div>

                            <div class="gm-form-group">
                                <label class="gm-form-label">Triage Priority <span class="gm-required">*</span></label>
                                <div class="gm-priority-selector">
                                    <label class="gm-priority-pill priority-critical">
                                        <input type="radio" name="priority" value="CRITICAL">
                                        <span class="gm-priority-dot"></span>
                                        <span>Critical</span>
                                    </label>
                                    <label class="gm-priority-pill priority-urgent">
                                        <input type="radio" name="priority" value="URGENT">
                                        <span class="gm-priority-dot"></span>
                                        <span>Urgent</span>
                                    </label>
                                    <label class="gm-priority-pill priority-standard active">
                                        <input type="radio" name="priority" value="STANDARD" checked>
                                        <span class="gm-priority-dot"></span>
                                        <span>Standard</span>
                                    </label>
                                    <label class="gm-priority-pill priority-low">
                                        <input type="radio" name="priority" value="LOW">
                                        <span class="gm-priority-dot"></span>
                                        <span>Low</span>
                                    </label>
                                </div>
                            </div>
                        </div>

                        <!-- Subject -->
                        <div class="gm-form-group">
                            <label for="caseSubject" class="gm-form-label">Subject / Incident Summary <span class="gm-required">*</span></label>
                            <input type="text" id="caseSubject" name="subject" class="gm-form-input" placeholder="Concise summary of the situation or incident..." required maxlength="180">
                        </div>

                        <!-- Description Narrative -->
                        <div class="gm-form-group">
                            <label for="caseDescription" class="gm-form-label">Comprehensive Details &amp; Narrative <span class="gm-required">*</span></label>
                            <textarea id="caseDescription" name="description" class="gm-form-textarea" rows="5" placeholder="Provide full context, usernames, platform handles, URLs, timestamps, sequence of events, and specific details..." required></textarea>
                            <span class="gm-form-hint">Do not include your own personal details here if you wish to remain strictly anonymous.</span>
                        </div>

                        <!-- Evidence File Dropzone -->
                        <div class="gm-form-group">
                            <label class="gm-form-label">Digital Evidence &amp; Artifact Attachments</label>
                            <div class="gm-dropzone" id="gmDropzone" onclick="document.getElementById('evidenceFileInput').click()">
                                <input type="file" id="evidenceFileInput" multiple style="display:none;" onchange="handleFileSelect(event)" accept=".jpg,.jpeg,.png,.webp,.pdf,.txt,.log,.mp4,.zip">
                                <div class="gm-dropzone-content">
                                    <div class="gm-dropzone-icon">
                                        <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                            <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
                                            <polyline points="17 8 12 3 7 8"></polyline>
                                            <line x1="12" y1="3" x2="12" y2="15"></line>
                                        </svg>
                                    </div>
                                    <p class="gm-dropzone-title">Click to upload evidence or drag &amp; drop files</p>
                                    <p class="gm-dropzone-sub">Supported: Screenshots, PDFs, Chat Exports, Logs, Media (Max 50MB per batch)</p>
                                </div>
                            </div>
                            <div class="gm-file-list" id="gmFileList" style="display:none;"></div>
                        </div>

                        <!-- Anonymous Reporting Checkbox -->
                        <div class="gm-form-card">
                            <label class="gm-checkbox-label">
                                <input type="checkbox" id="anonToggle" checked onchange="toggleAnonFields(this.checked)">
                                <span class="gm-custom-checkbox"></span>
                                <span class="gm-checkbox-text">
                                    <strong>Remain Strictly Anonymous</strong>
                                    <small>Zero personal identifying information will be associated with this report.</small>
                                </span>
                            </label>

                            <div class="gm-anon-fields" id="anonFields" style="display:none;">
                                <div class="gm-form-row gm-form-grid-2">
                                    <div class="gm-form-group">
                                        <label for="reporterAlias" class="gm-form-label">Pseudonym / Alias</label>
                                        <input type="text" id="reporterAlias" name="reporter_alias" class="gm-form-input" placeholder="e.g. Sentinel_99">
                                    </div>
                                    <div class="gm-form-group">
                                        <label for="reporterContact" class="gm-form-label">Confidential Contact (Optional)</label>
                                        <input type="text" id="reporterContact" name="reporter_contact" class="gm-form-input" placeholder="ProtonMail, SimpleLogin, or Telegram handle">
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- OpSec Guarantees Ribbon -->
                        <div class="gm-opsec-ribbon">
                            <div class="gm-opsec-item">
                                <span class="gm-opsec-icon">🛡️</span>
                                <span><strong>OpSec Scrubbing:</strong> EXIF, GPS, camera, and device metadata automatically stripped.</span>
                            </div>
                            <div class="gm-opsec-item">
                                <span class="gm-opsec-icon">🔒</span>
                                <span><strong>Evidentiary Hashes:</strong> SHA-256 fingerprint generated upon intake.</span>
                            </div>
                            <div class="gm-opsec-item">
                                <span class="gm-opsec-icon">⚡</span>
                                <span><strong>Direct Triage:</strong> Secure alerts dispatched to verified administrators on Telegram.</span>
                            </div>
                        </div>

                        <!-- Submit Button -->
                        <div class="gm-form-actions">
                            <button type="submit" class="gm-submit-case-btn" id="btnSubmitCase">
                                <span class="gm-btn-text">Submit Confidential Report</span>
                                <span class="gm-btn-icon">→</span>
                            </button>
                            <!-- Diagnostic Alert Box -->
                            <div id="caseSubmitAlert" class="gm-submit-alert" style="display:none;"></div>
                        </div>

                    </form>

                    <!-- Success Confirmation Banner (Hidden by default) -->
                    <div class="gm-case-success-card" id="caseSuccessCard" style="display:none;">
                        <div class="gm-success-badge">
                            <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="#10b981" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                                <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path>
                                <polyline points="22 4 12 14.01 9 11.01"></polyline>
                            </svg>
                        </div>
                        <h2 class="gm-success-title">Report Successfully Dispatched</h2>
                        <p class="gm-success-desc">
                            Your submission has been securely ingested, stripped of metadata, and transmitted to duty administrators on Telegram.
                        </p>

                        <div class="gm-credentials-box">
                            <div class="gm-credential-item">
                                <span class="gm-credential-label">CASE REFERENCE CODE</span>
                                <div class="gm-credential-value">
                                    <code id="resCaseCode">---</code>
                                    <button type="button" class="gm-copy-btn" onclick="copyText('resCaseCode')">Copy</button>
                                </div>
                            </div>
                            <div class="gm-credential-item">
                                <span class="gm-credential-label">PRIVATE ACCESS KEY</span>
                                <div class="gm-credential-value">
                                    <code id="resAccessKey">---</code>
                                    <button type="button" class="gm-copy-btn" onclick="copyText('resAccessKey')">Copy</button>
                                </div>
                            </div>
                        </div>

                        <div class="gm-success-warning">
                            <strong>⚠️ Important:</strong> Bookmark this page or save your <strong>Case Reference Code</strong> and <strong>Access Key</strong> now. They are strictly required to track status updates and participate in two-way investigator chat.
                        </div>

                        <div class="gm-success-actions">
                            <button type="button" class="gm-view-case-btn" onclick="openActiveCaseDashboard()">
                                <span>Open Case Dashboard &amp; Live Chat</span> →
                            </button>
                        </div>
                    </div>

                </div>

                <!-- ============================================================= -->
                <!-- TAB 2: CASE TRACKING & BI-DIRECTIONAL LIVE CHAT -->
                <!-- ============================================================= -->
                <div class="gm-support-panel" id="panelTrack">
                    
                    <!-- Case Lookup Card -->
                    <div class="gm-lookup-card" id="gmLookupCard">
                        <h3 class="gm-lookup-title">Access Existing Case</h3>
                        <p class="gm-lookup-sub">Enter your Case Reference Code and Private Access Key to view status dispatches and communicate with investigators.</p>
                        
                        <div class="gm-form-row gm-form-grid-2">
                            <div class="gm-form-group">
                                <label for="lookupCaseCode" class="gm-form-label">Case Reference Code</label>
                                <input type="text" id="lookupCaseCode" class="gm-form-input" placeholder="e.g. CASE-4892-F91A">
                            </div>
                            <div class="gm-form-group">
                                <label for="lookupAccessKey" class="gm-form-label">Private Access Key</label>
                                <input type="text" id="lookupAccessKey" class="gm-form-input" placeholder="32-character secret key">
                            </div>
                        </div>

                        <div class="gm-lookup-actions">
                            <button type="button" class="gm-lookup-btn" onclick="loadCaseFromInputs()">
                                <span>Access Case &amp; Live Chat</span> →
                            </button>
                        </div>
                    </div>

                    <!-- Active Case Dashboard Container (Hidden until case loaded) -->
                    <div class="gm-case-dashboard" id="gmCaseDashboard" style="display:none;">

                        <!-- Case Summary Ribbon -->
                        <div class="gm-case-summary-card">
                            <div class="gm-summary-header">
                                <div>
                                    <span class="gm-case-code-badge" id="dashCaseCode">#CASE-0000</span>
                                    <span class="gm-priority-badge" id="dashPriority">STANDARD</span>
                                </div>
                                <div class="gm-summary-time" id="dashCreatedAt">Submitted: Recently</div>
                            </div>

                            <h3 class="gm-case-subject" id="dashSubject">Case Subject</h3>
                            <p class="gm-case-description" id="dashDescription">Description...</p>

                            <!-- Visual Status Stepper -->
                            <div class="gm-stepper-wrap">
                                <div class="gm-stepper">
                                    <div class="gm-stepper-step active" id="stepSubmitted">
                                        <div class="gm-stepper-circle">1</div>
                                        <div class="gm-stepper-label">Submitted</div>
                                    </div>
                                    <div class="gm-stepper-line" id="line1"></div>
                                    <div class="gm-stepper-step" id="stepReview">
                                        <div class="gm-stepper-circle">2</div>
                                        <div class="gm-stepper-label">In Review</div>
                                    </div>
                                    <div class="gm-stepper-line" id="line2"></div>
                                    <div class="gm-stepper-step" id="stepResolution">
                                        <div class="gm-stepper-circle">3</div>
                                        <div class="gm-stepper-label" id="stepResolutionLabel">Resolution</div>
                                    </div>
                                </div>
                            </div>

                            <!-- Attached Evidence Files -->
                            <div class="gm-dash-evidence" id="dashEvidenceSection" style="display:none;">
                                <h4 class="gm-dash-subhead">📁 Attached Evidence Files (Metadata Scrubbed)</h4>
                                <div class="gm-evidence-list" id="dashEvidenceList"></div>
                            </div>
                        </div>

                        <!-- Two-Way Live Chat Stream -->
                        <div class="gm-chat-card">
                            <div class="gm-chat-header">
                                <div class="gm-chat-title-group">
                                    <span class="gm-live-dot"></span>
                                    <span class="gm-chat-title">Confidential Case Stream</span>
                                </div>
                                <span class="gm-chat-status" id="dashChatStatus">Connected to Duty Investigator</span>
                            </div>

                            <div class="gm-chat-messages" id="gmChatMessages">
                                <div class="gm-chat-empty" id="chatEmptyPlaceholder">
                                    💬 No messages yet. You can submit updates or additional context below.
                                </div>
                            </div>

                            <!-- Composer -->
                            <form class="gm-chat-composer" onsubmit="handleSendMessage(event)">
                                <input type="text" id="chatMessageInput" class="gm-chat-input" placeholder="Type a message or provide additional evidence context..." required autocomplete="off">
                                <button type="submit" class="gm-chat-send-btn" id="btnSendChat">
                                    <span>Send</span>
                                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                                        <line x1="22" y1="2" x2="11" y2="13"></line>
                                        <polygon points="22 2 15 22 11 13 2 9 22 2"></polygon>
                                    </svg>
                                </button>
                            </form>
                        </div>

                    </div>

                </div>

            </div>
        </section>

    </main>
</div>

<!-- ============================================================= -->
<!-- Comprehensive Responsive Theme Styles -->
<!-- ============================================================= -->
<style>
/* 1. COMPLETELY HIDE THE FALLING MATRIX / CYBER HEX CANVAS ON SUPPORT PORTAL */
#gm-cyber-hex-canvas {
    display: none !important;
}

/* 2. Container & Layout */
.gm-support-section {
    padding: 24px 20px 80px;
    max-width: 960px;
    margin: 0 auto;
    width: 100%;
}
.gm-support-top-bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    margin-bottom: 20px;
}
.gm-section-badge {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 6px 14px;
    border-radius: 999px;
    font-size: 12px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    border: 1px solid rgba(255, 255, 255, 0.14);
    background: rgba(255, 255, 255, 0.05);
    color: #38bdf8;
}
html.light-mode .gm-section-badge {
    border-color: rgba(0, 0, 0, 0.12);
    background: #e0f2fe;
    color: #0369a1;
}

/* Dedicated Page Theme Toggle Button */
.gm-support-theme-btn {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 6px 14px;
    border-radius: 999px;
    font-size: 13px;
    font-weight: 700;
    cursor: pointer;
    border: 1px solid rgba(255, 255, 255, 0.2);
    background: rgba(255, 255, 255, 0.08);
    color: #ffffff !important;
    transition: all 0.2s ease;
}
.gm-support-theme-btn:hover {
    background: rgba(255, 255, 255, 0.15);
    transform: translateY(-1px);
}
html.light-mode .gm-support-theme-btn {
    border-color: rgba(0, 0, 0, 0.15);
    background: #f1f5f9;
    color: #0f172a !important;
}
html.light-mode .gm-support-theme-btn:hover {
    background: #e2e8f0;
}

/* Hero Header */
.gm-support-header {
    text-align: center;
    margin-bottom: 24px;
}
.gm-support-title {
    font-size: 32px;
    font-weight: 900;
    letter-spacing: -0.03em;
    margin: 0 0 10px;
    line-height: 1.2;
    color: #ffffff;
}
html.light-mode .gm-support-title {
    color: #090b10;
}
.gm-support-desc {
    font-size: 15px;
    color: #94a3b8;
    max-width: 680px;
    margin: 0 auto;
    line-height: 1.5;
}
html.light-mode .gm-support-desc {
    color: #64748b;
}

/* Tabs */
.gm-support-tabs {
    display: flex;
    gap: 12px;
    margin-bottom: 24px;
    background: rgba(255, 255, 255, 0.04);
    padding: 6px;
    border-radius: 999px;
    border: 1px solid rgba(255, 255, 255, 0.1);
}
html.light-mode .gm-support-tabs {
    background: #f1f5f9;
    border-color: rgba(0, 0, 0, 0.08);
}
.gm-support-tab {
    flex: 1;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    padding: 12px 18px;
    font-size: 14px;
    font-weight: 700;
    border-radius: 999px;
    cursor: pointer;
    border: none;
    transition: all 0.2s ease;
    white-space: nowrap;
    min-width: 0;
}
html.dark-mode .gm-support-tab {
    background: transparent;
    color: #94a3b8;
}
html.dark-mode .gm-support-tab.active {
    background: #ffffff;
    color: #040609 !important;
    box-shadow: 0 4px 14px rgba(0, 0, 0, 0.4);
}
html.dark-mode .gm-support-tab.active span {
    color: #040609 !important;
}
html.light-mode .gm-support-tab {
    background: transparent;
    color: #64748b;
}
html.light-mode .gm-support-tab.active {
    background: #090b10;
    color: #ffffff !important;
    box-shadow: 0 4px 14px rgba(0, 0, 0, 0.15);
}
html.light-mode .gm-support-tab.active span {
    color: #ffffff !important;
}
.gm-tab-badge {
    background: #10b981;
    color: #ffffff;
    font-size: 10px;
    font-weight: 800;
    padding: 2px 7px;
    border-radius: 999px;
    text-transform: uppercase;
}

/* Panels */
.gm-support-panel {
    display: none;
}
.gm-support-panel.active {
    display: block;
}

/* Form Container */
.gm-support-form {
    background: #0d1117;
    border: 1px solid #30363d;
    border-radius: 16px;
    padding: 28px;
    box-shadow: 0 8px 32px rgba(0, 0, 0, 0.4);
}
html.light-mode .gm-support-form {
    background: #ffffff;
    border-color: #d0d7de;
    box-shadow: 0 8px 32px rgba(0, 0, 0, 0.06);
}
.gm-form-group {
    margin-bottom: 20px;
}
.gm-form-label {
    display: block;
    font-size: 13px;
    font-weight: 700;
    margin-bottom: 8px;
    color: #f0f6fc;
}
html.light-mode .gm-form-label {
    color: #0f172a;
}
.gm-required {
    color: #e11d48;
}
.gm-form-hint {
    display: block;
    font-size: 12px;
    color: #8b949e;
    margin-top: 6px;
}
html.light-mode .gm-form-hint {
    color: #64748b;
}

/* Inputs, Textarea, Select */
.gm-form-input,
.gm-form-select,
.gm-form-textarea {
    width: 100%;
    padding: 12px 16px;
    font-size: 14px;
    border-radius: 10px;
    transition: all 0.2s ease;
    box-sizing: border-box;
    font-family: inherit;
}
html.dark-mode .gm-form-input,
html.dark-mode .gm-form-select,
html.dark-mode .gm-form-textarea {
    background: #161b22;
    border: 1px solid #30363d;
    color: #f0f6fc;
}
html.dark-mode .gm-form-input:focus,
html.dark-mode .gm-form-select:focus,
html.dark-mode .gm-form-textarea:focus {
    border-color: #58a6ff;
    outline: none;
    box-shadow: 0 0 0 3px rgba(56, 189, 248, 0.2);
}
html.light-mode .gm-form-input,
html.light-mode .gm-form-select,
html.light-mode .gm-form-textarea {
    background: #f8fafc;
    border: 1px solid #cbd5e1;
    color: #0f172a;
}
html.light-mode .gm-form-input:focus,
html.light-mode .gm-form-select:focus,
html.light-mode .gm-form-textarea:focus {
    border-color: #090b10;
    outline: none;
    box-shadow: 0 0 0 3px rgba(0, 0, 0, 0.1);
}
.gm-form-grid-2 {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 16px;
}
@media (max-width: 640px) {
    .gm-form-grid-2 { grid-template-columns: 1fr; }
}

/* Priority Selector Pills */
.gm-priority-selector {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 8px;
}
@media (max-width: 480px) {
    .gm-priority-selector { grid-template-columns: 1fr 1fr; }
}
.gm-priority-pill {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 6px;
    padding: 10px 8px;
    font-size: 13px;
    font-weight: 700;
    border-radius: 8px;
    cursor: pointer;
    border: 1px solid transparent;
    transition: all 0.2s ease;
}
.gm-priority-pill input { display: none; }
.gm-priority-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
}
.priority-critical .gm-priority-dot { background: #e11d48; }
.priority-urgent .gm-priority-dot { background: #f97316; }
.priority-standard .gm-priority-dot { background: #eab308; }
.priority-low .gm-priority-dot { background: #64748b; }

html.dark-mode .gm-priority-pill {
    background: #161b22;
    border-color: #30363d;
    color: #8b949e;
}
html.dark-mode .gm-priority-pill.active,
html.dark-mode .gm-priority-pill:has(input:checked) {
    background: #21262d;
    border-color: #ffffff;
    color: #ffffff;
}
html.light-mode .gm-priority-pill {
    background: #f1f5f9;
    border-color: #e2e8f0;
    color: #64748b;
}
html.light-mode .gm-priority-pill.active,
html.light-mode .gm-priority-pill:has(input:checked) {
    background: #ffffff;
    border-color: #090b10;
