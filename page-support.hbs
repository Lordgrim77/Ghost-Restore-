}
html.light-mode .gm-copy-link-btn {
    background: #f1f5f9;
    color: #0f172a;
    border-color: #cbd5e1;
}
.gm-view-case-btn {
    background: #10b981;
    color: #ffffff;
}

/* ============================================================= */
