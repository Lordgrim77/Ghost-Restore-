    justify-content: center;
    gap: 12px;
    flex-wrap: wrap;
}
.gm-copy-link-btn, .gm-view-case-btn {
    padding: 12px 20px;
    border-radius: 999px;
    font-size: 13px;
    font-weight: 700;
    cursor: pointer;
    border: none;
