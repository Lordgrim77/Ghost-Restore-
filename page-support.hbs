}

/* Loading & Empty States */
.gm-cases-loading {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 12px;
    padding: 40px 16px;
    color: #8b949e;
    font-size: 14px;
}
.gm-spinner {
    width: 18px;
    height: 18px;
    border: 2px solid rgba(255, 255, 255, 0.2);
    border-top-color: #38bdf8;
    border-radius: 50%;
    animation: gmSpin 0.7s linear infinite;
}
html.light-mode .gm-spinner {
    border-color: rgba(0, 0, 0, 0.15);
    border-top-color: #0284c7;
}
@keyframes gmSpin {
    to { transform: rotate(360deg); }
}

.gm-cases-empty {
    text-align: center;
    padding: 48px 16px;
}
.gm-empty-icon {
    font-size: 40px;
    margin-bottom: 12px;
}
.gm-empty-title {
    font-size: 18px;
    font-weight: 800;
    margin: 0 0 6px;
    color: #f0f6fc;
}
html.light-mode .gm-empty-title {
    color: #0f172a;
}
.gm-empty-desc {
    font-size: 13px;
    color: #8b949e;
    max-width: 440px;
    margin: 0 auto 18px;
    line-height: 1.5;
}
html.light-mode .gm-empty-desc {
    color: #64748b;
}
.gm-empty-cta {
    background-color: #ffffff !important;
    color: #040609 !important;
    font-size: 13px;
    font-weight: 700;
    padding: 10px 20px;
    border-radius: 999px;
    border: 1px solid #ffffff !important;
    cursor: pointer;
    transition: all 0.2s ease;
}
.gm-empty-cta *,
.gm-empty-cta span {
    color: #040609 !important;
}
.gm-empty-cta:hover {
    background-color: #e2e8f0 !important;
    border-color: #e2e8f0 !important;
}
.gm-empty-cta:hover *,
.gm-empty-cta:hover span {
    color: #040609 !important;
}

html.light-mode .gm-empty-cta {
    background-color: #0f172a !important;
    color: #ffffff !important;
    border: 1px solid #0f172a !important;
}
html.light-mode .gm-empty-cta *,
html.light-mode .gm-empty-cta span {
    color: #ffffff !important;
}
html.light-mode .gm-empty-cta:hover {
    background-color: #1e293b !important;
    border-color: #1e293b !important;
}
html.light-mode .gm-empty-cta:hover *,
html.light-mode .gm-empty-cta:hover span {
    color: #ffffff !important;
}

/* Cases Card List */
.gm-cases-list {
    display: flex;
    flex-direction: column;
    gap: 12px;
}
.gm-case-card-item {
    background: #161b22;
    border: 1px solid #30363d;
    border-radius: 12px;
    padding: 18px;
    transition: all 0.2s ease;
}
html.light-mode .gm-case-card-item {
    background: #f8fafc;
    border-color: #e2e8f0;
}
.gm-case-card-item:hover {
    border-color: #58a6ff;
    transform: translateY(-1px);
    box-shadow: 0 4px 16px rgba(0, 0, 0, 0.25);
}
html.light-mode .gm-case-card-item:hover {
    border-color: #0284c7;
    box-shadow: 0 4px 16px rgba(0, 0, 0, 0.06);
}
.gm-case-card-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 10px;
    margin-bottom: 10px;
    flex-wrap: wrap;
}
.gm-case-card-meta {
    display: flex;
    align-items: center;
    gap: 8px;
    flex-wrap: wrap;
}
.gm-case-code-pill {
    background: rgba(56, 189, 248, 0.12);
    color: #38bdf8;
    border: 1px solid rgba(56, 189, 248, 0.3);
