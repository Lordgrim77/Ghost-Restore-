}
.gm-open-case-btn:hover *,
.gm-open-case-btn:hover span {
    color: #040609 !important;
}

html.light-mode .gm-open-case-btn {
    background-color: #0f172a !important;
    color: #ffffff !important;
    border: 1px solid #0f172a !important;
}
html.light-mode .gm-open-case-btn *,
html.light-mode .gm-open-case-btn span {
    color: #ffffff !important;
}
