{{!< default}}

<div class="content-area">
    <main class="site-main">

        <section class="gm-support-section">
            <div class="gm-support-container">

                <!-- Header / Hero -->
                <div class="gm-support-header">
                    <span class="gm-section-badge">Verified Communications & Evidence Vault</span>
                    <h1 class="gm-support-title">Confidential Support & Incident Intake</h1>
                    <p class="gm-support-desc">
                        Direct, cryptographically secured portal for incident triage, digital evidence submissions, and real-time correspondence with our verified investigative team.
                    </p>
                </div>

                <!-- Navigation Tabs -->
                <div class="gm-support-tabs">
                    <button type="button" class="gm-support-tab active" id="tabBtnSubmit" onclick="switchSupportTab('submit')">
                        <span class="gm-tab-icon">🛡️</span>
                        <span>Submit New Report</span>
                    </button>
                    <button type="button" class="gm-support-tab" id="tabBtnTrack" onclick="switchSupportTab('track')">
                        <span class="gm-tab-icon">🔍</span>
                        <span>Track Case &amp; Live Chat</span>
                        <span class="gm-tab-badge" id="activeCaseBadge" style="display:none;">Active</span>
                    </button>
                </div>

                <!-- ============================================================= -->
                <!-- TAB 1: NEW CASE SUBMISSION FORM -->
                <!-- ============================================================= -->
                <div class="gm-support-panel active" id="panelSubmit">
                    <form id="gmSupportForm" class="gm-support-form" onsubmit="handleCaseSubmit(event)">
                        
                        <!-- Row 1: Category & Priority -->
                        <div class="gm-form-row gm-form-grid-2">
                            <div class="gm-form-group">
                                <label for="caseCategory" class="gm-form-label">Incident Category <span class="gm-required">*</span></label>
                                <select id="caseCategory" name="category" class="gm-form-select" required>
                                    <option value="Incident &amp; Abuse Report">Incident &amp; Abuse Report</option>
                                    <option value="Predator Grooming &amp; Exploitation">Predator Grooming &amp; Exploitation</option>
                                    <option value="Evidence &amp; Forensic Artifacts">Evidence &amp; Forensic Artifacts</option>
                                    <option value="Threat Intelligence &amp; Infiltration Tip">Threat Intelligence &amp; Infiltration Tip</option>
                                    <option value="Administrative &amp; Support Inquiry">Administrative &amp; Support Inquiry</option>
                                </select>
                            </div>

                            <div class="gm-form-group">
                                <label class="gm-form-label">Triage Priority <span class="gm-required">*</span></label>
                                <div class="gm-priority-selector">
                                    <label class="gm-priority-pill priority-critical">
                                        <input type="radio" name="priority" value="CRITICAL">
                                        <span class="gm-priority-indicator"></span>
                                        <span>Critical</span>
                                    </label>
                                    <label class="gm-priority-pill priority-urgent">
                                        <input type="radio" name="priority" value="URGENT">
                                        <span class="gm-priority-indicator"></span>
                                        <span>Urgent</span>
                                    </label>
                                    <label class="gm-priority-pill priority-standard active">
                                        <input type="radio" name="priority" value="STANDARD" checked>
                                        <span class="gm-priority-indicator"></span>
                                        <span>Standard</span>
                                    </label>
                                    <label class="gm-priority-pill priority-low">
                                        <input type="radio" name="priority" value="LOW">
                                        <span class="gm-priority-indicator"></span>
                                        <span>Low</span>
                                    </label>
                                </div>
                            </div>
                        </div>

                        <!-- Subject -->
                        <div class="gm-form-group">
                            <label for="caseSubject" class="gm-form-label">Subject / Incident Summary <span class="gm-required">*</span></label>
                            <input type="text" id="caseSubject" name="subject" class="gm-form-input" placeholder="Concise summary of the situation or evidence..." required maxlength="180">
                        </div>

                        <!-- Description Narrative -->
                        <div class="gm-form-group">
                            <label for="caseDescription" class="gm-form-label">Comprehensive Details &amp; Narrative <span class="gm-required">*</span></label>
                            <textarea id="caseDescription" name="description" class="gm-form-textarea" rows="6" placeholder="Provide full context, handles, platform URLs, timestamps, sequence of events, and specific details..." required></textarea>
                            <span class="gm-form-hint">Do not include your own personal information here if you wish to remain strictly anonymous.</span>
                        </div>

                        <!-- Evidence File Dropzone -->
                        <div class="gm-form-group">
                            <label class="gm-form-label">Digital Evidence &amp; Artifact Attachments</label>
                            <div class="gm-dropzone" id="gmDropzone" onclick="document.getElementById('evidenceFileInput').click()">
                                <input type="file" id="evidenceFileInput" multiple style="display:none;" onchange="handleFileSelect(event)" accept=".jpg,.jpeg,.png,.webp,.pdf,.txt,.log,.mp4,.zip">
                                <div class="gm-dropzone-content">
                                    <div class="gm-dropzone-icon">
                                        <svg width="36" height="36" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                            <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
                                            <polyline points="17 8 12 3 7 8"></polyline>
                                            <line x1="12" y1="3" x2="12" y2="15"></line>
                                        </svg>
                                    </div>
                                    <p class="gm-dropzone-title">Click to upload evidence or drag &amp; drop files</p>
                                    <p class="gm-dropzone-sub">Supported: Screenshots, PDFs, Chat Exports, Logs, Media (Max 50MB per file)</p>
                                </div>
                            </div>

                            <!-- Selected Files List -->
                            <div class="gm-file-list" id="gmFileList" style="display:none;"></div>
                        </div>

                        <!-- Reporter Identity & OpSec Option -->
                        <div class="gm-form-card">
                            <div class="gm-checkbox-row">
                                <label class="gm-checkbox-label">
                                    <input type="checkbox" id="anonToggle" checked onchange="toggleAnonFields(this.checked)">
                                    <span class="gm-custom-checkbox"></span>
                                    <span class="gm-checkbox-text">
                                        <strong>Submit Anonymously (Zero Personal Identifying Information)</strong>
                                        <small>A private cryptographic Case ID and Access Key will be generated so you can track progress and chat without an account.</small>
                                    </span>
                                </label>
                            </div>

                            <div class="gm-anon-fields" id="anonFields" style="display:none;">
                                <div class="gm-form-row gm-form-grid-2">
                                    <div class="gm-form-group">
                                        <label for="reporterAlias" class="gm-form-label">Contact Alias (Optional)</label>
                                        <input type="text" id="reporterAlias" name="reporter_alias" class="gm-form-input" placeholder="e.g. Whistleblower_01">
                                    </div>
                                    <div class="gm-form-group">
                                        <label for="reporterContact" class="gm-form-label">External Contact (Optional)</label>
                                        <input type="text" id="reporterContact" name="reporter_contact" class="gm-form-input" placeholder="Telegram handle or secure email">
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- OpSec Security Assurances -->
                        <div class="gm-opsec-badges">
                            <div class="gm-opsec-item">
                                <span class="gm-opsec-icon">🛡️</span>
                                <span><strong>EXIF/GPS Purged:</strong> Metadata automatically scrubbed from media.</span>
                            </div>
                            <div class="gm-opsec-item">
                                <span class="gm-opsec-icon">🔒</span>
                                <span><strong>Evidentiary Hashes:</strong> SHA-256 fingerprint generated upon intake.</span>
                            </div>
                            <div class="gm-opsec-item">
                                <span class="gm-opsec-icon">⚡</span>
                                <span><strong>Direct Triage:</strong> Secure alerts dispatched to verified administrators.</span>
                            </div>
                        </div>

                        <!-- Submit Button -->
                        <div class="gm-form-actions">
                            <button type="submit" class="gm-submit-case-btn" id="btnSubmitCase">
                                <span class="gm-btn-text">Submit Confidential Report</span>
                                <span class="gm-btn-icon">→</span>
                            </button>
                        </div>

                    </form>

                    <!-- Success Confirmation Banner (Hidden by default) -->
                    <div class="gm-case-success-card" id="caseSuccessCard" style="display:none;">
                        <div class="gm-success-badge">
                            <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="#10b981" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                                <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path>
                                <polyline points="22 4 12 14.01 9 11.01"></polyline>
                            </svg>
                        </div>
                        <h2 class="gm-success-title">Report Successfully Dispatched</h2>
                        <p class="gm-success-desc">
                            Your submission has been securely ingested, stripped of metadata, and transmitted to duty administrators on Telegram.
                        </p>

                        <div class="gm-credentials-box">
                            <div class="gm-credential-item">
                                <span class="gm-credential-label">CASE REFERENCE CODE</span>
                                <div class="gm-credential-val-row">
                                    <code class="gm-credential-code" id="resCaseCode">CASE-XXXX-XXXX</code>
                                    <button type="button" class="gm-copy-btn" onclick="copyText('resCaseCode')">Copy</button>
                                </div>
                            </div>
                            <div class="gm-credential-item">
                                <span class="gm-credential-label">PRIVATE ACCESS KEY</span>
                                <div class="gm-credential-val-row">
                                    <code class="gm-credential-code" id="resAccessKey">xxxxxxxxxxxxxxxx</code>
                                    <button type="button" class="gm-copy-btn" onclick="copyText('resAccessKey')">Copy</button>
                                </div>
                            </div>
                        </div>

                        <div class="gm-success-warning">
                            <strong>⚠️ Important:</strong> Bookmark this page or save your <strong>Case Reference Code</strong> and <strong>Access Key</strong> now. They are strictly required to track status updates and participate in two-way investigator chat.
                        </div>

                        <div class="gm-success-actions">
                            <button type="button" class="gm-view-case-btn" onclick="openActiveCaseDashboard()">
                                <span>Open Case Dashboard &amp; Live Chat</span> →
                            </button>
                        </div>
                    </div>

                </div>

                <!-- ============================================================= -->
                <!-- TAB 2: CASE TRACKING & BI-DIRECTIONAL LIVE CHAT -->
                <!-- ============================================================= -->
                <div class="gm-support-panel" id="panelTrack">

                    <!-- Case Credentials Lookup Box -->
                    <div class="gm-lookup-card" id="gmLookupCard">
                        <h3 class="gm-lookup-title">Access Existing Case</h3>
                        <p class="gm-lookup-sub">Enter your Case Reference Code and Private Access Key to view status dispatches and communicate with investigators.</p>
                        
                        <div class="gm-form-row gm-form-grid-2">
                            <div class="gm-form-group">
                                <label for="lookupCaseCode" class="gm-form-label">Case Reference Code</label>
                                <input type="text" id="lookupCaseCode" class="gm-form-input" placeholder="e.g. CASE-4892-F91A">
                            </div>
                            <div class="gm-form-group">
                                <label for="lookupAccessKey" class="gm-form-label">Private Access Key</label>
                                <input type="text" id="lookupAccessKey" class="gm-form-input" placeholder="32-character secret key">
                            </div>
                        </div>

                        <div class="gm-lookup-actions">
                            <button type="button" class="gm-lookup-btn" onclick="loadCaseFromInputs()">
                                <span>Access Case</span> →
                            </button>
                        </div>
                    </div>

                    <!-- Active Case Dashboard Container (Hidden until case loaded) -->
                    <div class="gm-case-dashboard" id="gmCaseDashboard" style="display:none;">

                        <!-- Case Summary Ribbon -->
                        <div class="gm-case-summary-card">
                            <div class="gm-case-top-row">
                                <div class="gm-case-title-wrap">
                                    <span class="gm-case-code-badge" id="dashCaseCode">CASE-XXXX-XXXX</span>
                                    <span class="gm-priority-badge" id="dashPriority">STANDARD</span>
                                    <span class="gm-category-badge" id="dashCategory">Incident Report</span>
                                </div>
                                <div class="gm-case-status-wrap">
                                    <div class="gm-status-pill status-submitted" id="dashStatusPill">
                                        <span class="gm-status-dot"></span>
                                        <span id="dashStatusText">SUBMITTED</span>
                                    </div>
                                </div>
                            </div>

                            <h2 class="gm-case-subject" id="dashSubject">Case Subject</h2>
                            <p class="gm-case-description" id="dashDescription">Case details...</p>

                            <!-- Visual Status Progress Stepper -->
                            <div class="gm-status-stepper">
                                <div class="gm-stepper-step step-submitted active" id="stepSubmitted">
                                    <div class="gm-stepper-circle">1</div>
                                    <div class="gm-stepper-label">Submitted</div>
                                </div>
                                <div class="gm-stepper-line" id="line1"></div>
                                <div class="gm-stepper-step step-review" id="stepReview">
                                    <div class="gm-stepper-circle">2</div>
                                    <div class="gm-stepper-label">In Review</div>
                                </div>
                                <div class="gm-stepper-line" id="line2"></div>
                                <div class="gm-stepper-step step-resolution" id="stepResolution">
                                    <div class="gm-stepper-circle">3</div>
                                    <div class="gm-stepper-label">Resolution</div>
                                </div>
                            </div>

                            <!-- Resolution Notice Banner (if closed/rejected) -->
                            <div class="gm-resolution-banner" id="dashResolutionBanner" style="display:none;">
                                <strong id="dashResolutionTitle">Case Closed:</strong>
                                <span id="dashResolutionNote">Resolved by investigation team.</span>
                            </div>

                            <!-- Evidence Files Summary -->
                            <div class="gm-case-evidence-section" id="dashEvidenceSection">
                                <h4 class="gm-evidence-title">Verified Evidence Attachments</h4>
                                <div class="gm-evidence-grid" id="dashEvidenceList"></div>
                            </div>
                        </div>

                        <!-- Bi-Directional Live Chat Container -->
                        <div class="gm-chat-card">
                            <div class="gm-chat-header">
                                <div class="gm-chat-header-left">
                                    <span class="gm-chat-indicator"></span>
                                    <h3 class="gm-chat-title">Investigator Correspondence</h3>
                                </div>
                                <span class="gm-chat-sync-text">Live Sync with Telegram Hub</span>
                            </div>

                            <!-- Chat Message Stream -->
                            <div class="gm-chat-messages" id="gmChatMessages">
                                <div class="gm-chat-empty" id="chatEmptyState">
                                    <span>Case registered. Awaiting initial investigator response.</span>
                                </div>
                            </div>

                            <!-- Chat Message Composer -->
                            <form class="gm-chat-composer" id="gmChatComposer" onsubmit="handleSendMessage(event)">
                                <input type="text" id="chatInputText" class="gm-chat-input" placeholder="Type a message or follow-up evidence to investigators..." autocomplete="off" required>
                                <button type="submit" class="gm-chat-send-btn" id="btnSendChat">
                                    <span>Send</span>
                                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                        <line x1="22" y1="2" x2="11" y2="13"></line>
                                        <polygon points="22 2 15 22 11 13 2 9 22 2"></polygon>
                                    </svg>
                                </button>
                            </form>
                        </div>

                    </div>

                </div>

            </div>
        </section>

    </main>
</div>

<!-- Support Portal Styles -->
<style>
.gm-support-section {
    padding: 48px 24px 80px;
    max-width: 1040px;
    margin: 0 auto;
    width: 100%;
}
.gm-support-header {
    text-align: center;
    margin-bottom: 36px;
}
.gm-section-badge {
    display: inline-block;
    padding: 4px 14px;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    border-radius: 999px;
    margin-bottom: 14px;
}
html.dark-mode .gm-section-badge {
    background: rgba(255, 255, 255, 0.08);
    color: #cbd5e1;
    border: 1px solid rgba(255, 255, 255, 0.14);
}
html.light-mode .gm-section-badge {
    background: #f1f5f9;
    color: #475569;
    border: 1px solid rgba(0, 0, 0, 0.08);
}
.gm-support-title {
    font-size: clamp(28px, 4vw, 42px);
    font-weight: 800;
    letter-spacing: -0.03em;
    margin-bottom: 12px;
}
.gm-support-desc {
    max-width: 640px;
    margin: 0 auto;
    font-size: 16px;
    line-height: 1.6;
    color: #94a3b8;
}
html.light-mode .gm-support-desc { color: #64748b; }

/* Tabs */
.gm-support-tabs {
    display: flex;
    justify-content: center;
    gap: 12px;
    margin-bottom: 32px;
}
.gm-support-tab {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 12px 24px;
    font-size: 14px;
    font-weight: 700;
    border-radius: 999px;
    cursor: pointer;
    transition: all 0.2s cubic-bezier(0.16, 1, 0.3, 1);
    border: 1px solid transparent;
}
html.dark-mode .gm-support-tab {
    background: rgba(255, 255, 255, 0.05);
    color: #94a3b8;
    border-color: rgba(255, 255, 255, 0.1);
}
html.dark-mode .gm-support-tab.active,
html.dark-mode .gm-support-tab:hover {
    background: #ffffff;
    color: #040609;
    border-color: #ffffff;
}
html.light-mode .gm-support-tab {
    background: #f1f5f9;
    color: #64748b;
    border-color: rgba(0, 0, 0, 0.08);
}
html.light-mode .gm-support-tab.active,
html.light-mode .gm-support-tab:hover {
    background: #090b10;
    color: #ffffff;
    border-color: #090b10;
}
.gm-tab-badge {
    background: #10b981;
    color: #ffffff;
    font-size: 10px;
    font-weight: 800;
    padding: 2px 7px;
    border-radius: 999px;
    text-transform: uppercase;
}

/* Panels */
.gm-support-panel { display: none; }
.gm-support-panel.active { display: block; animation: gmFadeIn 0.25s ease; }
@keyframes gmFadeIn { from { opacity: 0; transform: translateY(6px); } to { opacity: 1; transform: translateY(0); } }

/* Form Elements */
.gm-support-form {
    background: rgba(255, 255, 255, 0.02);
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 20px;
    padding: 32px;
}
html.light-mode .gm-support-form {
    background: #ffffff;
    border-color: rgba(0, 0, 0, 0.1);
    box-shadow: 0 12px 36px rgba(0, 0, 0, 0.05);
}
.gm-form-group { margin-bottom: 24px; }
.gm-form-label {
    display: block;
    font-size: 13px;
    font-weight: 700;
    letter-spacing: -0.01em;
    margin-bottom: 8px;
}
.gm-required { color: #e11d48; }
.gm-form-hint {
    display: block;
    font-size: 12px;
    color: #64748b;
    margin-top: 6px;
}
.gm-form-input, .gm-form-select, .gm-form-textarea {
    width: 100%;
    padding: 12px 16px;
    font-size: 14px;
    border-radius: 10px;
    transition: all 0.2s ease;
    box-sizing: border-box;
    font-family: inherit;
}
html.dark-mode .gm-form-input,
html.dark-mode .gm-form-select,
html.dark-mode .gm-form-textarea {
    background: rgba(0, 0, 0, 0.45);
    border: 1px solid rgba(255, 255, 255, 0.14);
    color: #f8fafc;
}
html.dark-mode .gm-form-input:focus,
html.dark-mode .gm-form-select:focus,
html.dark-mode .gm-form-textarea:focus {
    border-color: #ffffff;
    outline: none;
    box-shadow: 0 0 0 2px rgba(255, 255, 255, 0.15);
}
html.light-mode .gm-form-input,
html.light-mode .gm-form-select,
html.light-mode .gm-form-textarea {
    background: #f8fafc;
    border: 1px solid rgba(0, 0, 0, 0.14);
    color: #0f172a;
}
html.light-mode .gm-form-input:focus,
html.light-mode .gm-form-select:focus,
html.light-mode .gm-form-textarea:focus {
    border-color: #000000;
    outline: none;
    box-shadow: 0 0 0 2px rgba(0, 0, 0, 0.1);
}
.gm-form-grid-2 {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 20px;
}
@media (max-width: 680px) {
    .gm-form-grid-2 { grid-template-columns: 1fr; }
}

/* Priority Selector Pills */
.gm-priority-selector {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 8px;
}
@media (max-width: 480px) {
    .gm-priority-selector { grid-template-columns: 1fr 1fr; }
}
.gm-priority-pill {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 6px;
    padding: 10px 8px;
    font-size: 12px;
    font-weight: 700;
    border-radius: 8px;
    cursor: pointer;
    border: 1px solid transparent;
    transition: all 0.2s ease;
}
.gm-priority-pill input { display: none; }
.gm-priority-indicator {
    width: 8px;
    height: 8px;
    border-radius: 50%;
}
.priority-critical .gm-priority-indicator { background: #e11d48; }
.priority-urgent .gm-priority-indicator { background: #f97316; }
.priority-standard .gm-priority-indicator { background: #eab308; }
.priority-low .gm-priority-indicator { background: #64748b; }

html.dark-mode .gm-priority-pill {
    background: rgba(255, 255, 255, 0.04);
    border-color: rgba(255, 255, 255, 0.08);
    color: #94a3b8;
}
html.dark-mode .gm-priority-pill:has(input:checked) {
    background: rgba(255, 255, 255, 0.12);
    border-color: #ffffff;
    color: #ffffff;
}
html.light-mode .gm-priority-pill {
    background: #f1f5f9;
    border-color: rgba(0, 0, 0, 0.06);
    color: #64748b;
}
html.light-mode .gm-priority-pill:has(input:checked) {
    background: #ffffff;
    border-color: #000000;
    color: #000000;
    box-shadow: 0 2px 8px rgba(0,0,0,0.06);
}

/* Dropzone */
.gm-dropzone {
    border: 2px dashed rgba(255, 255, 255, 0.18);
    border-radius: 14px;
    padding: 32px 20px;
    text-align: center;
    cursor: pointer;
    transition: all 0.2s ease;
    background: rgba(255, 255, 255, 0.015);
}
html.light-mode .gm-dropzone {
    border-color: rgba(0, 0, 0, 0.18);
    background: #f8fafc;
}
.gm-dropzone:hover {
    border-color: #10b981;
    background: rgba(16, 185, 129, 0.04);
}
.gm-dropzone-icon {
    margin-bottom: 10px;
    color: #10b981;
}
.gm-dropzone-title {
    font-size: 14px;
    font-weight: 700;
    margin-bottom: 4px;
}
.gm-dropzone-sub {
    font-size: 12px;
    color: #94a3b8;
    margin: 0;
}

/* File list */
.gm-file-list {
    margin-top: 14px;
    display: flex;
    flex-direction: column;
    gap: 8px;
}
.gm-file-item {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 10px 14px;
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 8px;
    font-size: 13px;
}
html.light-mode .gm-file-item {
    background: #f1f5f9;
    border-color: rgba(0, 0, 0, 0.08);
}
.gm-file-remove {
    background: transparent;
    border: none;
    color: #e11d48;
    cursor: pointer;
    font-weight: 700;
    padding: 2px 8px;
}

/* Form Card Checkbox */
.gm-form-card {
    background: rgba(255, 255, 255, 0.03);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 12px;
    padding: 18px;
    margin-bottom: 24px;
}
html.light-mode .gm-form-card {
