{{#> emailWrapper}}
              <tr>
                <td class="wrapper">
                  <table role="presentation" border="0" cellpadding="0" cellspacing="0" width="100%">
                    <tr class="post-content-row">
                      <td class="{{classes.content}}">
                        {{{content}}}
                      </td>
                    </tr>
                  </table>
                </td>
              </tr>
              <tr>
                <td class="wrapper" align="center">
                  <table role="presentation" border="0" cellpadding="0" cellspacing="0" width="100%" style="padding-top: 40px; padding-bottom: 30px;">
                    {{#if footerContent }}
                      <tr>
                        <td class="footer" style="color: rgba(255, 255, 255, 0.45); font-size: 12px; line-height: 1.5;">{{{footerContent}}}</td>
                      </tr>
                    {{/if}}
                    <tr>
                      <td class="footer" style="color: rgba(255, 255, 255, 0.4); font-size: 12px; line-height: 1.5; padding-top: 12px;">
                        {{siteTitle}} &copy; {{year}} &mdash; {{#if unsubscribeUrl}}<a href="{{unsubscribeUrl}}" style="color: rgba(255, 255, 255, 0.6); text-decoration: underline;">{{t "Unsubscribe"}}</a>{{else}}<a href="{{managePreferencesUrl}}" style="color: rgba(255, 255, 255, 0.6); text-decoration: underline;">{{t "Manage your preferences"}}</a>{{/if}}
                      </td>
                    </tr>
                  </table>
                </td>
              </tr>
{{/emailWrapper}}
