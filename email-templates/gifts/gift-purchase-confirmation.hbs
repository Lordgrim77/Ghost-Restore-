<!doctype html>
<html>
  <head>
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta http-equiv="Content-Type" content="text/html; charset=UTF-8">
    <meta name="color-scheme" content="dark">
    <meta name="supported-color-schemes" content="dark">
    <title>{{t 'Your gift subscription confirmation'}}</title>
    <style>
      @media only screen and (max-width: 620px) {
        .container { width: 100% !important; padding: 16px 10px !important; }
        .main-card { padding: 30px 22px !important; border-radius: 16px !important; }
        h1.heading { font-size: 21px !important; margin-bottom: 12px !important; }
      }
      @media all {
        .ExternalClass { width: 100%; }
        .ExternalClass, .ExternalClass p, .ExternalClass span, .ExternalClass font, .ExternalClass td, .ExternalClass div { line-height: 100%; }
      }
      a { color: #ffffff; text-decoration: none; }
    </style>
  </head>
  <body style="background-color: #08090b; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif; -webkit-font-smoothing: antialiased; font-size: 14px; line-height: 1.6; margin: 0; padding: 0; -ms-text-size-adjust: 100%; -webkit-text-size-adjust: 100%;">
    <span class="preheader" style="color: transparent; display: none; height: 0; max-height: 0; max-width: 0; opacity: 0; overflow: hidden; mso-hide: all; visibility: hidden; width: 0;">{{t 'Thank you for supporting {siteTitle}.' siteTitle=siteTitle}}</span>
    <table border="0" cellpadding="0" cellspacing="0" width="100%" style="background-color: #08090b;">
      <tr>
        <td style="font-size: 14px; vertical-align: top;">&nbsp;</td>
        <td class="container" style="font-size: 14px; vertical-align: top; display: block; margin: 0 auto; max-width: 540px; padding: 32px 16px; width: 100%;">
          <div class="content" style="box-sizing: border-box; display: block; margin: 0 auto; max-width: 540px;">

            <!-- BRAND HEADER -->
            <div style="text-align: center; margin-bottom: 24px;">
              {{#if siteLogo}}
                <a href="{{siteUrl}}" target="_blank" style="text-decoration: none; display: inline-block;">
                  <img src="{{siteLogo}}" alt="{{siteTitle}}" style="max-height: 44px; max-width: 220px; height: auto; width: auto; border: 0; display: block; margin: 0 auto; object-fit: contain;" />
                </a>
              {{else if siteIconUrl}}
                <a href="{{siteUrl}}" target="_blank" style="text-decoration: none; display: inline-block;">
                  <img src="{{siteIconUrl}}" alt="{{siteTitle}}" width="48" height="48" style="border-radius: 12px; display: block; margin: 0 auto;" />
                </a>
              {{else}}
                <span style="font-size: 18px; font-weight: 800; color: #ffffff; letter-spacing: -0.02em; text-transform: uppercase;">{{siteTitle}}</span>
              {{/if}}
            </div>

            <!-- MAIN OBSIDIAN CARD -->
            <table class="main-card" style="border-collapse: separate; width: 100%; background: #111318; border: 1px solid rgba(255, 255, 255, 0.12); border-radius: 20px; box-shadow: 0 16px 44px rgba(0, 0, 0, 0.55);">
              <tr>
                <td class="wrapper" style="font-size: 14px; vertical-align: top; box-sizing: border-box; padding: 38px 34px;">
                  <table border="0" cellpadding="0" cellspacing="0" style="border-collapse: separate; width: 100%;">
                    <tr>
                      <td style="font-size: 14px; vertical-align: top;">
                        <div style="display: inline-block; padding: 5px 12px; background: rgba(255, 255, 255, 0.08); border-radius: 20px; font-size: 12px; font-weight: 700; color: #ffffff; margin-bottom: 16px; letter-spacing: 0.05em; text-transform: uppercase;">Gift Receipt</div>
                        <h1 class="heading" style="font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif; font-size: 24px; color: #ffffff; font-weight: 800; line-height: 1.3; margin: 0 0 16px 0; letter-spacing: -0.025em;">
                          {{#if gift.deliveryDate}}{{t 'Your gift is scheduled'}}{{else if gift.recipientEmail}}{{t 'Your gift is on its way'}}{{else}}{{t 'Your gift is ready'}}{{/if}}
                        </h1>
                        <p style="font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif; font-size: 15px; color: rgba(255, 255, 255, 0.74); font-weight: normal; line-height: 1.6; margin: 0 0 24px 0;">
                          {{#if gift.deliveryDate}}
                            {{#if gift.isMonthly}}
                              {{t 'Thank you for your support. Your gift — a <strong>{duration}-month</strong> {tierName} membership to {siteTitle} — will be sent to {recipientEmail} on {deliveryDate}. You can also share the link below yourself.' duration=gift.duration count=gift.duration tierName=(strong gift.tierName) siteTitle=siteTitle recipientEmail=(strong gift.recipientEmail) deliveryDate=(strong gift.deliveryDate)}}
                            {{else}}
                              {{t 'Thank you for your support. Your gift — a <strong>{duration}-year</strong> {tierName} membership to {siteTitle} — will be sent to {recipientEmail} on {deliveryDate}. You can also share the link below yourself.' duration=gift.duration count=gift.duration tierName=(strong gift.tierName) siteTitle=siteTitle recipientEmail=(strong gift.recipientEmail) deliveryDate=(strong gift.deliveryDate)}}
                            {{/if}}
                          {{else if gift.recipientEmail}}
                            {{#if gift.isMonthly}}
                              {{t 'Thank you for your support. Your gift — a <strong>{duration}-month</strong> {tierName} membership to {siteTitle} — is on its way to {recipientEmail}. You can also share the link below yourself.' duration=gift.duration count=gift.duration tierName=(strong gift.tierName) siteTitle=siteTitle recipientEmail=(strong gift.recipientEmail)}}
                            {{else}}
                              {{t 'Thank you for your support. Your gift — a <strong>{duration}-year</strong> {tierName} membership to {siteTitle} — is on its way to {recipientEmail}. You can also share the link below yourself.' duration=gift.duration count=gift.duration tierName=(strong gift.tierName) siteTitle=siteTitle recipientEmail=(strong gift.recipientEmail)}}
                            {{/if}}
                          {{else}}
                            {{#if gift.isMonthly}}
                              {{t 'Thank you for your support. Share the link below with whoever you\'d like to gift them a <strong>{duration}-month</strong> {tierName} membership to {siteTitle}.' duration=gift.duration count=gift.duration tierName=(strong gift.tierName) siteTitle=siteTitle}}
                            {{else}}
                              {{t 'Thank you for your support. Share the link below with whoever you\'d like to gift them a <strong>{duration}-year</strong> {tierName} membership to {siteTitle}.' duration=gift.duration count=gift.duration tierName=(strong gift.tierName) siteTitle=siteTitle}}
                            {{/if}}
                          {{/if}}
                        </p>

                        <!-- LINK BOX -->
                        <table width="100%" border="0" cellpadding="0" cellspacing="0" style="border-collapse: separate; width: 100%; box-sizing: border-box; background: #0d0f12; border: 1px solid rgba(255, 255, 255, 0.08); border-radius: 12px; margin-bottom: 20px;">
                          <tbody>
                            <tr>
                              <td align="left" style="padding: 16px 18px;">
                                <p style="font-family: SFMono-Regular, Menlo, Monaco, Consolas, monospace; font-size: 13px; line-height: 20px; color: #ffffff; margin: 0; word-break: break-all;">{{gift.link}}</p>
                              </td>
                            </tr>
                          </tbody>
                        </table>

                        <p style="font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif; font-size: 13px; color: rgba(255, 255, 255, 0.45); font-weight: normal; line-height: 1.5; margin: 0;">{{t 'The link expires on {expiresAt} and can only be redeemed once.' expiresAt=(strong gift.expiresAt)}}</p>
                      </td>
                    </tr>
                  </table>
                </td>
              </tr>
            </table>

            <!-- FOOTER -->
            <table border="0" cellpadding="0" cellspacing="0" width="100%" style="padding-top: 28px; text-align: center;">
              <tr>
                <td style="font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif; font-size: 11px; vertical-align: top; text-align: center;">
                  <p style="font-size: 12px; color: rgba(255, 255, 255, 0.42); margin: 0 0 6px 0; line-height: 1.5;">
                    Official Publication &bull; Sent from <span style="color: rgba(255, 255, 255, 0.65);">noreply@pedohunters.help</span>
                  </p>
                  <p style="font-size: 12px; color: rgba(255, 255, 255, 0.42); margin: 0 0 6px 0; line-height: 1.5;">
                    Contact: <a href="mailto:contact@pedohunters.help" style="color: rgba(255, 255, 255, 0.65); text-decoration: underline;">contact@pedohunters.help</a>
                  </p>
                  <p class="small" style="line-height: 16px; font-size: 11px; color: rgba(255, 255, 255, 0.4); margin: 0;">{{t 'This message was sent from {siteDomain} to {email}.' siteDomain=(linkTag siteUrl siteDomain class="small" style="text-decoration: underline; color: rgba(255, 255, 255, 0.65); font-size: 11px;") email=(linkTag (mailto toEmail) toEmail class="small" style="text-decoration: underline; color: rgba(255, 255, 255, 0.65); font-size: 11px;")}}</p>
                </td>
              </tr>
            </table>

          </div>
        </td>
        <td style="font-size: 14px; vertical-align: top;">&nbsp;</td>
      </tr>
    </table>
  </body>
</html>

