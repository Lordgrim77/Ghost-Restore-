<!doctype html>
<html>
  <head>
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta http-equiv="Content-Type" content="text/html; charset=UTF-8">
    <meta name="color-scheme" content="dark">
    <meta name="supported-color-schemes" content="dark">
    <title>{{t 'Your gift subscription is ending soon'}}</title>
    <style>
      @media only screen and (max-width: 620px) {
        .container { width: 100% !important; padding: 16px 10px !important; }
        .main-card { padding: 30px 22px !important; border-radius: 16px !important; }
        h1.heading { font-size: 21px !important; margin-bottom: 12px !important; }
        .btn-cta { display: block !important; width: 100% !important; box-sizing: border-box !important; text-align: center !important; }
      }
      @media all {
        .ExternalClass { width: 100%; }
        .ExternalClass, .ExternalClass p, .ExternalClass span, .ExternalClass font, .ExternalClass td, .ExternalClass div { line-height: 100%; }
      }
      a { color: #ffffff; text-decoration: none; }
    </style>
  </head>
  <body style="background-color: #08090b; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif; -webkit-font-smoothing: antialiased; font-size: 14px; line-height: 1.6; margin: 0; padding: 0; -ms-text-size-adjust: 100%; -webkit-text-size-adjust: 100%;">
    <span class="preheader" style="color: transparent; display: none; height: 0; max-height: 0; max-width: 0; opacity: 0; overflow: hidden; mso-hide: all; visibility: hidden; width: 0;">{{t 'Here\'s how to keep your {tierName} membership.' tierName=gift.tierName}}</span>
    <table border="0" cellpadding="0" cellspacing="0" width="100%" style="background-color: #08090b;">
      <tr>
        <td style="font-size: 14px; vertical-align: top;">&nbsp;</td>
        <td class="container" style="font-size: 14px; vertical-align: top; display: block; margin: 0 auto; max-width: 540px; padding: 32px 16px; width: 100%;">
          <div class="content" style="box-sizing: border-box; display: block; margin: 0 auto; max-width: 540px;">

            <!-- BRAND HEADER -->
            <div style="text-align: center; margin-bottom: 24px;">
              {{#if siteLogo}}
                <a href="{{siteUrl}}" target="_blank" style="text-decoration: none; display: inline-block;">
                  <img src="{{siteLogo}}" alt="{{siteTitle}}" style="max-height: 44px; max-width: 220px; height: auto; width: auto; border: 0; display: block; margin: 0 auto; object-fit: contain;" />
                </a>
              {{else if siteIconUrl}}
                <a href="{{siteUrl}}" target="_blank" style="text-decoration: none; display: inline-block;">
                  <img src="{{siteIconUrl}}" alt="{{siteTitle}}" width="48" height="48" style="border-radius: 12px; display: block; margin: 0 auto;" />
                </a>
              {{else}}
                <span style="font-size: 18px; font-weight: 800; color: #ffffff; letter-spacing: -0.02em; text-transform: uppercase;">{{siteTitle}}</span>
              {{/if}}
            </div>

            <!-- MAIN OBSIDIAN CARD -->
            <table class="main-card" style="border-collapse: separate; width: 100%; background: #111318; border: 1px solid rgba(255, 255, 255, 0.12); border-radius: 20px; box-shadow: 0 16px 44px rgba(0, 0, 0, 0.55);">
              <tr>
                <td class="wrapper" style="font-size: 14px; vertical-align: top; box-sizing: border-box; padding: 38px 34px;">
                  <table border="0" cellpadding="0" cellspacing="0" style="border-collapse: separate; width: 100%;">
                    <tr>
                      <td style="font-size: 14px; vertical-align: top;">
                        <div style="display: inline-block; padding: 5px 12px; background: rgba(255, 255, 255, 0.08); border-radius: 20px; font-size: 12px; font-weight: 700; color: #ffffff; margin-bottom: 16px; letter-spacing: 0.05em; text-transform: uppercase;">Membership Notice</div>
                        <h1 class="heading" style="font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif; font-size: 24px; color: #ffffff; font-weight: 800; line-height: 1.3; margin: 0 0 16px 0; letter-spacing: -0.025em;">
                          {{#if firstName}}{{t 'Hi {firstName},' firstName=firstName}}{{else}}{{t 'Hey there,'}}{{/if}}
                        </h1>
                        <p style="font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif; font-size: 15px; color: rgba(255, 255, 255, 0.74); font-weight: normal; line-height: 1.6; margin: 0 0 18px 0;">
                          {{t 'Your gift subscription to {siteTitle} ends on {consumesAt}.' siteTitle=siteTitle consumesAt=(strong gift.consumesAt)}}
                        </p>
                        <p style="font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif; font-size: 15px; color: rgba(255, 255, 255, 0.74); font-weight: normal; line-height: 1.6; margin: 0 0 28px 0;">
                          {{t 'To keep your {tierName} membership, continue with a paid subscription today and we\'ll automatically add the rest of your gift period as a free trial.' tierName=gift.tierName}}
                        </p>

                        <!-- CTA BUTTON -->
                        <table border="0" cellpadding="0" cellspacing="0" width="100%" style="margin-bottom: 24px;">
                          <tr>
                            <td align="center">
                              <a href="{{gift.manageSubscriptionUrl}}" target="_blank" class="btn-cta" style="display: inline-block; background-color: #ffffff; color: #090b10 !important; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif; font-size: 15px; font-weight: 700; text-decoration: none; border-radius: 12px; padding: 14px 34px; letter-spacing: -0.01em;">{{t 'Continue subscription'}} &rarr;</a>
                            </td>
                          </tr>
                        </table>

                        <p style="font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif; font-size: 13px; color: rgba(255, 255, 255, 0.45); line-height: 1.5; margin: 0;">{{t 'Thanks for reading {siteTitle}.' siteTitle=siteTitle}}</p>
                      </td>
                    </tr>
                  </table>
                </td>
              </tr>
            </table>

            <!-- FOOTER -->
            <table border="0" cellpadding="0" cellspacing="0" width="100%" style="padding-top: 28px; text-align: center;">
              <tr>
                <td style="font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif; font-size: 11px; vertical-align: top; text-align: center;">
                  <p class="small" style="line-height: 16px; font-size: 11px; color: rgba(255, 255, 255, 0.4); margin: 0;">{{t 'This message was sent from {siteDomain} to {email}.' siteDomain=(linkTag siteUrl siteDomain class="small" style="text-decoration: underline; color: rgba(255, 255, 255, 0.65); font-size: 11px;") email=(linkTag (mailto memberEmail) memberEmail class="small" style="text-decoration: underline; color: rgba(255, 255, 255, 0.65); font-size: 11px;")}}</p>
                </td>
              </tr>
            </table>

          </div>
        </td>
        <td style="font-size: 14px; vertical-align: top;">&nbsp;</td>
      </tr>
    </table>
  </body>
</html>
