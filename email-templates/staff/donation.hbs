<!doctype html>
<html>
  <head>
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta http-equiv="Content-Type" content="text/html; charset=UTF-8">
    <meta name="color-scheme" content="dark">
    <meta name="supported-color-schemes" content="dark">
    <title>💰 One-time payment received: {{donation.amount}} from {{donation.name}}</title>
    {{> styles}}
  </head>
  <body style="background-color: #08090b; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif; -webkit-font-smoothing: antialiased; font-size: 14px; line-height: 1.6; margin: 0; padding: 0; -ms-text-size-adjust: 100%; -webkit-text-size-adjust: 100%;">
    <table border="0" cellpadding="0" cellspacing="0" class="body" style="border-collapse: separate; width: 100%; background-color: #08090b;">
      <tr>
        <td style="font-size: 14px; vertical-align: top;">&nbsp;</td>
        <td class="container" style="font-size: 14px; vertical-align: top; display: block; margin: 0 auto; max-width: 540px; padding: 32px 16px; width: 100%;">
          <div class="content" style="box-sizing: border-box; display: block; margin: 0 auto; max-width: 540px;">

            <!-- PREVIEW & HEADER -->
            {{#> preview}}
              {{#*inline "content"}}
                You received a one-time payment of {{donation.amount}} from {{donation.name}}.
              {{/inline}}
            {{/preview}}

            <!-- MAIN OBSIDIAN CARD -->
            <table class="main" style="border-collapse: separate; width: 100%; background: #111318; border: 1px solid rgba(255, 255, 255, 0.12); border-radius: 20px; box-shadow: 0 16px 44px rgba(0, 0, 0, 0.55);">
              <tr>
                <td class="wrapper" style="font-size: 14px; vertical-align: top; box-sizing: border-box; padding: 38px 34px;">
                  <table border="0" cellpadding="0" cellspacing="0" style="border-collapse: separate; width: 100%;">
                    <tr>
                      <td style="font-size: 14px; vertical-align: top;">
                        <div style="display: inline-block; padding: 5px 12px; background: rgba(255, 255, 255, 0.08); border-radius: 20px; font-size: 12px; font-weight: 700; color: #ffffff; margin-bottom: 16px; letter-spacing: 0.05em; text-transform: uppercase;">Payment Received</div>
                        <h1 style="font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif; font-size: 24px; color: #ffffff; font-weight: 800; line-height: 1.3; margin: 0 0 24px 0; letter-spacing: -0.025em;">You received a payment</h1>

                        <!-- PAYMENT DETAIL CARD -->
                        <table width="100%" border="0" cellpadding="0" cellspacing="0" style="border-collapse: separate; width: 100%; box-sizing: border-box; background: #0d0f12; border: 1px solid rgba(255, 255, 255, 0.08); border-radius: 14px; margin-bottom: 28px;">
                          <tbody>
                            <tr>
                              <td align="left" style="padding: 22px 20px;">
                                <table border="0" cellpadding="0" cellspacing="0" width="100%">
                                  <tr>
                                    <td style="text-align: left; vertical-align: middle;">
                                      <p style="font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif; font-size: 12px; margin: 0; padding-bottom: 4px; color: rgba(255, 255, 255, 0.5); font-weight: 700; text-transform: uppercase; letter-spacing: 0.05em;">From</p>
                                      <p class="text-link large" style="font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif; font-size: 17px; margin: 0; padding-bottom: 18px; color: #ffffff; font-weight: 600;">
                                        {{donation.name}} {{#if memberData}}&bull; <a href="{{memberData.adminUrl}}" target="_blank" style="color: rgba(255, 255, 255, 0.7); text-decoration: underline; font-weight: 400; font-size: 14px;">View in Admin</a>{{/if}}
                                      </p>
                                      
                                      <p style="font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif; font-size: 12px; margin: 0; padding-bottom: 4px; color: rgba(255, 255, 255, 0.5); font-weight: 700; text-transform: uppercase; letter-spacing: 0.05em;">Amount</p>
                                      <p class="large" style="font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif; font-size: 22px; margin: 0; padding-bottom: {{#if donation.donationMessage}}18px{{else}}24px{{/if}}; color: #ffffff; font-weight: 800;">{{donation.amount}}</p>

                                      {{#if donation.donationMessage}}
                                        <p style="font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif; font-size: 12px; margin: 0; padding-bottom: 4px; color: rgba(255, 255, 255, 0.5); font-weight: 700; text-transform: uppercase; letter-spacing: 0.05em;">Personal Note</p>
                                        <p class="text-link large" style="font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif; font-size: 15px; margin: 0; padding-bottom: 24px; color: rgba(255, 255, 255, 0.9); font-style: italic;">&ldquo;{{donation.donationMessage}}&rdquo;</p>
                                      {{/if}}
                                    </td>
                                  </tr>
                                </table>

                                <!-- CTA BUTTON -->
                                <table border="0" cellpadding="0" cellspacing="0" width="100%">
                                  <tr>
                                    <td>
                                      {{#if donation.donationMessage}}
                                        <a href="mailto:{{donation.email}}" target="_blank" class="btn-cta" style="display: inline-block; background-color: #ffffff; color: #090b10 !important; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif; font-size: 14px; font-weight: 700; text-decoration: none; border-radius: 12px; padding: 12px 26px; letter-spacing: -0.01em;">Reply to message &rarr;</a>
                                      {{else}}
                                        <a href="mailto:{{donation.email}}" target="_blank" class="btn-cta" style="display: inline-block; background-color: #ffffff; color: #090b10 !important; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif; font-size: 14px; font-weight: 700; text-decoration: none; border-radius: 12px; padding: 12px 26px; letter-spacing: -0.01em;">Say thanks via email &rarr;</a>
                                      {{/if}}
                                    </td>
                                  </tr>
                                </table>

                              </td>
                            </tr>
                          </tbody>
                        </table>

                      </td>
                    </tr>
                  </table>
                </td>
              </tr>
            </table>

            <!-- FOOTER -->
            <table border="0" cellpadding="0" cellspacing="0" width="100%" style="padding-top: 28px; text-align: center;">
              <tr>
                <td style="font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif; font-size: 12px; vertical-align: top; text-align: center;">
                  <p class="small" style="line-height: 18px; font-size: 12px; color: rgba(255, 255, 255, 0.4); margin: 0 0 6px 0;">This message was sent from <a class="small" href="{{siteUrl}}" style="text-decoration: underline; color: rgba(255, 255, 255, 0.65); font-size: 12px;">{{siteDomain}}</a> to <span style="color: rgba(255, 255, 255, 0.65);">{{toEmail}}</span></p>
                  <p class="small" style="line-height: 18px; font-size: 12px; color: rgba(255, 255, 255, 0.4); margin: 0;"><a class="small" href="{{staffUrl}}" style="text-decoration: underline; color: rgba(255, 255, 255, 0.65); font-size: 12px;">Manage notification preferences</a></p>
                </td>
              </tr>
            </table>

          </div>
        </td>
        <td style="font-size: 14px; vertical-align: top;">&nbsp;</td>
      </tr>
    </table>
  </body>
</html>
