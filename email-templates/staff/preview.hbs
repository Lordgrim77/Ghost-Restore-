{{#if siteLogo}}
<div style="text-align: center; margin-bottom: 24px; padding-top: 8px;">
  <a href="{{siteUrl}}" target="_blank" style="text-decoration: none; display: inline-block;">
    <img src="{{siteLogo}}" alt="{{siteTitle}}" style="max-height: 44px; max-width: 220px; height: auto; width: auto; border: 0; display: block; margin: 0 auto; object-fit: contain;" />
  </a>
</div>
{{else}}
<div style="text-align: center; margin-bottom: 20px; padding-top: 8px;">
  <a href="{{siteUrl}}" target="_blank" style="text-decoration: none; display: inline-block; font-size: 18px; font-weight: 800; color: #ffffff;">{{siteTitle}}</a>
</div>
{{/if}}
