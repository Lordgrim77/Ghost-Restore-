<!doctype html>
<html>
  <head>
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta http-equiv="Content-Type" content="text/html; charset=UTF-8">
    <meta name="color-scheme" content="dark">
    <meta name="supported-color-schemes" content="dark">
    <title>👍 New recommendation</title>
    {{> styles}}
  </head>
  <body style="background-color: #08090b; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif; -webkit-font-smoothing: antialiased; font-size: 14px; line-height: 1.6; margin: 0; padding: 0; -ms-text-size-adjust: 100%; -webkit-text-size-adjust: 100%;">
    <table border="0" cellpadding="0" cellspacing="0" class="body" style="border-collapse: separate; width: 100%; background-color: #08090b;">
      <tr>
        <td style="font-size: 14px; vertical-align: top;">&nbsp;</td>
        <td class="container" style="font-size: 14px; vertical-align: top; display: block; margin: 0 auto; max-width: 540px; padding: 32px 16px; width: 100%;">
          <div class="content" style="box-sizing: border-box; display: block; margin: 0 auto; max-width: 540px;">

            <!-- PREVIEW & HEADER -->
            {{#> preview}}
              {{#*inline "content"}}
                {{#if recommendation.recommendingBack}}
                  A site is now recommending you back!
                {{else}}
                  A site is now recommending you to their audience!
                {{/if}}
              {{/inline}}
            {{/preview}}

            <!-- MAIN OBSIDIAN CARD -->
            <table class="main" style="border-collapse: separate; width: 100%; background: #111318; border: 1px solid rgba(255, 255, 255, 0.12); border-radius: 20px; box-shadow: 0 16px 44px rgba(0, 0, 0, 0.55);">
              <tr>
                <td class="wrapper" style="font-size: 14px; vertical-align: top; box-sizing: border-box; padding: 38px 34px;">
                  <table border="0" cellpadding="0" cellspacing="0" style="border-collapse: separate; width: 100%;">
                    <tr>
                      <td style="font-size: 14px; vertical-align: top;">
                        <div style="display: inline-block; padding: 5px 12px; background: rgba(255, 255, 255, 0.08); border-radius: 20px; font-size: 12px; font-weight: 700; color: #ffffff; margin-bottom: 16px; letter-spacing: 0.05em; text-transform: uppercase;">Recommendation</div>
                        
                        {{#if recommendation.recommendingBack}}
                          <h1 style="font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif; font-size: 24px; color: #ffffff; font-weight: 800; line-height: 1.3; margin: 0 0 20px 0; letter-spacing: -0.025em;">A site is now recommending you back</h1>
                        {{else}}
                          <h1 style="font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif; font-size: 24px; color: #ffffff; font-weight: 800; line-height: 1.3; margin: 0 0 12px 0; letter-spacing: -0.025em;">A site is now recommending you</h1>
                          <p style="font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif; font-size: 15px; color: rgba(255, 255, 255, 0.7); line-height: 1.5; margin: 0 0 24px 0;">Every time someone signs up on their publication, they’ll see an option to check out {{siteTitle}}.</p>
                        {{/if}}

                        <!-- RECOMMENDATION BOOKMARK -->
                        <table width="100%" border="0" cellpadding="0" cellspacing="0" style="border-collapse: separate; width: 100%; box-sizing: border-box; background: #0d0f12; border: 1px solid rgba(255, 255, 255, 0.08); border-radius: 14px; margin-bottom: 28px;">
                          <tbody>
                            <tr>
                              <td align="left" style="padding: 20px;">
                                <a href="{{recommendation.url}}" target="_blank" style="text-decoration: none; display: block;">
                                  <table border="0" cellpadding="0" cellspacing="0" width="100%">
                                    <tr>
                                      <td valign="top">
                                        <div style="font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif; font-size: 16px; font-weight: 700; color: #ffffff; margin-bottom: 6px;">{{recommendation.title}}</div>
                                        {{#if recommendation.excerpt}}
                                          <div style="font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif; font-size: 13px; line-height: 1.5; color: rgba(255, 255, 255, 0.6); margin-bottom: 10px;">{{recommendation.excerpt}}</div>
                                        {{/if}}
                                        <div style="font-family: SFMono-Regular, Menlo, Monaco, Consolas, monospace; font-size: 11px; color: rgba(255, 255, 255, 0.45); word-break: break-all;">{{recommendation.url}}</div>
                                      </td>
                                      {{#if recommendation.featuredImage}}
                                        <td width="100" valign="middle" align="right" style="padding-left: 16px;">
                                          <img src="{{recommendation.featuredImage}}" width="80" height="80" style="border-radius: 10px; object-fit: cover; border: 1px solid rgba(255, 255, 255, 0.1);" alt="" />
                                        </td>
                                      {{/if}}
                                    </tr>
                                  </table>
                                </a>
                              </td>
                            </tr>
                          </tbody>
                        </table>

                        <!-- CTA BUTTON -->
                        <table border="0" cellpadding="0" cellspacing="0" width="100%">
                          <tr>
                            <td>
                              <a href="{{siteUrl}}/ghost/#/settings/recommendations" target="_blank" class="btn-cta" style="display: inline-block; background-color: #ffffff; color: #090b10 !important; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif; font-size: 14px; font-weight: 700; text-decoration: none; border-radius: 12px; padding: 12px 26px; letter-spacing: -0.01em;">Manage recommendations &rarr;</a>
                            </td>
                          </tr>
                        </table>

                      </td>
                    </tr>
                  </table>
                </td>
              </tr>
            </table>

            <!-- FOOTER -->
            <table border="0" cellpadding="0" cellspacing="0" width="100%" style="padding-top: 28px; text-align: center;">
              <tr>
                <td style="font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif; font-size: 12px; vertical-align: top; text-align: center;">
                  <p style="font-size: 12px; color: rgba(255, 255, 255, 0.42); margin: 0 0 6px 0; line-height: 1.5;">
                    Official Publication &bull; Sent from <span style="color: rgba(255, 255, 255, 0.65);">noreply@pedohunters.help</span>
                  </p>
                  <p style="font-size: 12px; color: rgba(255, 255, 255, 0.42); margin: 0 0 6px 0; line-height: 1.5;">
                    Contact: <a href="mailto:contact@pedohunters.help" style="color: rgba(255, 255, 255, 0.65); text-decoration: underline;">contact@pedohunters.help</a>
                  </p>
                  <p class="small" style="line-height: 18px; font-size: 12px; color: rgba(255, 255, 255, 0.4); margin: 0 0 6px 0;">This message was sent from <a class="small" href="{{siteUrl}}" style="text-decoration: underline; color: rgba(255, 255, 255, 0.65); font-size: 12px;">{{siteDomain}}</a> to <span style="color: rgba(255, 255, 255, 0.65);">{{toEmail}}</span></p>
                  <p class="small" style="line-height: 18px; font-size: 12px; color: rgba(255, 255, 255, 0.4); margin: 0;"><a class="small" href="{{staffUrl}}" style="text-decoration: underline; color: rgba(255, 255, 255, 0.65); font-size: 12px;">Manage notification preferences</a></p>
                </td>
              </tr>
            </table>

          </div>
        </td>
        <td style="font-size: 14px; vertical-align: top;">&nbsp;</td>
      </tr>
    </table>
  </body>
</html>
