<!doctype html>
<html>
  <head>
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta http-equiv="Content-Type" content="text/html; charset=UTF-8">
    <meta name="color-scheme" content="dark">
    <meta name="supported-color-schemes" content="dark">
    <title>🎁 Gift subscription redeemed: {{memberData.name}}</title>
    {{> styles}}
  </head>
  <body style="background-color: #08090b; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif; -webkit-font-smoothing: antialiased; font-size: 14px; line-height: 1.6; margin: 0; padding: 0; -ms-text-size-adjust: 100%; -webkit-text-size-adjust: 100%;">
    <table border="0" cellpadding="0" cellspacing="0" class="body" style="border-collapse: separate; width: 100%; background-color: #08090b;">
      <tr>
        <td style="font-size: 14px; vertical-align: top;">&nbsp;</td>
        <td class="container" style="font-size: 14px; vertical-align: top; display: block; margin: 0 auto; max-width: 540px; padding: 32px 16px; width: 100%;">
          <div class="content" style="box-sizing: border-box; display: block; margin: 0 auto; max-width: 540px;">

            <!-- PREVIEW & HEADER -->
            {{#> preview}}
              {{#*inline "content"}}
                Gift subscription redeemed by {{memberData.name}}.
              {{/inline}}
            {{/preview}}

            <!-- MAIN OBSIDIAN CARD -->
            <table class="main" style="border-collapse: separate; width: 100%; background: #111318; border: 1px solid rgba(255, 255, 255, 0.12); border-radius: 20px; box-shadow: 0 16px 44px rgba(0, 0, 0, 0.55);">
              <tr>
                <td class="wrapper" style="font-size: 14px; vertical-align: top; box-sizing: border-box; padding: 38px 34px;">
                  <table border="0" cellpadding="0" cellspacing="0" style="border-collapse: separate; width: 100%;">
                    <tr>
                      <td style="font-size: 14px; vertical-align: top;">
                        <div style="display: inline-block; padding: 5px 12px; background: rgba(255, 255, 255, 0.08); border-radius: 20px; font-size: 12px; font-weight: 700; color: #ffffff; margin-bottom: 16px; letter-spacing: 0.05em; text-transform: uppercase;">Gift Redeemed</div>
                        <h1 style="font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif; font-size: 24px; color: #ffffff; font-weight: 800; line-height: 1.3; margin: 0 0 24px 0; letter-spacing: -0.025em;">A gift subscription was redeemed</h1>

                        <!-- REDEEM DETAIL CARD -->
                        <table width="100%" border="0" cellpadding="0" cellspacing="0" style="border-collapse: separate; width: 100%; box-sizing: border-box; background: #0d0f12; border: 1px solid rgba(255, 255, 255, 0.08); border-radius: 14px; margin-bottom: 28px;">
                          <tbody>
                            <tr>
                              <td align="left" style="padding: 22px 20px;">
                                <table border="0" cellpadding="0" cellspacing="0" width="100%">
                                  <tr>
                                    <td style="text-align: left; vertical-align: middle;">
                                      <p style="font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif; font-size: 12px; margin: 0; padding-bottom: 4px; color: rgba(255, 255, 255, 0.5); font-weight: 700; text-transform: uppercase; letter-spacing: 0.05em;">Recipient</p>
                                      <p class="text-link large" style="font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif; font-size: 17px; margin: 0; padding-bottom: 18px; color: #ffffff; font-weight: 600;">{{memberData.name}}{{#if memberData.showEmail}} <span style="color: rgba(255, 255, 255, 0.6); font-weight: 400;">({{memberData.email}})</span>{{/if}}</p>
                                      
                                      <p style="font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif; font-size: 12px; margin: 0; padding-bottom: 4px; color: rgba(255, 255, 255, 0.5); font-weight: 700; text-transform: uppercase; letter-spacing: 0.05em;">Plan Tier</p>
                                      <p class="text-link large" style="font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif; font-size: 15px; margin: 0; padding-bottom: 18px; color: #ffffff; font-weight: 500;">{{tierData.name}}{{#if tierData.details}} &bull; {{tierData.details}}{{/if}}</p>

                                      <p style="font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif; font-size: 12px; margin: 0; padding-bottom: 4px; color: rgba(255, 255, 255, 0.5); font-weight: 700; text-transform: uppercase; letter-spacing: 0.05em;">Gifted By</p>
                                      <p class="large" style="font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif; font-size: 15px; margin: 0; padding-bottom: 24px; color: #ffffff; font-weight: 400;">{{giftedByEmail}}</p>
                                    </td>
                                  </tr>
                                </table>

                                <!-- CTA BUTTON -->
                                <table border="0" cellpadding="0" cellspacing="0" width="100%">
                                  <tr>
                                    <td>
                                      <a href="{{memberData.adminUrl}}" target="_blank" class="btn-cta" style="display: inline-block; background-color: #ffffff; color: #090b10 !important; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif; font-size: 14px; font-weight: 700; text-decoration: none; border-radius: 12px; padding: 12px 26px; letter-spacing: -0.01em;">View member in Admin &rarr;</a>
                                    </td>
                                  </tr>
                                </table>

                              </td>
                            </tr>
                          </tbody>
                        </table>

                        <!-- FALLBACK URL -->
                        <div style="border-top: 1px solid rgba(255, 255, 255, 0.08); padding-top: 20px;">
                          <p style="font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif; font-size: 12px; color: rgba(255, 255, 255, 0.45); margin: 0 0 6px 0; line-height: 1.5;">Or copy and paste this URL into your browser:</p>
                          <p style="word-break: break-all; font-family: SFMono-Regular, Menlo, Monaco, Consolas, monospace; font-size: 11px; line-height: 1.5; margin: 0; color: rgba(255, 255, 255, 0.65);">{{memberData.adminUrl}}</p>
                        </div>

                      </td>
                    </tr>
                  </table>
                </td>
              </tr>
            </table>

            <!-- FOOTER -->
            <table border="0" cellpadding="0" cellspacing="0" width="100%" style="padding-top: 28px; text-align: center;">
              <tr>
                <td style="font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif; font-size: 12px; vertical-align: top; text-align: center;">
                  <p style="font-size: 12px; color: rgba(255, 255, 255, 0.42); margin: 0 0 6px 0; line-height: 1.5;">
                    Official Publication &bull; Sent from <span style="color: rgba(255, 255, 255, 0.65);">noreply@pedohunters.help</span>
                  </p>
                  <p style="font-size: 12px; color: rgba(255, 255, 255, 0.42); margin: 0 0 6px 0; line-height: 1.5;">
                    Contact: <a href="mailto:contact@pedohunters.help" style="color: rgba(255, 255, 255, 0.65); text-decoration: underline;">contact@pedohunters.help</a>
                  </p>
                  <p class="small" style="line-height: 18px; font-size: 12px; color: rgba(255, 255, 255, 0.4); margin: 0 0 6px 0;">This message was sent from <a class="small" href="{{siteUrl}}" style="text-decoration: underline; color: rgba(255, 255, 255, 0.65); font-size: 12px;">{{siteDomain}}</a> to <span style="color: rgba(255, 255, 255, 0.65);">{{toEmail}}</span></p>
                  <p class="small" style="line-height: 18px; font-size: 12px; color: rgba(255, 255, 255, 0.4); margin: 0;"><a class="small" href="{{staffUrl}}" style="text-decoration: underline; color: rgba(255, 255, 255, 0.65); font-size: 12px;">Manage notification preferences</a></p>
                </td>
              </tr>
            </table>

          </div>
        </td>
        <td style="font-size: 14px; vertical-align: top;">&nbsp;</td>
      </tr>
    </table>
  </body>
</html>
