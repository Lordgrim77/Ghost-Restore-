{{!< default}}

<style>
/* Scoped Clean Monochromatic Styles for Team Page */
.gm-team-section {
  max-width: 1200px !important;
  margin: 0 auto 80px auto !important;
  padding: 0 24px !important;
  box-sizing: border-box !important;
}

.gm-team-grid {
  display: grid !important;
  grid-template-columns: repeat(auto-fill, minmax(280px, 1fr)) !important;
  gap: 20px !important;
  width: 100% !important;
  box-sizing: border-box !important;
  justify-content: center !important;
}

.gm-team-grid:has(.gm-team-card:only-child) {
  grid-template-columns: minmax(0, 480px) !important;
  justify-content: center !important;
}

.gm-team-card {
  position: relative !important;
  background: var(--gm-card-bg, rgba(18, 18, 18, 0.8)) !important;
  border: 1px solid var(--gm-glass-border, rgba(255, 255, 255, 0.12)) !important;
  border-radius: 16px !important;
  padding: 20px 20px !important;
  box-shadow: 0 8px 24px rgba(0, 0, 0, 0.35) !important;
  backdrop-filter: blur(16px) !important;
  -webkit-backdrop-filter: blur(16px) !important;
  display: flex !important;
  flex-direction: column !important;
  justify-content: space-between !important;
  box-sizing: border-box !important;
  overflow: hidden !important;
  transition: transform 0.2s ease, border-color 0.2s ease, box-shadow 0.2s ease !important;
}

.gm-team-card:hover {
  transform: translateY(-3px) !important;
  border-color: rgba(255, 255, 255, 0.3) !important;
  box-shadow: 0 12px 30px rgba(0, 0, 0, 0.5) !important;
}

html.light-mode .gm-team-card,
html[data-theme="light"] .gm-team-card {
  background: #ffffff !important;
  border: 1px solid rgba(0, 0, 0, 0.1) !important;
  box-shadow: 0 4px 16px rgba(0, 0, 0, 0.05) !important;
}

html.light-mode .gm-team-card:hover,
html[data-theme="light"] .gm-team-card:hover {
  border-color: rgba(0, 0, 0, 0.25) !important;
  box-shadow: 0 8px 24px rgba(0, 0, 0, 0.1) !important;
}

/* Identity row */
.gm-team-hero-row {
  display: flex !important;
  align-items: center !important;
  gap: 14px !important;
  margin-bottom: 14px !important;
}

.gm-team-avatar-wrap {
  width: 52px !important;
  height: 52px !important;
  min-width: 52px !important;
  border-radius: 50% !important;
  overflow: hidden !important;
  background: rgba(255, 255, 255, 0.06) !important;
  border: 1px solid rgba(255, 255, 255, 0.15) !important;
  display: flex !important;
  align-items: center !important;
  justify-content: center !important;
  flex-shrink: 0 !important;
}

html.light-mode .gm-team-avatar-wrap,
html[data-theme="light"] .gm-team-avatar-wrap {
  background: #f1f5f9 !important;
  border-color: rgba(0, 0, 0, 0.1) !important;
}

.gm-team-avatar-wrap a {
  display: block !important;
  width: 100% !important;
  height: 100% !important;
}

.gm-team-avatar {
  width: 100% !important;
  height: 100% !important;
  object-fit: cover !important;
  display: block !important;
}

.gm-team-avatar-initials {
  font-family: var(--font-inter, sans-serif) !important;
  font-weight: 700 !important;
  font-size: 16px !important;
  color: #ffffff !important;
  display: flex !important;
  align-items: center !important;
  justify-content: center !important;
  width: 100% !important;
  height: 100% !important;
  background: #1f2937 !important;
}

html.light-mode .gm-team-avatar-initials,
html[data-theme="light"] .gm-team-avatar-initials {
  background: #0f172a !important;
  color: #ffffff !important;
}

.gm-team-identity-info {
  display: flex !important;
  flex-direction: column !important;
  min-width: 0 !important;
  flex-grow: 1 !important;
}

.gm-team-name {
  margin: 0 0 2px 0 !important;
  font-family: var(--font-inter, sans-serif) !important;
  font-size: 1.12rem !important;
  font-weight: 700 !important;
  line-height: 1.25 !important;
  color: #ffffff !important;
  letter-spacing: -0.01em !important;
  overflow: hidden !important;
  text-overflow: ellipsis !important;
  white-space: nowrap !important;
}

.gm-team-name a,
.gm-team-name span {
  color: inherit !important;
  text-decoration: none !important;
  transition: opacity 0.15s ease !important;
}

.gm-team-name a:hover {
  opacity: 0.85 !important;
}

html.light-mode .gm-team-name,
html[data-theme="light"] .gm-team-name {
  color: #0f172a !important;
}

.gm-team-role {
  font-family: var(--font-inter, sans-serif) !important;
  font-size: 0.82rem !important;
  font-weight: 500 !important;
  color: rgba(255, 255, 255, 0.65) !important;
  line-height: 1.3 !important;
  margin: 0 !important;
}

html.light-mode .gm-team-role,
html[data-theme="light"] .gm-team-role {
  color: #64748b !important;
}

.gm-team-location {
  display: inline-flex !important;
  align-items: center !important;
  gap: 5px !important;
  font-family: var(--font-inter, sans-serif) !important;
  font-size: 0.75rem !important;
  color: rgba(255, 255, 255, 0.45) !important;
  margin-top: 4px !important;
}

html.light-mode .gm-team-location,
html[data-theme="light"] .gm-team-location {
  color: #94a3b8 !important;
}

.gm-team-location svg {
  flex-shrink: 0 !important;
}

/* Bio */
.gm-team-bio {
  font-family: var(--font-inter, sans-serif) !important;
  font-size: 0.86rem !important;
  line-height: 1.5 !important;
  color: rgba(255, 255, 255, 0.72) !important;
  margin: 0 0 16px 0 !important;
  display: -webkit-box !important;
  -webkit-line-clamp: 3 !important;
  -webkit-box-orient: vertical !important;
  overflow: hidden !important;
}

html.light-mode .gm-team-bio,
html[data-theme="light"] .gm-team-bio {
  color: #475569 !important;
}

/* Card footer */
.gm-team-card-footer {
  display: flex !important;
  align-items: center !important;
  justify-content: space-between !important;
  gap: 12px !important;
  padding-top: 14px !important;
  border-top: 1px solid rgba(255, 255, 255, 0.08) !important;
  margin-top: auto !important;
}

html.light-mode .gm-team-card-footer,
html[data-theme="light"] .gm-team-card-footer {
  border-top: 1px solid rgba(0, 0, 0, 0.06) !important;
}

.gm-team-social-links {
  display: flex !important;
  align-items: center !important;
  gap: 6px !important;
  flex-wrap: wrap !important;
}

.gm-team-social-btn {
  display: inline-flex !important;
  align-items: center !important;
  justify-content: center !important;
  width: 28px !important;
  height: 28px !important;
  border-radius: 6px !important;
  background: rgba(255, 255, 255, 0.05) !important;
  border: 1px solid rgba(255, 255, 255, 0.1) !important;
  color: rgba(255, 255, 255, 0.75) !important;
  text-decoration: none !important;
  transition: all 0.15s ease !important;
}

.gm-team-social-btn:hover {
  background: rgba(255, 255, 255, 0.15) !important;
  color: #ffffff !important;
  border-color: rgba(255, 255, 255, 0.3) !important;
}

html.light-mode .gm-team-social-btn,
html[data-theme="light"] .gm-team-social-btn {
  background: rgba(0, 0, 0, 0.04) !important;
  border-color: rgba(0, 0, 0, 0.08) !important;
  color: #475569 !important;
}

html.light-mode .gm-team-social-btn:hover,
html[data-theme="light"] .gm-team-social-btn:hover {
  background: rgba(0, 0, 0, 0.08) !important;
  color: #0f172a !important;
}

.gm-team-cta-btn {
  display: inline-flex !important;
  align-items: center !important;
  gap: 6px !important;
  padding: 6px 14px !important;
  border-radius: 999px !important;
  background: #ffffff !important;
  color: #000000 !important;
  font-family: var(--font-inter, sans-serif) !important;
  font-size: 0.8rem !important;
  font-weight: 600 !important;
  text-decoration: none !important;
  white-space: nowrap !important;
  transition: opacity 0.15s ease, transform 0.15s ease !important;
  flex-shrink: 0 !important;
}

.gm-team-cta-btn:hover {
  opacity: 0.9 !important;
  transform: translateY(-1px) !important;
}

html.light-mode .gm-team-cta-btn,
html[data-theme="light"] .gm-team-cta-btn {
  background: #000000 !important;
  color: #ffffff !important;
}

html.light-mode .gm-team-cta-btn:hover,
html[data-theme="light"] .gm-team-cta-btn:hover {
  background: #1e293b !important;
}

@media (max-width: 768px) {
  .gm-team-section {
    padding: 0 16px !important;
    margin-bottom: 48px !important;
  }
  .gm-team-grid {
    grid-template-columns: 1fr !important;
    gap: 16px !important;
  }
}

@media (max-width: 480px) {
  .gm-team-card-footer {
    flex-direction: row !important;
    align-items: center !important;
  }
}
</style>

<div class="content-area">
<main class="site-main">

    <!-- Hero Section matching Home Page exactly -->
    <section class="gm-hero">
        <span class="gm-hero-eyebrow">{{t "Pedo Hunters"}}</span>
        <h1 class="gm-hero-title">{{#post}}{{title}}{{else}}{{t "Our Team"}}{{/post}}</h1>
        <p class="gm-hero-desc">
            {{#post}}
                {{#if custom_excerpt}}{{custom_excerpt}}{{else}}{{t "Meet the researchers, investigators, and developers working together to protect children and uncover truth."}}{{/if}}
            {{else}}
                {{t "Meet the researchers, investigators, and developers working together to protect children and uncover truth."}}
            {{/post}}
        </p>
    </section>

    <!-- Team Cards Grid -->
    <section class="gm-team-section">
        <div id="gm-team-grid" class="gm-team-grid" data-team-loaded="false">
            {{!-- Initial SSR Fallback: Ghost Native Authors Scraped by team-page.js --}}
            {{#get "authors" limit="all" include="count.posts" order="count.posts desc"}}
                {{#foreach authors}}
                    <div class="gm-team-card-ssr" 
                         style="display:none;"
                         data-slug="{{slug}}" 
                         data-name="{{name}}" 
                         data-posts="{{count.posts}}"
                         data-url="{{url}}">
                        {{#if profile_image}}<span data-field="avatar">{{img_url profile_image size="m"}}</span>{{/if}}
                        {{#if location}}<span data-field="location">{{location}}</span>{{/if}}
                        {{#if bio}}<span data-field="bio">{{bio}}</span>{{/if}}
                        {{#if website}}<span data-field="website">{{website}}</span>{{/if}}
                        {{#if twitter}}<span data-field="twitter">{{twitter_url}}</span>{{/if}}
                        {{#if facebook}}<span data-field="facebook">{{facebook_url}}</span>{{/if}}
                    </div>
                {{/foreach}}
            {{/get}}
        </div>
    </section>

</main>
</div>

