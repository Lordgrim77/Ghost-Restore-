{{!< default}}

<div class="content-area">
<main class="site-main">

    <!-- Hero Section matching Home Page exactly -->
    <section class="gm-hero">
        <span class="gm-hero-eyebrow">{{t "Pedo Hunters"}}</span>
        <h1 class="gm-hero-title">{{#post}}{{title}}{{else}}{{t "Our Team"}}{{/post}}</h1>
        <p class="gm-hero-desc">
            {{#post}}
                {{#if custom_excerpt}}{{custom_excerpt}}{{else}}{{t "Meet the researchers, investigators, and developers working together to protect children and uncover truth."}}{{/if}}
            {{else}}
                {{t "Meet the researchers, investigators, and developers working together to protect children and uncover truth."}}
            {{/post}}
        </p>
    </section>

    <!-- Team Cards Grid -->
    <section class="gm-team-section">
        <div id="gm-team-grid" class="gm-team-grid" data-team-loaded="false">
            {{!-- Initial SSR Fallback: Ghost Native Authors Scraped by team-page.js --}}
            {{#get "authors" limit="all" include="count.posts" order="count.posts desc"}}
                {{#foreach authors}}
                    <div class="gm-team-card-ssr" 
                         style="display:none;"
                         data-slug="{{slug}}" 
                         data-name="{{name}}" 
                         data-posts="{{count.posts}}"
                         data-url="{{url}}">
                        {{#if profile_image}}<span data-field="avatar">{{img_url profile_image size="m"}}</span>{{/if}}
                        {{#if location}}<span data-field="location">{{location}}</span>{{/if}}
                        {{#if bio}}<span data-field="bio">{{bio}}</span>{{/if}}
                        {{#if website}}<span data-field="website">{{website}}</span>{{/if}}
                        {{#if twitter}}<span data-field="twitter">{{twitter_url}}</span>{{/if}}
                        {{#if facebook}}<span data-field="facebook">{{facebook_url}}</span>{{/if}}
                    </div>
                {{/foreach}}
            {{/get}}
        </div>
    </section>

</main>
</div>

{{!-- Inline Embedded Team Config (Fallback & Quick-Edit Source) --}}
<script id="gm-team-default-data" type="application/json">
