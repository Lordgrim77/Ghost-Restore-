<style>
/* Scoped Ultra-Premium Styles for Dedicated Team Page */
.gm-team-section {
  max-width: 1200px !important;
  margin: 0 auto 80px auto !important;
  padding: 0 24px !important;
  box-sizing: border-box !important;
}

.gm-team-grid {
  display: grid !important;
  grid-template-columns: repeat(auto-fit, minmax(360px, 1fr)) !important;
  gap: 32px !important;
  width: 100% !important;
  box-sizing: border-box !important;
}

.gm-team-grid:has(.gm-team-card:only-child) {
  grid-template-columns: minmax(0, 760px) !important;
  justify-content: center !important;
}

@media (min-width: 1100px) {
  .gm-team-grid:has(.gm-team-card:nth-child(2)) {
    grid-template-columns: repeat(2, minmax(0, 1fr)) !important;
  }
  .gm-team-grid:has(.gm-team-card:nth-child(3)) {
    grid-template-columns: repeat(3, minmax(0, 1fr)) !important;
  }
}

.gm-team-card {
  position: relative !important;
  background: var(--gm-card-bg, rgba(13, 17, 23, 0.75)) !important;
  border: 1px solid var(--gm-glass-border, rgba(255, 255, 255, 0.12)) !important;
  border-radius: 24px !important;
  padding: 32px 30px !important;
  box-shadow: 0 16px 40px rgba(0, 0, 0, 0.45) !important;
  backdrop-filter: blur(20px) !important;
  -webkit-backdrop-filter: blur(20px) !important;
  display: flex !important;
  flex-direction: column !important;
  justify-content: space-between !important;
  box-sizing: border-box !important;
  overflow: hidden !important;
  transition: transform 0.35s cubic-bezier(0.16, 1, 0.3, 1),
              border-color 0.3s ease,
              box-shadow 0.35s ease !important;
}

.gm-team-card::before {
  content: "" !important;
  position: absolute !important;
  top: 0 !important;
  left: 0 !important;
  right: 0 !important;
  height: 2px !important;
  background: linear-gradient(90deg, transparent, #38bdf8, #818cf8, transparent) !important;
  opacity: 0.7 !important;
  transition: opacity 0.3s ease !important;
}

.gm-team-card:hover {
  transform: translateY(-5px) !important;
  border-color: rgba(56, 189, 248, 0.35) !important;
  box-shadow: 0 24px 50px rgba(0, 0, 0, 0.55), 0 0 30px rgba(56, 189, 248, 0.15) !important;
}

.gm-team-card:hover::before {
  opacity: 1 !important;
}

html.light-mode .gm-team-card,
html[data-theme="light"] .gm-team-card {
  background: #ffffff !important;
  border-color: rgba(0, 0, 0, 0.08) !important;
  box-shadow: 0 12px 32px rgba(0, 0, 0, 0.06) !important;
}

html.light-mode .gm-team-card:hover,
html[data-theme="light"] .gm-team-card:hover {
  border-color: rgba(2, 132, 199, 0.35) !important;
  box-shadow: 0 20px 40px rgba(2, 132, 199, 0.12) !important;
}

.gm-team-card-glow {
  position: absolute !important;
  top: -60px !important;
  right: -60px !important;
  width: 220px !important;
  height: 220px !important;
  background: radial-gradient(circle, rgba(56, 189, 248, 0.12) 0%, transparent 70%) !important;
  pointer-events: none !important;
  border-radius: 50% !important;
  transition: transform 0.4s ease !important;
}

.gm-team-card:hover .gm-team-card-glow {
  transform: scale(1.25) !important;
}

html.light-mode .gm-team-card-glow,
html[data-theme="light"] .gm-team-card-glow {
  background: radial-gradient(circle, rgba(2, 132, 199, 0.08) 0%, transparent 70%) !important;
}

.gm-team-card-topbar {
  display: flex !important;
  align-items: center !important;
  justify-content: space-between !important;
  width: 100% !important;
  margin-bottom: 24px !important;
}

.gm-team-badge-wrap {
