# ========================================================
# Ghost Telegram Bot Configuration
# ========================================================

# Get your bot token from @BotFather on Telegram
TELEGRAM_BOT_TOKEN=123456789:ABCdefGhIJKlmNoPQRsTUVwxyZ_1234567

# Your Telegram User ID (get from @userinfobot or @raw_data_bot)
# Multiple IDs can be separated by commas (e.g. 12345678,87654321)
ALLOWED_USER_IDS=123456789

# Path to your Ghost installation directory
GHOST_DIR=/var/www/ghost

# Path where backup .zip archives are stored (default: /var/www/ghost/backups)
BACKUPS_DIR=/var/www/ghost/backups
