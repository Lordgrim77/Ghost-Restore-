# ========================================================
# Ghost Telegram Bot Configuration
# ========================================================

# Get your bot token from @BotFather on Telegram
TELEGRAM_BOT_TOKEN=123456789:ABCdefGhIJKlmNoPQRsTUVwxyZ_1234567

# Super Admins (Full Control: Backups, Restore, GitHub Sync, Ghost Control, Admin Roster & Support Cases)
# Comma-separated Telegram User IDs (send /id to your bot to inspect your ID)
SUPER_ADMIN_IDS=123456789

# Normal Admins (Support Cases Only: View & manage support cases, evidence, status, and reporter chat)
# Multiple User IDs separated by commas (e.g. 987654321,112233445)
ALLOWED_USER_IDS=987654321

# Optional: Custom or Local Telegram Bot API Server (e.g. for uploads >20 MB up to 2000 MB)
# TELEGRAM_API_URL=http://127.0.0.1:8081

# Path to your Ghost installation directory
GHOST_DIR=/var/www/ghost

# Path where backup .zip archives are stored (default: /var/www/ghost/backups)
BACKUPS_DIR=/var/www/ghost/backups

# ========================================================
# Support & Incident Report Portal Hub Configuration
# ========================================================

# Multi-Admin Collaborative Incident Operations Group (Group 1)
# Group or supergroup Chat ID where confidential case alerts, team discussions,
# and two-way reporter replies occur. (Use negative ID format, e.g. -1001234567890; find via /id)
OPS_GROUP_CHAT_ID=-1001234567890

# Dedicated Evidence Storage Vault Group / Channel (Group 2)
# Dedicated private group or channel where uploaded evidence files are directly vaulted
# with ZERO VPS disk retention. (Use negative ID format, e.g. -1009876543210; find via /id)
STORAGE_CHAT_ID=-1009876543210

# Fallback Administrator Telegram Chat ID (used if OPS_GROUP_CHAT_ID is not set)
# Defaults to the first ID in ALLOWED_USER_IDS if omitted
ADMIN_CHAT_ID=123456789

# Support REST API Server binding (pure Python async daemon on Telegram bot event loop)
SUPPORT_HOST=127.0.0.1
SUPPORT_PORT=8080

# ========================================================
# Private GitHub Backup & Restore Configuration (Unzipped Archive)
# ========================================================

# Target private GitHub repository URL (HTTPS or owner/repo format)
# Example: https://github.com/Lordgrim77/Ghost-Backup-Private.git
GITHUB_BACKUP_REPO=https://github.com/your-username/your-private-ghost-backup.git

# GitHub Personal Access Token (PAT) with 'repo' scope
# Create at https://github.com/settings/tokens (select 'repo' scope)
GITHUB_TOKEN=ghp_your_github_personal_access_token_here

# Git branch to sync with (default: main)
GITHUB_BRANCH=main

