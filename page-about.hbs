{{!< default}}

{{#post}}

<link rel="stylesheet" href="{{asset "built/about-page.css"}}">

<div class="content-area">
<main class="site-main">
    <article class="{{post_class}}{{#unless feature_image}} no-image{{/unless}} single-post">

        {{#match @page.show_title_and_feature_image}}
            <header class="article-header gh-canvas">
                <h1 class="post-title">{{title}}</h1>
                {{> "post-image"}}
            </header>
        {{/match}}

        <div class="gh-content gh-canvas">
            {{content}}
        </div>

        {{!-- Link to Dedicated Team Page --}}
        <div class="gm-about-team-callout gh-canvas">
            <div class="gm-about-callout-inner">
                <div class="gm-about-callout-text">
                    <span class="gm-section-badge">{{t "Personnel"}}</span>
                    <h3 class="gm-about-callout-title">{{t "Meet the Team Behind Our Mission"}}</h3>
                    <p class="gm-about-callout-desc">{{t "Discover the investigators, forensic specialists, and intelligence analysts protecting digital frontiers."}}</p>
                </div>
                <a href="/team/" class="gm-about-callout-btn">
                    <span>{{t "View Team & Operatives"}}</span>
                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
                </a>
            </div>
        </div>

    </article>
</main>
</div>

{{/post}}

