<script src="{{asset "built/main.min.js"}}"></script>

<script id="gm-koenig-post-defense">
(function() {
    function initKoenigPostDefense() {
        // 1. Safe Koenig Gallery Handling: ensure ratio calculation never crashes
        document.querySelectorAll('.kg-gallery-image img').forEach(function(img) {
            const container = img.closest('.kg-gallery-image');
            if (!container) return;
            const w = parseFloat(img.getAttribute('width')) || img.naturalWidth || 4;
            const h = parseFloat(img.getAttribute('height')) || img.naturalHeight || 3;
            if (w && h && h > 0) {
                const ratio = w / h;
                container.style.flex = ratio + ' 1 0%';
            } else {
                container.style.flex = '1 1 0%';
            }
            if (!img.complete) {
                img.addEventListener('load', function() {
                    const nw = img.naturalWidth || 4;
                    const nh = img.naturalHeight || 3;
                    if (nw && nh && nh > 0) {
                        container.style.flex = (nw / nh) + ' 1 0%';
                    }
                }, { once: true });
            }
        });

        // 2. Safe Koenig Toggle Cards
        document.querySelectorAll('.kg-toggle-heading').forEach(function(heading) {
            if (heading.dataset.toggleInit) return;
            heading.dataset.toggleInit = 'true';
            heading.addEventListener('click', function() {
                const card = heading.closest('.kg-toggle-card');
                if (!card) return;
                const state = card.getAttribute('data-kg-toggle-state');
                card.setAttribute('data-kg-toggle-state', state === 'open' ? 'close' : 'open');
            });
        });

        // 3. Iframe & Embed Anti-Collapse Protection
        document.querySelectorAll('.gh-content iframe').forEach(function(iframe) {
            const reframeWrap = iframe.closest('.js-reframe');
            if (reframeWrap) {
                const pt = parseFloat(reframeWrap.style.paddingTop);
                if (isNaN(pt) || pt <= 5) {
                    reframeWrap.style.paddingTop = '56.25%';
                }
            }
        });
    }

    if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', initKoenigPostDefense);
    } else {
        initKoenigPostDefense();
    }
    window.addEventListener('load', initKoenigPostDefense);
})();
</script>

<script>
(function() {
    const html = document.documentElement;
    const btn = document.getElementById('gmThemeToggleBtn');
    const icon = document.getElementById('gmThemeIcon');
    const text = document.getElementById('gmThemeText');

    const saved = localStorage.getItem('user-theme');
    const defaultTheme = '{{#match @custom.color_scheme "Light"}}light{{else}}dark{{/match}}';
    const prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
    let theme = saved || (prefersDark ? 'dark' : defaultTheme);

    function apply(t) {
        if (t === 'dark') {
            html.classList.add('dark-mode');
            html.classList.remove('light-mode');
            html.setAttribute('data-theme', 'dark');
            document.querySelectorAll('#gmThemeIcon, .gm-theme-icon').forEach(el => el.textContent = '🌙');
            document.querySelectorAll('#gmThemeText, .gm-theme-text, .gm-menu-theme-badge').forEach(el => el.textContent = 'Dark');
        } else {
            html.classList.remove('dark-mode');
            html.classList.add('light-mode');
            html.setAttribute('data-theme', 'light');
            document.querySelectorAll('#gmThemeIcon, .gm-theme-icon').forEach(el => el.textContent = '☀️');
            document.querySelectorAll('#gmThemeText, .gm-theme-text, .gm-menu-theme-badge').forEach(el => el.textContent = 'Light');
        }
        localStorage.setItem('user-theme', t);
    }

    apply(theme);

    document.querySelectorAll('.gm-theme-toggle').forEach(function(toggleBtn) {
        toggleBtn.addEventListener('click', function(e) {
            if (e) e.preventDefault();
            theme = (html.getAttribute('data-theme') === 'dark') ? 'light' : 'dark';
            apply(theme);
        });
    });

    // Mobile Hamburger Dropdown Menu
    const menuBtn = document.getElementById('gmMobileMenuBtn');
    const head = document.getElementById('gh-head');
    if (menuBtn && head) {
        menuBtn.addEventListener('click', function(e) {
            e.preventDefault();
            e.stopPropagation();
            head.classList.toggle('is-menu-open');
        });
        document.addEventListener('click', function(e) {
            if (head.classList.contains('is-menu-open') && !head.contains(e.target)) {
                head.classList.remove('is-menu-open');
            }
        });
    }

    // Card & Newsletter Cursor Spotlight (Optimized with requestAnimationFrame)
    function initSpotlights() {
        const cards = document.querySelectorAll('.gm-post-card, .gm-newsletter-card');
        cards.forEach(function(card) {
            if (card.dataset.spotlightInit) return;
            card.dataset.spotlightInit = 'true';
            let raf = null;
            let mx = -500, my = -500;
            card.addEventListener('mousemove', function(e) {
                const rect = card.getBoundingClientRect();
                mx = e.clientX - rect.left;
                my = e.clientY - rect.top;
                if (!raf) {
                    raf = requestAnimationFrame(function() {
                        card.style.setProperty('--mouse-x', mx + 'px');
                        card.style.setProperty('--mouse-y', my + 'px');
                        raf = null;
                    });
                }
            }, { passive: true });
            card.addEventListener('mouseleave', function() {
                if (raf) { cancelAnimationFrame(raf); raf = null; }
                card.style.removeProperty('--mouse-x');
                card.style.removeProperty('--mouse-y');
            });
        });
    }
    initSpotlights();
    window.addEventListener('load', initSpotlights);

    // Dynamic Active Navigation Highlight (Handles Custom Routes like /posts/)
    function highlightActiveNav() {
        const path = (window.location.pathname || '').replace(/\/+$/, '') || '/';
        document.querySelectorAll('.gh-head-menu .nav li, .gh-foot-menu .nav li').forEach(function(li) {
            const a = li.querySelector('a');
            if (!a) return;
            const aPath = (a.pathname || '').replace(/\/+$/, '') || '/';
            if (aPath === path) {
                li.classList.add('nav-current');
            } else {
                li.classList.remove('nav-current');
            }
        });
    }
    highlightActiveNav();
    window.addEventListener('load', highlightActiveNav);

    // Dynamic search keyboard shortcut detection (⌘K on macOS, Ctrl K on Windows/Linux)
    try {
        const isMac = /(Mac|iPhone|iPod|iPad)/i.test(navigator.platform || navigator.userAgent);
        const kbd = document.getElementById('gmSearchKbd');
        if (kbd) kbd.textContent = isMac ? '⌘K' : 'Ctrl K';
    } catch(e) {}

    // Keep all menu links (Home, About, etc.) visible next to the logo; disable 3-dots collapse
    function unwrapNavigation() {
        const nav = document.querySelector('.gh-head-menu .nav');
        const dropdown = document.querySelector('.gh-dropdown');
        const toggle = document.querySelector('.nav-more-toggle');
        if (nav && dropdown) {
            while (dropdown.firstChild) {
                nav.insertBefore(dropdown.firstChild, toggle);
            }
            if (toggle) toggle.remove();
        }
    }
    window.addEventListener('load', unwrapNavigation);
    window.addEventListener('resize', () => setTimeout(unwrapNavigation, 20));
    setTimeout(unwrapNavigation, 100);
})();
</script>

