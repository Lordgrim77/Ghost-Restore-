            {{else}}
                <span class="gm-splash-fallback-title">{{@site.title}}</span>
            {{/if}}
        </div>
        <div class="gm-splash-meta">
            <span class="gm-splash-label">Loading {{@site.title}}</span>
            <span class="gm-splash-dots"><span class="dot-1">.</span><span class="dot-2">.</span><span class="dot-3">.</span></span>
        </div>
        <div class="gm-splash-progress-track">
            <div class="gm-splash-progress-bar"></div>
        </div>
    </div>
</div>

<!-- 1. Ambient Cryptographic Telemetry Canvas -->
<canvas id="gm-cyber-hex-canvas" data-liquid-ignore="true" aria-hidden="true"></canvas>

<div class="site">

    <header id="gh-head" class="gh-head gh-outer">
        <div class="gh-head-inner">
            <div class="gh-head-brand">
                <div class="gh-head-brand-wrapper">
                    <a class="gh-head-logo" href="{{@site.url}}">
                        {{#if @site.logo}}
                            <img src="{{@site.logo}}" alt="{{@site.title}}">
                            {{#if @custom.white_logo_for_dark_mode}}
                                <img src="{{img_url @custom.white_logo_for_dark_mode}}" alt="{{@site.title}}">
                            {{/if}}
                        {{else}}
                            {{@site.title}}
                        {{/if}}
                    </a>
                </div>
            </div>

            <nav class="gh-head-menu">
                {{navigation}}
                <div class="gm-menu-theme-item">
                    <button class="gm-theme-toggle gm-menu-theme-btn" id="gmThemeToggleBtn" aria-label="Toggle Theme">
                        <span class="gm-menu-theme-left">
                            <span id="gmThemeIcon" class="gm-theme-icon">☀️</span>
                            <span class="gm-menu-theme-label">Theme</span>
