<!DOCTYPE html>
<html lang="{{@site.locale}}"{{#match @custom.color_scheme "Light"}} class="light-mode" data-theme="light"{{else}} class="dark-mode" data-theme="dark"{{/match}}>

<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{{meta_title page=(t " (Page %)")}}</title>

    <!-- 1. Synchronous Inline Anti-FOUC Theme Detection (Runs BEFORE first paint) -->
    <script>
        (function() {
            try {
                var saved = localStorage.getItem('user-theme');
                var defaultTheme = '{{#match @custom.color_scheme "Light"}}light{{else}}dark{{/match}}';
                var prefersDark = window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches;
                var theme = saved || (prefersDark ? 'dark' : defaultTheme);
                var root = document.documentElement;
                if (theme === 'light') {
                    root.classList.remove('dark-mode');
                    root.classList.add('light-mode');
                    root.setAttribute('data-theme', 'light');
                } else {
                    root.classList.remove('light-mode');
                    root.classList.add('dark-mode');
                    root.setAttribute('data-theme', 'dark');
                }
            } catch(e) {}
        })();
    </script>

    <!-- 2. Critical Anti-FOUC & Anti-Flash Styles (Synchronous) -->
    <style id="gm-critical-anti-fouc">
        /* Hide Portal iframe until our custom theme is attached (Eliminates Popup Flash) */
        #ghost-portal-root iframe:not([data-styled="true"]) {
            opacity: 0 !important;
            visibility: hidden !important;
        }
        #ghost-portal-root iframe[data-styled="true"] {
            opacity: 1 !important;
            visibility: visible !important;
            transition: opacity 0.12s ease-out !important;
        }

        /* Enforce theme background & text color immediately on html/body */
        html.dark-mode, html[data-theme="dark"], html.dark-mode body, html[data-theme="dark"] body {
            background-color: #040609 !important;
            color: #f8fafc !important;
            --ghost-accent-color: #ffffff !important;
        }
        html.light-mode, html[data-theme="light"], html.light-mode body, html[data-theme="light"] body {
            background-color: #f8fafc !important;
            color: #090b10 !important;
            --ghost-accent-color: #000000 !important;
        }

        /* Immediately enforce obsidian/lunar palette for all buttons during load */
        html.dark-mode .gh-button,
        html.dark-mode .gh-btn,
        html.dark-mode .gh-head-btn,
        html.dark-mode .gm-theme-toggle,
        html.dark-mode .gm-head-signin-btn,
        html.dark-mode .gm-search-bar-btn,
        html.dark-mode .gm-mobile-menu-btn,
        html[data-theme="dark"] .gh-button,
        html[data-theme="dark"] .gh-btn,
        html[data-theme="dark"] .gh-head-btn,
        html[data-theme="dark"] .gm-theme-toggle,
        html[data-theme="dark"] .gm-head-signin-btn,
        html[data-theme="dark"] .gm-search-bar-btn,
        html[data-theme="dark"] .gm-mobile-menu-btn {
            background-color: rgba(255, 255, 255, 0.08) !important;
            border-color: rgba(255, 255, 255, 0.12) !important;
            color: #ffffff !important;
        }
        html.dark-mode .gh-primary-btn,
        html.dark-mode button.gm-newsletter-btn,
        html.dark-mode button[type="submit"]:not(.gm-search-bar-btn),
        html[data-theme="dark"] .gh-primary-btn,
        html[data-theme="dark"] button.gm-newsletter-btn,
        html[data-theme="dark"] button[type="submit"]:not(.gm-search-bar-btn) {
            background-color: #ffffff !important;
            color: #090b10 !important;
            border-color: #ffffff !important;
        }

        /* Light Mode Load Enforcements */
        html.light-mode .gh-button,
        html.light-mode .gh-btn,
        html.light-mode .gh-head-btn,
        html.light-mode .gm-theme-toggle,
        html.light-mode .gm-head-signin-btn,
        html.light-mode .gm-search-bar-btn,
        html.light-mode .gm-mobile-menu-btn,
        html[data-theme="light"] .gh-button,
        html[data-theme="light"] .gh-btn,
        html[data-theme="light"] .gh-head-btn,
        html[data-theme="light"] .gm-theme-toggle,
        html[data-theme="light"] .gm-head-signin-btn,
        html[data-theme="light"] .gm-search-bar-btn,
        html[data-theme="light"] .gm-mobile-menu-btn {
            background-color: rgba(0, 0, 0, 0.05) !important;
            border-color: rgba(0, 0, 0, 0.12) !important;
            color: #090b10 !important;
        }
    </style>

    <!-- 3. Synchronous Custom Stylesheets in <head> -->
    <link rel="stylesheet" href="{{asset "built/screen.css"}}">
    <link rel="stylesheet" href="{{asset "built/glassmorphism.css"}}?v=liquid-clean-v1">
    <link rel="stylesheet" href="{{asset "built/cyber-splash.css"}}?v=cyber-v2">

    <meta name="view-transition" content="same-origin">

    <!-- Anti-Splash Flash (Runs on initial visit and page refresh/reload, bypasses on internal link navigation) -->
    <script>
        (function() {
            try {
                var isReload = false;
                var navEntries = window.performance && performance.getEntriesByType && performance.getEntriesByType('navigation');
                if (navEntries && navEntries.length > 0 && navEntries[0].type === 'reload') {
                    isReload = true;
                } else if (window.performance && window.performance.navigation && window.performance.navigation.type === 1) {
                    isReload = true;
                }

                if (isReload) {
                    sessionStorage.removeItem('gm_cyber_splash_shown');
                } else if (sessionStorage.getItem('gm_cyber_splash_shown') === '1') {
                    document.write('<style>#gm-cyber-splash{display:none!important;opacity:0!important;visibility:hidden!important;}</style>');
                }
            } catch(e) {}
        })();
    </script>

    <!-- 4. Portal Theme Styler in <head> (Synchronously Intercepts Iframes Before First Paint) -->
    <script src="{{asset "built/portal-theme.js"}}?v=portal-contrast-v16"></script>
    <script src="{{asset "built/comments-theme.js"}}?v=comments-ux-v17"></script>
    <script src="{{asset "built/search-theme.js"}}?v=search-v1"></script>
    <script src="{{asset "built/member-avatars.js"}}?v=6"></script>

        {{#if @member}}
    <script>
        window.gmCurrentMember = {
            name: "{{@member.name}}",
            email: "{{@member.email}}"
        };
    </script>
    {{/if}}

    {{ghost_head}}
</head>

<body class="{{body_class}} is-head-{{#match @custom.navigation_layout "Logo on the left"}}left-logo{{else match @custom.navigation_layout "Logo in the middle"}}middle-logo{{else}}stacked{{/match}}{{#match @custom.title_font "=" "Elegant serif"}} has-serif-title{{/match}}{{#match @custom.body_font "=" "Elegant serif"}} has-serif-body{{/match}}">

<!-- Hairline Page Transition Progress Bar -->
<div id="gm-page-transition-bar" aria-hidden="true"></div>

<!-- 0. Clean Professional Site Preloader (Runs once per session) -->
<div id="gm-cyber-splash" aria-hidden="true" data-liquid-ignore="true">
    <div class="gm-splash-content">
        <div class="gm-splash-logo-wrap">
            {{#if @site.logo}}
                <img class="gm-splash-logo gm-splash-logo-light" src="{{@site.logo}}" alt="{{@site.title}}">
