            </nav>

            <div class="gh-head-actions">
                <button class="gh-search gm-search-bar-btn gm-search-btn" aria-label="{{t "Search this site"}}" data-ghost-search title="{{t "Search"}}">
                    <span class="gm-search-icon">{{> "icons/search"}}</span>
                    <span class="gm-search-label">{{t "Search"}}</span>
                    <kbd class="gm-search-kbd" id="gmSearchKbd">Ctrl K</kbd>
                </button>
                {{#unless @member}}
                    <a class="gm-head-signin-btn" href="#/portal/signin" data-portal="signin">Sign in</a>
                {{else}}
                    <a class="gm-head-signin-btn gm-head-account-btn" href="{{@site.url}}/account/">Account</a>
                {{/unless}}
                <button class="gm-mobile-menu-btn" id="gmMobileMenuBtn" aria-label="Toggle Navigation Menu">
                    <span class="gm-menu-icon-bars">☰</span>
                    <span class="gm-menu-icon-close">✕</span>
                </button>
            </div>
        </div>
    </header>

    {{#is "home"}}
        {{#if @custom.show_featured_posts}}
            {{> "featured"}}
        {{/if}}
    {{/is}}

    <div class="site-content">
        {{{body}}}
    </div>

    <footer class="gh-foot{{#unless @site.secondary_navigation}} no-menu{{/unless}} gh-outer">
        <div class="gh-foot-inner gh-inner">
            <div class="gh-copyright">
                {{@site.title}} &copy; {{date format="YYYY"}}
            </div>
            <div class="gm-foot-official-links">
                <a href="https://t.me/StopAbuseTeam" target="_blank" rel="noopener noreferrer" class="gm-foot-link gm-foot-tg-link" aria-label="Official Telegram Channel">
                    <svg class="gm-foot-tg-icon" viewBox="0 0 24 24" fill="currentColor" width="16" height="16">
